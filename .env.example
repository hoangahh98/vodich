DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Tài khoản admin gốc, được tạo tự động lần đầu chạy.
APP_ADMIN_USERNAME=admin
# BẮT BUỘC đổi ở production: app sẽ KHÔNG khởi động nếu để mật khẩu yếu
# ('123456789', 'admin', 'password', 'change-me'...). Cần deploy gấp thì đặt tạm
# ALLOW_WEAK_ADMIN_PASSWORD=true rồi đổi lại sau.
APP_ADMIN_PASSWORD=123456789

# BẮT BUỘC đổi ở production (chuỗi ngẫu nhiên >= 32 ký tự): app không khởi động nếu để 'change-me'.
SESSION_SECRET=change-me

# ─── Tuỳ chọn ───
# Cho phép Origin khác ngoài chính host của app gửi POST (hiếm khi cần; dùng khi
# đứng sau nhiều tên miền). Ngăn cách bằng dấu phẩy: https://a.example.com,https://b.example.com
# CSRF_ALLOWED_ORIGINS=

# Chỉ dùng khi cần deploy gấp mà chưa kịp đổi APP_ADMIN_PASSWORD.
# ALLOW_WEAK_ADMIN_PASSWORD=true

