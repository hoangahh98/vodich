generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(255)
  role         String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  permissions           AdminFeaturePermission[]
  ownedTournaments      Tournament[]             @relation("TournamentOwner")
  tournamentPermissions TournamentPermission[]
  ownedTeams            TeamClub[]               @relation("TeamClubOwner")
  teamPermissions       TeamClubPermission[]
  ownedTravelTrips      TravelTrip[]             @relation("TravelTripOwner")
  travelPermissions     TravelTripPermission[]
  medicalPermissions    MedPatientPermission[]
  ownedHouseholds       HouseholdConfig[]        @relation("HouseholdOwner")
  householdPermissions  HouseholdPermission[]
  knightCharacters      KnightCharacter[]        @relation("KnightCharacterOwner")

  @@map("app_user")
}

model AdminFeaturePermission {
  id      BigInt  @id @default(autoincrement())
  adminId BigInt  @map("admin_id")
  feature String  @db.VarChar(40)
  admin   AppUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, feature])
  @@map("admin_feature_permission")
}

model Player {
  id          BigInt   @id @default(autoincrement())
  displayName String   @map("display_name") @db.VarChar(255)
  email       String   @unique @db.VarChar(255)
  skillLevel  String?  @map("skill_level") @db.VarChar(10)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  registrations TournamentRegistration[]
  teamMembers   TeamMember[]
  travelPeople  TravelPerson[]
  travelMembers TravelTripMember[]

  @@map("player")
}

model Tournament {
  id                          BigInt    @id @default(autoincrement())
  name                        String    @db.VarChar(255)
  venue                       String?   @db.VarChar(255)
  startTime                   DateTime? @map("start_time")
  endTime                     DateTime? @map("end_time")
  courtCount                  Int       @default(1) @map("court_count")
  expectedPlayers             Int       @default(10) @map("expected_players")
  playType                    String    @default("SINGLES") @map("play_type") @db.VarChar(20)
  format                      String    @default("ROUND_ROBIN") @db.VarChar(20)
  knockoutQualifierCount      Int       @default(4) @map("knockout_qualifier_count")
  touchScore                  Int       @default(11) @map("touch_score")
  maxScore                    Int       @default(15) @map("max_score")
  knockoutTouchScore          Int       @default(15) @map("knockout_touch_score")
  knockoutMaxScore            Int       @default(19) @map("knockout_max_score")
  courtCost                   Decimal   @default(0) @map("court_cost") @db.Decimal(14, 2)
  foodCost                    Decimal   @default(0) @map("food_cost") @db.Decimal(14, 2)
  prizeCost                   Decimal   @default(0) @map("prize_cost") @db.Decimal(14, 2)
  otherCost                   Decimal   @default(0) @map("other_cost") @db.Decimal(14, 2)
  prizeRate1                  Decimal   @default(50) @map("prize_rate_1") @db.Decimal(14, 2)
  prizeRate2                  Decimal   @default(30) @map("prize_rate_2") @db.Decimal(14, 2)
  prizeRate3                  Decimal   @default(20) @map("prize_rate_3") @db.Decimal(14, 2)
  externalRegistrationEnabled Boolean   @default(false) @map("external_registration_enabled")
  ownerAdminId                BigInt?   @map("owner_admin_id")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @default(now()) @map("updated_at")

  ownerAdmin    AppUser?                 @relation("TournamentOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  registrations TournamentRegistration[]
  matches       MatchGame[]
  permissions   TournamentPermission[]

  @@map("tournament")
}

model TournamentPermission {
  id           BigInt   @id @default(autoincrement())
  tournamentId BigInt   @map("tournament_id")
  adminId      BigInt   @map("admin_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  admin      AppUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, adminId])
  @@map("tournament_permission")
}

model TournamentRegistration {
  id            BigInt    @id @default(autoincrement())
  tournamentId  BigInt    @map("tournament_id")
  playerId      BigInt?   @map("player_id")
  externalName  String?   @map("external_name") @db.VarChar(255)
  externalEmail String?   @map("external_email") @db.VarChar(255)
  skillLevel    String?   @map("skill_level") @db.VarChar(10)
  source        String    @default("INTERNAL") @db.VarChar(20)
  status        String    @default("ACTIVE") @db.VarChar(20)
  paidAmount    Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentStatus String    @default("UNPAID") @map("payment_status") @db.VarChar(40)
  withdrawnAt   DateTime? @map("withdrawn_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, playerId])
  @@unique([tournamentId, externalEmail])
  @@map("tournament_registration")
}

model MatchGame {
  id           BigInt   @id @default(autoincrement())
  tournamentId BigInt   @map("tournament_id")
  teamA        String   @map("team_a") @db.VarChar(255)
  teamB        String   @map("team_b") @db.VarChar(255)
  scoreA       Int      @default(0) @map("score_a")
  scoreB       Int      @default(0) @map("score_b")
  status       String   @default("SCHEDULED") @db.VarChar(30)
  courtNumber  Int      @default(1) @map("court_number")
  roundNumber  Int      @default(1) @map("round_number")
  stage        String   @default("Vòng tròn") @db.VarChar(40)
  groupName    String?  @map("group_name") @db.VarChar(20)
  servingTeam  String   @default("A") @map("serving_team") @db.VarChar(1)
  scoreOrder   Int      @default(2) @map("score_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("match_game")
}

model TeamClub {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  description  String?
  ownerAdminId BigInt?  @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  ownerAdmin  AppUser?             @relation("TeamClubOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  funds       TeamMonthFund[]
  expenses    TeamExpense[]
  permissions TeamClubPermission[]

  @@map("team_club")
}

model TeamClubPermission {
  id        BigInt   @id @default(autoincrement())
  teamId    BigInt   @map("team_id")
  adminId   BigInt   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  team  TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)
  admin AppUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([teamId, adminId])
  @@map("team_club_permission")
}

model TeamMember {
  id         BigInt   @id @default(autoincrement())
  teamId     BigInt   @map("team_id")
  playerId   BigInt   @map("player_id")
  memberType String   @default("FIXED") @map("member_type") @db.VarChar(20)
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  team     TeamClub            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  payments TeamMemberPayment[]

  @@unique([teamId, playerId])
  @@map("team_member")
}

model TeamMonthFund {
  id              BigInt   @id @default(autoincrement())
  teamId          BigInt   @map("team_id")
  fundMonth       DateTime @map("fund_month") @db.Date
  monthlyFee      Decimal  @default(0) @map("monthly_fee") @db.Decimal(14, 2)
  courtCost       Decimal  @default(0) @map("court_cost") @db.Decimal(14, 2)
  otherCost       Decimal  @default(0) @map("other_cost") @db.Decimal(14, 2)
  previousBalance Decimal  @default(0) @map("previous_balance") @db.Decimal(14, 2)
  notes           String?

  team TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, fundMonth])
  @@map("team_month_fund")
}

model TeamMemberPayment {
  id            BigInt   @id @default(autoincrement())
  memberId      BigInt   @map("member_id")
  fundMonth     DateTime @map("fund_month") @db.Date
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentStatus String   @default("UNPAID") @map("payment_status") @db.VarChar(40)
  notes         String?

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, fundMonth])
  @@map("team_member_payment")
}

model TeamExpense {
  id           BigInt    @id @default(autoincrement())
  teamId       BigInt    @map("team_id")
  expenseMonth DateTime  @map("expense_month") @db.Date
  expenseDate  DateTime? @map("expense_date") @db.Date
  content      String    @db.VarChar(255)
  amount       Decimal   @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  team TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_expense")
}

// ===== Game "Hiệp Sĩ Toán Học" (RPG học toán 4-7 tuổi) =====
// Hồ sơ nhân vật của người chơi: lưu tiến trình liên tục (Save/Load).
model KnightCharacter {
  id           BigInt   @id @default(autoincrement())
  ownerUserId  BigInt   @map("owner_user_id")
  name         String   @db.VarChar(60)
  gender       String   @default("boy") @db.VarChar(10) // 'boy' | 'girl'
  age          Int // 4..7
  notes        String   @default("") // Ghi chú cá nhân: điểm mạnh/yếu, sở thích
  currentStage Int      @default(1) @map("current_stage") // màn chơi hiện tại
  mobIndex     Int      @default(0) @map("mob_index") // đã đánh tới con quái thứ mấy của ải (chơi tiếp đúng chỗ)
  hp           Int      @default(10) // máu còn lại của lượt chơi hiện tại
  status       String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | RESTING | VICTORY
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  owner    AppUser          @relation("KnightCharacterOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  progress KnightProgress[]

  @@map("knight_character")
}

// Tiến trình từng ải đã vượt qua (lịch sử + số sao). Tra cứu bằng khoá chính xác
// [characterId, stageNumber] — không dùng lọc theo khoảng.
model KnightProgress {
  id          BigInt   @id @default(autoincrement())
  characterId BigInt   @map("character_id")
  stageNumber Int      @map("stage_number")
  status      String   @default("CLEARED") @db.VarChar(20) // CLEARED
  stars       Int      @default(0) // 0..3
  attempts    Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  character KnightCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, stageNumber])
  @@map("knight_progress")
}

model AppLog {
  id           BigInt   @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  level        String   @db.VarChar(20)
  category     String   @db.VarChar(80)
  action       String   @db.VarChar(255)
  method       String?  @db.VarChar(12)
  path         String?  @db.VarChar(500)
  queryString  String?  @map("query_string")
  statusCode   Int?     @map("status_code")
  durationMs   BigInt?  @map("duration_ms")
  userId       BigInt?  @map("user_id")
  username     String?  @db.VarChar(255)
  userRole     String?  @map("user_role") @db.VarChar(30)
  ipAddress    String?  @map("ip_address") @db.VarChar(120)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  details      String?
  errorMessage String?  @map("error_message")

  @@map("app_log")
}

model MedPatient {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  birthYear    Int?     @map("birth_year")
  gender       String?  @db.VarChar(20)
  allergies    String?
  conditions   String?
  notes        String?
  ownerAdminId BigInt?  @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  // Giờ nhắc uống thuốc theo nếp sinh hoạt từng nhà, đặt ở người thân để dùng chung
  // cho mọi đơn thuốc chứ không phải khai lại mỗi lần có đơn mới.
  doseTimeMorning String @default("07:00") @map("dose_time_morning") @db.VarChar(5)
  doseTimeNoon    String @default("12:00") @map("dose_time_noon") @db.VarChar(5)
  doseTimeEvening String @default("19:00") @map("dose_time_evening") @db.VarChar(5)
  doseTimeBedtime String @default("20:30") @map("dose_time_bedtime") @db.VarChar(5)

  prescriptions MedPrescription[]
  permissions   MedPatientPermission[]

  @@map("med_patient")
}

/**
 * Hồ sơ y tế chỉ admin tạo ra mới xem được; muốn cho admin khác xem thì cấp quyền
 * ở đây. Cùng mẫu với TravelTripPermission/TeamClubPermission.
 */
model MedPatientPermission {
  id        BigInt   @id @default(autoincrement())
  patientId BigInt   @map("patient_id")
  adminId   BigInt   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  patient MedPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admin   AppUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([patientId, adminId])
  @@map("med_patient_permission")
}

model MedPrescription {
  id             BigInt    @id @default(autoincrement())
  patientId      BigInt    @map("patient_id")
  prescribedDate DateTime? @map("prescribed_date") @db.Date
  doctor         String    @default("") @db.VarChar(255)
  clinic         String    @default("") @db.VarChar(255)
  diagnosis      String    @default("")
  /**
   * Ngày tái khám ghi trong đơn — sinh thêm một lời nhắc buổi sáng hôm đó.
   */
  followUpDate   DateTime? @map("follow_up_date") @db.Date
  imageData      String?   @map("image_data")
  imageMime      String?   @map("image_mime") @db.VarChar(80)
  aiSummary      String?   @map("ai_summary")
  aiRisk         String?   @map("ai_risk") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at")

  // Lịch đã chốt. Lưu lại để máy khác (hoặc chính máy này lấy lại sau vài ngày)
  // sinh ra đúng phần liệu trình CÒN LẠI, không nạp lại những cữ đã uống xong.
  scheduleStart   DateTime? @map("schedule_start") @db.Date
  scheduleSlot    String    @default("") @map("schedule_slot") @db.VarChar(10)
  // Đơn đã bị dừng khi có đơn mới thay thế. Vẫn giữ scheduleStart để hiển thị lịch sử.
  scheduleStopped Boolean   @default(false) @map("schedule_stopped")
  /**
   * KHÔNG CÒN DÙNG. Trước đây đếm số cữ của lần xuất .ics gần nhất để lần sau biết phần
   * dôi ra mà gửi lệnh huỷ — nhưng đã kiểm chứng là iPhone bỏ qua mọi lệnh huỷ, nên phần
   * đó đã gỡ (xem chú thích đầu src/medical/ics.ts). Giữ lại cột vì xoá cột phải chạy
   * migration trên DB thật mà chẳng được lợi gì; không code nào đọc hay ghi nó nữa.
   */
  icsDoseCount    Int       @default(0) @map("ics_dose_count")

  patient MedPatient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items   MedPrescriptionItem[]

  @@map("med_prescription")
}

model MedPrescriptionItem {
  id             BigInt  @id @default(autoincrement())
  prescriptionId BigInt  @map("prescription_id")
  drugName       String  @map("drug_name") @db.VarChar(255)
  isAntibiotic   Boolean @default(false) @map("is_antibiotic")
  dosage         String  @default("")
  frequency      String  @default("")
  duration       String  @default("")
  note           String  @default("")

  // Các trường dưới phục vụ lên lịch nhắc uống thuốc.
  // enabled=false là thuốc người dùng quyết định bỏ (bác sĩ gạch, hoặc đã có sẵn ở nhà).
  enabled          Boolean @default(true)
  // timesPerDay/days do AI đọc ra nhưng người dùng sửa lại được ở màn hình đơn thuốc.
  // 0 = chưa xác định -> không đưa vào lịch, bắt người dùng điền.
  timesPerDay      Int     @default(0) @map("times_per_day")
  // Số ngày là số thực, KHÔNG phải số nguyên: đơn hay cấp theo số lượng chứ không theo
  // ngày (vd Budesonid 5 ống, khí dung ngày 2 lần = 2,5 ngày). Ép về số nguyên là sai liều.
  days             Float   @default(0)
  quantity         String  @default("") @db.VarChar(80)
  // Số lượng dạng số đọc từ đơn (5 ống -> 5). Dùng để suy ra số ngày khi đơn không ghi.
  quantityCount    Int     @default(0) @map("quantity_count")
  // days được suy ra TỪ số lượng (không phải đơn ghi). Khi đó số ngày và số lượng khớp
  // nhau theo định nghĩa nên không được cảnh báo lệch.
  daysFromQuantity Boolean @default(false) @map("days_from_quantity")
  // Thuốc dùng KHI CẦN (hạ sốt khi sốt, khí dung khi khó thở): không lên lịch nhắc,
  // nhắc đều đặn thuốc loại này là sai — nhưng vẫn đếm vào tủ thuốc.
  asNeeded         Boolean @default(false) @map("as_needed")

  /**
   * Đơn GỐC của thuốc này, nếu nó được chuyển sang từ đơn cũ (applyTransition).
   * NULL = thuốc mới kê trong chính đơn đang chứa nó.
   * Cần lưu vì lúc chuyển, thuốc được CHÉP hẳn sang đơn mới nên mất dấu nguồn. Không có
   * cột này thì trên màn hình lịch không phân biệt được "thuốc mới bác sĩ kê hôm nay" với
   * "thuốc từ đợt trước uống tiếp" — mà đó đúng là thứ cần nhìn ra ngay để soát cho đúng.
   * Trước đây chỉ nhét chữ vào `duration` ("còn N ngày (chuyển từ đơn cũ)"), không tra
   * ngược ra được đơn nào.
   * KHÔNG đặt quan hệ khoá ngoại: xoá đơn cũ thì thuốc đã chuyển vẫn phải sống tiếp ở đơn
   * mới. Chỉ là con trỏ mềm, tra không thấy thì hiện "đơn cũ" chung chung.
   */
  carriedFromId BigInt? @map("carried_from_id")

  /**
   * Số lượng NGƯỜI DÙNG THẬT SỰ MUA cho thuốc này. NULL = chưa quyết định.
   * Không suy ra được: đơn cần 10, nhà còn 7 thì có người mua 3 cho vừa đủ, có người mua
   * đủ 10 để nhà còn dư phòng khi tái phát. Hai lựa chọn ra hai số tồn kho khác hẳn nhau
   * nên bắt buộc phải hỏi.
   * Dùng để chỉnh tủ thuốc theo công thức: tủ = tủ_cũ + đã_mua − đơn_cần (kẹp ≥ 0).
   * Lưu lại chứ không chỉ tính rồi bỏ, vì còn phải biết lần sửa sau chênh bao nhiêu mà
   * cộng trừ cho đúng — không thì sửa số hai lần là tủ sai gấp đôi.
   */
  purchasedCount Int? @map("purchased_count")

  /**
   * Số thuốc nhà ĐANG CÓ tại đúng lúc khai quyết định mua. NULL = chưa khai.
   * Phải chụp lại vì ngay sau khi khai, tủ bị trừ phần đơn này dùng nên con số đó không
   * còn dựng lại được. Không có nó thì cảnh báo thiếu tính sai: nhà còn 4, đơn cần 7, mua
   * 0 -> phải báo thiếu 3, nhưng đọc tủ (đã về 0) sẽ ra thiếu 7.
   * Thiếu = đơn_cần − đã_mua − tồn_lúc_khai. Ba số đều cố định nên cảnh báo đúng mãi mãi,
   * không phụ thuộc tủ về sau bị sửa gì.
   */
  stockAtPurchase Int? @map("stock_at_purchase")

  /**
   * Cảnh báo an toàn của AI cho RIÊNG thuốc này: trùng hoạt chất, cùng nhóm kháng sinh,
   * tương tác với thuốc đang uống dở hoặc với thuốc còn trong tủ.
   * Cố ý lưu theo TỪNG DÒNG THUỐC chứ không gộp vào aiSummary của cả đơn: cảnh báo gộp ở
   * đầu trang thì lúc soát tới thuốc thứ 5 phải nhớ lại xem băng-rôn nói về thuốc nào,
   * cuộn lên cuộn xuống đối chiếu — đúng thứ dễ bỏ sót nhất lại nằm ở chỗ khó kiểm soát
   * nhất. Cùng lý do với tồn kho tủ thuốc (xem stockAtPurchase, .med-row-stock).
   * aiWarnLevel: rỗng = không có gì đáng nói (màn hình im lặng), CHECK = nên để ý,
   * WARN = phải hỏi lại bác sĩ/dược sĩ trước khi cho uống.
   */
  aiWarnLevel String @default("") @map("ai_warn_level") @db.VarChar(10)
  aiWarnNote  String @default("") @map("ai_warn_note")
  // UONG | NHO_MUI | KHI_DUNG | XIT | BOI | KHAC
  route       String @default("") @db.VarChar(20)
  // SAU_AN | TRUOC_AN | TRUOC_NGU | rỗng
  timing      String @default("") @db.VarChar(20)

  prescription MedPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("med_prescription_item")
}

/**
 * Tủ thuốc của gia đình (theo admin, dùng chung cho mọi người thân).
 * Chỉ theo dõi dạng ĐẾM ĐƯỢC (gói/viên/ống). Chai/lọ/siro bỏ qua vì đã mở nắp thì
 * hạn dùng phụ thuộc cách bảo quản, đếm tồn không có ý nghĩa.
 */
model MedCabinetItem {
  id           BigInt    @id @default(autoincrement())
  ownerAdminId BigInt    @map("owner_admin_id")
  drugName     String    @map("drug_name") @db.VarChar(255)
  /**
   * Tên đã chuẩn hoá (bỏ dấu, bỏ hàm lượng, bỏ tên biệt dược trong ngoặc) để đối chiếu đơn mới.
   */
  matchKey     String    @map("match_key") @db.VarChar(255)
  unit         String    @default("") @db.VarChar(20)
  quantity     Int       @default(0)
  /**
   * Ngày mua = ngày kê đơn, dùng để AI ước lượng hạn khi người dùng không điền.
   */
  purchasedAt  DateTime? @map("purchased_at") @db.Date
  expiryDate   DateTime? @map("expiry_date") @db.Date
  /**
   * Kết quả AI ước lượng hạn (chỉ dùng khi expiryDate trống).
   */
  aiExpiryNote String?   @map("ai_expiry_note")
  aiExpiryRisk String?   @map("ai_expiry_risk") @db.VarChar(20)
  note         String    @default("")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([ownerAdminId, matchKey])
  @@map("med_cabinet_item")
}

model TravelDestination {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  trips       TravelTrip[]
  suggestions TravelSuggestion[]

  @@map("travel_destination")
}

model TravelSuggestion {
  id            BigInt   @id @default(autoincrement())
  destinationId BigInt   @map("destination_id")
  category      String   @db.VarChar(80)
  name          String   @db.VarChar(255)
  address       String   @default("")
  phone         String   @default("") @db.VarChar(80)
  openingHours  String   @default("") @map("opening_hours")
  description   String   @default("")
  mapUrl        String   @default("") @map("map_url")
  sourceUrl     String   @default("") @map("source_url")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  destination TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, category, name])
  @@map("travel_suggestion")
}

model TravelPerson {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @default("") @db.VarChar(255)
  playerId     BigInt?  @map("player_id")
  ownerAdminId BigInt?  @map("owner_admin_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  player  Player?            @relation(fields: [playerId], references: [id], onDelete: SetNull)
  members TravelTripMember[]

  @@map("travel_person")
}

model TravelTrip {
  id                BigInt    @id @default(autoincrement())
  name              String    @db.VarChar(255)
  description       String    @default("")
  ownerAdminId      BigInt?   @map("owner_admin_id")
  destinationId     BigInt?   @map("destination_id")
  treasurerMemberId BigInt?   @unique @map("treasurer_member_id")
  active            Boolean   @default(true)
  aiPlan            String?   @map("ai_plan")
  aiPlanAt          DateTime? @map("ai_plan_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  ownerAdmin      AppUser?               @relation("TravelTripOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  destination     TravelDestination?     @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  treasurerMember TravelTripMember?      @relation("TravelTripTreasurer", fields: [treasurerMemberId], references: [id], onDelete: SetNull)
  members         TravelTripMember[]     @relation("TravelTripMembers")
  collections     TravelTripCollection[]
  expenses        TravelTripExpense[]
  permissions     TravelTripPermission[]

  @@map("travel_trip")
}

model TravelTripPermission {
  id        BigInt   @id @default(autoincrement())
  tripId    BigInt   @map("trip_id")
  adminId   BigInt   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  trip  TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  admin AppUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([tripId, adminId])
  @@map("travel_trip_permission")
}

model TravelTripMember {
  id        BigInt   @id @default(autoincrement())
  tripId    BigInt   @map("trip_id")
  personId  BigInt?  @map("person_id")
  playerId  BigInt?  @map("player_id")
  name      String   @db.VarChar(255)
  email     String   @default("") @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  trip            TravelTrip               @relation("TravelTripMembers", fields: [tripId], references: [id], onDelete: Cascade)
  person          TravelPerson?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  player          Player?                  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  collections     TravelTripCollection[]
  paidExpenses    TravelTripExpense[]      @relation("TravelExpensePayer")
  privateExpenses TravelTripExpense[]      @relation("TravelExpensePrivateMember")
  splits          TravelTripExpenseSplit[]
  treasurerFor    TravelTrip?              @relation("TravelTripTreasurer")

  @@map("travel_trip_member")
}

model TravelTripCollection {
  id        BigInt   @id @default(autoincrement())
  tripId    BigInt   @map("trip_id")
  memberId  BigInt   @map("member_id")
  amount    Decimal  @default(0) @db.Decimal(14, 2)
  note      String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  trip   TravelTrip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member TravelTripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripId, memberId])
  @@map("travel_trip_collection")
}

model TravelTripExpense {
  id              BigInt   @id @default(autoincrement())
  tripId          BigInt   @map("trip_id")
  spentDate       DateTime @default(now()) @map("spent_date") @db.Date
  title           String   @db.VarChar(255)
  amount          Decimal  @default(0) @db.Decimal(14, 2)
  note            String   @default("")
  splitMode       String   @default("SHARED") @map("split_mode") @db.VarChar(20)
  privateMemberId BigInt?  @map("private_member_id")
  paidByMemberId  BigInt?  @map("paid_by_member_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  trip          TravelTrip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  privateMember TravelTripMember?        @relation("TravelExpensePrivateMember", fields: [privateMemberId], references: [id], onDelete: SetNull)
  paidByMember  TravelTripMember?        @relation("TravelExpensePayer", fields: [paidByMemberId], references: [id], onDelete: SetNull)
  splits        TravelTripExpenseSplit[]

  @@map("travel_trip_expense")
}

model TravelTripExpenseSplit {
  id        BigInt  @id @default(autoincrement())
  expenseId BigInt  @map("expense_id")
  memberId  BigInt  @map("member_id")
  amount    Decimal @default(0) @db.Decimal(14, 2)

  expense TravelTripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  TravelTripMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
  @@map("travel_trip_expense_split")
}

// ─── Module Quản Lý Chi Tiêu (household) ───
// Sổ chi tiêu gia đình NHẬP TAY. Rule chỉ có ba ý:
//   1. Khai THU NHẬP và CHI PHÍ, mỗi khoản thuộc một LOẠI do chủ sổ tự định nghĩa.
//   2. Loại nào đánh dấu là TIẾT KIỆM thì tiền vào đó DỒN QUA CÁC THÁNG (không reset).
//   3. Loại nào đánh dấu là TRẢ NỢ / THU NỢ thì khoản đó gắn với một dòng trong SỔ NỢ,
//      phần GỐC tự trừ vào khoản nợ được chọn (lãi thì không).
// Xem docs/quan-ly-chi-tieu.md.

/// Một SỔ chi tiêu, đồng thời là cấu hình của sổ đó. Đây là gốc phân quyền của module,
/// đóng đúng vai trò Tournament / TeamClub ở các module khác: mỗi admin có sổ riêng và
/// có thể cấp quyền cho admin khác cùng xem/sửa. Mọi bảng con đều trỏ về đây qua
/// `household_id`, nên không admin nào đọc được sổ của admin khác.
model HouseholdConfig {
  id           Int      @id @default(autoincrement())
  ownerAdminId BigInt?  @map("owner_admin_id")
  name         String   @default("Sổ chi tiêu gia đình") @db.VarChar(120)
  /// Mốc bắt đầu ghi sổ: các con số luỹ kế (tiết kiệm, còn lại) tính từ tháng này trở đi.
  anchorDate   DateTime @default(now()) @map("anchor_date") @db.Date
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  ownerAdmin        AppUser?                   @relation("HouseholdOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  permissions       HouseholdPermission[]
  incomeCategories  HouseholdIncomeCategory[]
  expenseCategories HouseholdExpenseCategory[]
  incomes           HouseholdIncome[]
  expenses          HouseholdExpense[]
  debts             HouseholdDebt[]
  chatMessages      HouseholdChatMessage[]

  @@index([ownerAdminId])
  @@map("household_config")
}

/// Admin được chủ sổ cấp quyền xem/sửa sổ chi tiêu. Chỉ chủ sổ được cấp và gỡ quyền.
model HouseholdPermission {
  id          BigInt   @id @default(autoincrement())
  householdId Int      @map("household_id")
  adminId     BigInt   @map("admin_id")
  createdAt   DateTime @default(now()) @map("created_at")

  household HouseholdConfig @relation(fields: [householdId], references: [id], onDelete: Cascade)
  admin     AppUser         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([householdId, adminId])
  @@map("household_permission")
}

// ─── Loại thu nhập / loại chi phí ───

/// Một loại thu nhập do chủ sổ tự khai (Lương vợ, Lương chồng, OT, Cho thuê nhà...).
/// `kind` quyết định khoản thu được xếp vào đâu:
/// - `normal` — tiền vào thật, cộng vào ô Thu nhập.
/// - `saving` — RÚT tiết kiệm ra tiêu: trừ vào số dư tiết kiệm, không tính là thu nhập.
/// - `debt`   — người khác TRẢ NỢ cho mình: phần gốc trừ vào khoản cho vay trong sổ nợ.
model HouseholdIncomeCategory {
  id          BigInt   @id @default(autoincrement())
  householdId Int      @map("household_id")
  name        String   @db.VarChar(80)
  kind        String   @default("normal") @db.VarChar(8) // normal | saving | debt
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  household HouseholdConfig   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  incomes   HouseholdIncome[]

  @@index([householdId])
  @@map("household_income_category")
}

/// Một loại chi phí do chủ sổ tự khai (Ăn uống, Xăng xe, Tiết kiệm con, Trả nợ ngân hàng...).
/// - `fixed`    — chi phí CỐ ĐỊNH: tháng nào cũng phải trả (học phí, gửi xe, tiền nhà). Chỉ
///                loại này mới được nút "chép tháng trước" nhân bản sang tháng sau.
/// - `variable` — chi phí PHÁT SINH: không lặp lại (ăn ngoài, cưới hỏi, sửa xe).
/// - `saving`   — GỬI tiết kiệm: cộng vào số dư tiết kiệm dồn qua các tháng, KHÔNG tính là chi phí.
/// - `debt`     — trả nợ: phần gốc trừ vào khoản nợ trong sổ nợ, cả gốc lẫn lãi đều là tiền ra.
model HouseholdExpenseCategory {
  id          BigInt   @id @default(autoincrement())
  householdId Int      @map("household_id")
  name        String   @db.VarChar(80)
  kind        String   @default("variable") @db.VarChar(12) // fixed | variable | saving | debt
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  household HouseholdConfig    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  HouseholdExpense[]

  @@index([householdId])
  @@map("household_expense_category")
}

// ─── Khoản thu / khoản chi ───

/// Một khoản THU đã khai. `month` luôn suy ra từ `occurred_at` nên không lệch nhau được.
/// `principal` / `interest` / `debt_id` CHỈ có nghĩa khi loại thu là `debt`
/// (người ta trả nợ mình): khi đó `amount` = `principal` + `interest`.
model HouseholdIncome {
  id          BigInt   @id @default(autoincrement())
  householdId Int      @map("household_id")
  categoryId  BigInt?  @map("category_id")
  month       String   @db.VarChar(7) // YYYY-MM
  occurredAt  DateTime @map("occurred_at") @db.Date
  amount      BigInt   @default(0)
  principal   BigInt   @default(0)
  interest    BigInt   @default(0)
  debtId      BigInt?  @map("debt_id")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  household HouseholdConfig          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  HouseholdIncomeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debt      HouseholdDebt?           @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([householdId, month])
  @@index([categoryId])
  @@index([debtId])
  @@map("household_income")
}

/// Một khoản CHI đã khai. Cùng hình dạng với khoản thu; `principal` / `interest` / `debt_id`
/// chỉ có nghĩa khi loại chi là `debt` (mình trả nợ).
///
/// `amount` LUÔN là tiền ĐÃ CHI THẬT — mọi con số của module đều tính từ nó.
/// `planned_amount` là mức DỰ KIẾN của khoản cố định (chỉ có nghĩa với loại `fixed`), giữ lại
/// để màn hình đối chiếu "dự kiến 2tr · đã chi 1tr5". Phần dư giữa hai số KHÔNG nằm ở đây:
/// nó được ghi hẳn thành một khoản chi loại tiết kiệm riêng, xem HouseholdService.addEntry.
model HouseholdExpense {
  id            BigInt   @id @default(autoincrement())
  householdId   Int      @map("household_id")
  categoryId    BigInt?  @map("category_id")
  month         String   @db.VarChar(7)
  occurredAt    DateTime @map("occurred_at") @db.Date
  amount        BigInt   @default(0)
  plannedAmount BigInt   @default(0) @map("planned_amount")
  principal     BigInt   @default(0)
  interest      BigInt   @default(0)
  debtId        BigInt?  @map("debt_id")
  note          String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  household HouseholdConfig           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  HouseholdExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debt      HouseholdDebt?            @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([householdId, month])
  @@index([categoryId])
  @@index([debtId])
  @@map("household_expense")
}

// ─── Sổ nợ ───

/// Một dòng trong sổ nợ, hai chiều:
/// - `owe`  — MÌNH đi vay (nợ ngân hàng, vay bạn).
/// - `lend` — mình CHO VAY, người khác nợ mình.
/// Còn lại = `initial_amount` − tổng tiền GỐC đã trả (chiều `owe`: gốc ở khoản chi;
/// chiều `lend`: gốc ở khoản thu). Lãi không làm giảm nợ.
model HouseholdDebt {
  id            BigInt    @id @default(autoincrement())
  householdId   Int       @map("household_id")
  direction     String    @default("owe") @db.VarChar(4) // owe | lend
  name          String    @db.VarChar(80)
  /// Chủ nợ (chiều `owe`) hoặc người vay tiền mình (chiều `lend`).
  counterparty  String    @default("") @db.VarChar(80)
  initialAmount BigInt    @default(0) @map("initial_amount")
  startDate     DateTime  @map("start_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  /// KHÔNG CÒN DÙNG. Mô hình cũ có nút "Tạm dừng" nhưng ở mô hình mới không có gì tự chạy
  /// theo tháng nên nó chẳng tác động tới con số nào — đã gỡ khỏi giao diện. Cột giữ lại
  /// (có DEFAULT nên ghi mới vẫn chạy) để tránh một migration phá vỡ tương thích: xoá cột
  /// thì trong lúc deploy container CŨ vẫn SELECT nó và cả module 500 — đã dính đúng lỗi
  /// này ngày 31/7/2026. Dọn ở một lần deploy riêng khi tiện.
  active        Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  note          String    @default("")
  createdAt     DateTime  @default(now()) @map("created_at")

  household HouseholdConfig    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  incomes   HouseholdIncome[]
  expenses  HouseholdExpense[]

  @@index([householdId])
  @@map("household_debt")
}

// ─── Trợ lý AI ───

/// Lịch sử hỏi đáp với trợ lý chi tiêu. Lưu lại để hỏi nối tiếp ("thế còn tháng trước?")
/// và để mở lại máy vẫn thấy hội thoại cũ. Service tự cắt bớt tin nhắn quá cũ.
model HouseholdChatMessage {
  id          BigInt   @id @default(autoincrement())
  householdId Int      @map("household_id")
  role        String   @db.VarChar(9) // user | assistant
  content     String
  /// Tên hiển thị của admin đã hỏi — sổ dùng chung nên cần biết ai nói câu nào.
  askedBy     String   @default("") @map("asked_by") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")

  household HouseholdConfig @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, id])
  @@map("household_chat_message")
}
