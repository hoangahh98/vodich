generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(255)
  role         String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  permissions           AdminFeaturePermission[]
  ownedGroups             PlayerGroup[]            @relation("PlayerGroupOwner")
  grantedTournamentAccess PlayerTournamentAccess[] @relation("PlayerTournamentAccessGrantedBy")
  grantedTeamAccess       PlayerTeamAccess[]       @relation("PlayerTeamAccessGrantedBy")
  ownedTournaments      Tournament[]             @relation("TournamentOwner")
  tournamentPermissions TournamentPermission[]
  ownedTeams            TeamClub[]               @relation("TeamClubOwner")
  teamPermissions       TeamClubPermission[]
  ownedHouseholds         Household[]              @relation("HouseholdOwner")
  householdPermissions    HouseholdPermission[]
  grantedHouseholdAccess  PlayerHouseholdAccess[]  @relation("PlayerHouseholdAccessGrantedBy")
  knightCharacters      KnightCharacter[]        @relation("KnightCharacterOwner")

  @@map("app_user")
}

model AdminFeaturePermission {
  id      BigInt  @id @default(autoincrement())
  adminId BigInt  @map("admin_id")
  feature String  @db.VarChar(40)
  admin   AppUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, feature])
  @@map("admin_feature_permission")
}

model Player {
  id          BigInt   @id @default(autoincrement())
  displayName String   @map("display_name") @db.VarChar(255)
  email       String   @unique @db.VarChar(255)
  skillLevel  String?  @map("skill_level") @db.VarChar(10)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  registrations    TournamentRegistration[]
  teamMembers      TeamMember[]
  tournamentAccess PlayerTournamentAccess[]
  teamAccess       PlayerTeamAccess[]
  householdAccess  PlayerHouseholdAccess[]
  groupMembers     PlayerGroupMember[]
  guestReceipts    TeamGuestReceipt[]

  @@map("player")
}

// Nhóm thành viên: gom sẵn người hay chơi chung. Đội bóng liên kết nhóm (TeamClubGroup) thì thêm
// người vào nhóm là tự vào đội; giải đấu chỉ lấy danh sách lúc thêm. Xem src/groups/group.service.ts.
model PlayerGroup {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  ownerAdminId BigInt?  @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ownerAdmin AppUser?            @relation("PlayerGroupOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  members    PlayerGroupMember[]
  teams      TeamClubGroup[]

  @@index([ownerAdminId])
  @@map("player_group")
}

model PlayerGroupMember {
  id        BigInt   @id @default(autoincrement())
  groupId   BigInt   @map("group_id")
  playerId  BigInt   @map("player_id")
  createdAt DateTime @default(now()) @map("created_at")

  group  PlayerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([groupId, playerId])
  @@index([playerId])
  @@map("player_group_member")
}

model Tournament {
  id                          BigInt    @id @default(autoincrement())
  name                        String    @db.VarChar(255)
  venue                       String?   @db.VarChar(255)
  startTime                   DateTime? @map("start_time")
  endTime                     DateTime? @map("end_time")
  courtCount                  Int       @default(1) @map("court_count")
  expectedPlayers             Int       @default(10) @map("expected_players")
  playType                    String    @default("SINGLES") @map("play_type") @db.VarChar(20)
  format                      String    @default("ROUND_ROBIN") @db.VarChar(20)
  pairingRule                 String    @default("BY_SKILL") @map("pairing_rule") @db.VarChar(20)
  knockoutQualifierCount      Int       @default(4) @map("knockout_qualifier_count")
  touchScore                  Int       @default(11) @map("touch_score")
  maxScore                    Int       @default(15) @map("max_score")
  knockoutTouchScore          Int       @default(15) @map("knockout_touch_score")
  knockoutMaxScore            Int       @default(19) @map("knockout_max_score")
  courtCost                   Decimal   @default(0) @map("court_cost") @db.Decimal(14, 2)
  foodCost                    Decimal   @default(0) @map("food_cost") @db.Decimal(14, 2)
  prizeCost                   Decimal   @default(0) @map("prize_cost") @db.Decimal(14, 2)
  otherCost                   Decimal   @default(0) @map("other_cost") @db.Decimal(14, 2)
  /// Lệ phí mỗi người, nhập tay ở Cài đặt (9/2026). 0 = giải cũ chưa đặt, suy từ tổng chi phí / số người.
  feePerPlayer                Decimal   @default(0) @map("fee_per_player") @db.Decimal(14, 2)
  prizeRate1                  Decimal   @default(50) @map("prize_rate_1") @db.Decimal(14, 2)
  prizeRate2                  Decimal   @default(30) @map("prize_rate_2") @db.Decimal(14, 2)
  prizeRate3                  Decimal   @default(20) @map("prize_rate_3") @db.Decimal(14, 2)
  externalRegistrationEnabled Boolean   @default(false) @map("external_registration_enabled")
  ownerAdminId                BigInt?   @map("owner_admin_id")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @default(now()) @map("updated_at")

  ownerAdmin    AppUser?                 @relation("TournamentOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  registrations TournamentRegistration[]
  matches       MatchGame[]
  permissions   TournamentPermission[]
  playerAccess  PlayerTournamentAccess[]

  @@map("tournament")
}

// Quyền XEM giải của một vận động viên (vai CLIENT). Cấp ở màn hình Thành viên, hoặc tự cấp khi
// admin thêm người vào giải. Có tên trong giải KHÔNG còn tự động = được xem giải (xem docs/bao-mat.md).
model PlayerTournamentAccess {
  id               BigInt   @id @default(autoincrement())
  playerId         BigInt   @map("player_id")
  tournamentId     BigInt   @map("tournament_id")
  grantedByAdminId BigInt?  @map("granted_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  grantedBy  AppUser?   @relation("PlayerTournamentAccessGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([playerId, tournamentId])
  @@index([tournamentId])
  @@map("player_tournament_access")
}

model TournamentPermission {
  id           BigInt   @id @default(autoincrement())
  tournamentId BigInt   @map("tournament_id")
  adminId      BigInt   @map("admin_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  admin      AppUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, adminId])
  @@map("tournament_permission")
}

model TournamentRegistration {
  id            BigInt    @id @default(autoincrement())
  tournamentId  BigInt    @map("tournament_id")
  playerId      BigInt?   @map("player_id")
  externalName  String?   @map("external_name") @db.VarChar(255)
  externalEmail String?   @map("external_email") @db.VarChar(255)
  skillLevel    String?   @map("skill_level") @db.VarChar(10)
  source        String    @default("INTERNAL") @db.VarChar(20)
  status        String    @default("ACTIVE") @db.VarChar(20)
  paidAmount    Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentStatus String    @default("UNPAID") @map("payment_status") @db.VarChar(40)
  withdrawnAt   DateTime? @map("withdrawn_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, playerId])
  @@unique([tournamentId, externalEmail])
  @@map("tournament_registration")
}

model MatchGame {
  id           BigInt   @id @default(autoincrement())
  tournamentId BigInt   @map("tournament_id")
  teamA        String   @map("team_a") @db.VarChar(255)
  teamB        String   @map("team_b") @db.VarChar(255)
  scoreA       Int      @default(0) @map("score_a")
  scoreB       Int      @default(0) @map("score_b")
  status       String   @default("SCHEDULED") @db.VarChar(30)
  courtNumber  Int      @default(1) @map("court_number")
  roundNumber  Int      @default(1) @map("round_number")
  stage        String   @default("Vòng tròn") @db.VarChar(40)
  groupName    String?  @map("group_name") @db.VarChar(20)
  servingTeam  String   @default("A") @map("serving_team") @db.VarChar(1)
  scoreOrder   Int      @default(2) @map("score_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("match_game")
}

model TeamClub {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  description  String?
  ownerAdminId BigInt?  @map("owner_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  ownerAdmin  AppUser?             @relation("TeamClubOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  funds       TeamMonthFund[]
  expenses     TeamExpense[]
  permissions   TeamClubPermission[]
  playerAccess  PlayerTeamAccess[]
  groups        TeamClubGroup[]
  guestReceipts TeamGuestReceipt[]

  @@map("team_club")
}

// Khoản thu vãng lai: người ngoài đến chơi một buổi, ghi ngày + số tiền. Không phải thành viên đội.
model TeamGuestReceipt {
  id           BigInt   @id @default(autoincrement())
  teamId       BigInt   @map("team_id")
  playerId     BigInt?  @map("player_id")
  guestName    String?  @map("guest_name") @db.VarChar(255)
  receiptMonth DateTime @map("receipt_month") @db.Date
  receiptDate  DateTime @map("receipt_date") @db.Date
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  team   TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([teamId, receiptMonth])
  @@map("team_guest_receipt")
}

model TeamClubGroup {
  id        BigInt   @id @default(autoincrement())
  teamId    BigInt   @map("team_id")
  groupId   BigInt   @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")

  team  TeamClub    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  group PlayerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teamId, groupId])
  @@index([groupId])
  @@map("team_club_group")
}

model PlayerTeamAccess {
  id               BigInt   @id @default(autoincrement())
  playerId         BigInt   @map("player_id")
  teamId           BigInt   @map("team_id")
  grantedByAdminId BigInt?  @map("granted_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team      TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)
  grantedBy AppUser? @relation("PlayerTeamAccessGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([playerId, teamId])
  @@index([teamId])
  @@map("player_team_access")
}

model TeamClubPermission {
  id        BigInt   @id @default(autoincrement())
  teamId    BigInt   @map("team_id")
  adminId   BigInt   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")

  team  TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)
  admin AppUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([teamId, adminId])
  @@map("team_club_permission")
}

model TeamMember {
  id         BigInt   @id @default(autoincrement())
  teamId     BigInt   @map("team_id")
  playerId   BigInt   @map("player_id")
  memberType String   @default("FIXED") @map("member_type") @db.VarChar(20)
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  team     TeamClub            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  payments TeamMemberPayment[]

  @@unique([teamId, playerId])
  @@map("team_member")
}

model TeamMonthFund {
  id              BigInt   @id @default(autoincrement())
  teamId          BigInt   @map("team_id")
  fundMonth       DateTime @map("fund_month") @db.Date
  // AUTO: mức phí tự chia đều theo số cố định của tháng; MANUAL: admin gõ tay. Xem team-month.service.ts.
  feeMode         String   @default("AUTO") @map("fee_mode") @db.VarChar(10)
  monthlyFee      Decimal  @default(0) @map("monthly_fee") @db.Decimal(14, 2)
  courtCost       Decimal  @default(0) @map("court_cost") @db.Decimal(14, 2)
  otherCost       Decimal  @default(0) @map("other_cost") @db.Decimal(14, 2)
  previousBalance Decimal  @default(0) @map("previous_balance") @db.Decimal(14, 2)
  notes           String?

  team TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, fundMonth])
  @@map("team_month_fund")
}

model TeamMemberPayment {
  id            BigInt   @id @default(autoincrement())
  memberId      BigInt   @map("member_id")
  fundMonth     DateTime @map("fund_month") @db.Date
  // Loại thành viên TẠI THÁNG NÀY (ảnh chụp) — đổi loại/rời đội không sửa quá khứ.
  memberType    String?  @map("member_type") @db.VarChar(20)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentStatus String   @default("UNPAID") @map("payment_status") @db.VarChar(40)
  notes         String?

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, fundMonth])
  @@map("team_member_payment")
}

model TeamExpense {
  id           BigInt    @id @default(autoincrement())
  teamId       BigInt    @map("team_id")
  expenseMonth DateTime  @map("expense_month") @db.Date
  expenseDate  DateTime? @map("expense_date") @db.Date
  content      String    @db.VarChar(255)
  amount       Decimal   @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  team TeamClub @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_expense")
}

// ===== Game "Hiệp Sĩ Toán Học" (RPG học toán 4-7 tuổi) =====
// Hồ sơ nhân vật của người chơi: lưu tiến trình liên tục (Save/Load).
model KnightCharacter {
  id           BigInt   @id @default(autoincrement())
  ownerUserId  BigInt   @map("owner_user_id")
  name         String   @db.VarChar(60)
  gender       String   @default("boy") @db.VarChar(10) // 'boy' | 'girl'
  age          Int // 4..7
  notes        String   @default("") // Ghi chú cá nhân: điểm mạnh/yếu, sở thích
  currentStage Int      @default(1) @map("current_stage") // màn chơi hiện tại
  mobIndex     Int      @default(0) @map("mob_index") // đã đánh tới con quái thứ mấy của ải (chơi tiếp đúng chỗ)
  hp           Int      @default(10) // máu còn lại của lượt chơi hiện tại
  status       String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | RESTING | VICTORY
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  owner    AppUser          @relation("KnightCharacterOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  progress KnightProgress[]

  @@map("knight_character")
}

// Tiến trình từng ải đã vượt qua (lịch sử + số sao). Tra cứu bằng khoá chính xác
// [characterId, stageNumber] — không dùng lọc theo khoảng.
model KnightProgress {
  id          BigInt   @id @default(autoincrement())
  characterId BigInt   @map("character_id")
  stageNumber Int      @map("stage_number")
  status      String   @default("CLEARED") @db.VarChar(20) // CLEARED
  stars       Int      @default(0) // 0..3
  attempts    Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  character KnightCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, stageNumber])
  @@map("knight_progress")
}

model AppLog {
  id           BigInt   @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  level        String   @db.VarChar(20)
  category     String   @db.VarChar(80)
  action       String   @db.VarChar(255)
  method       String?  @db.VarChar(12)
  path         String?  @db.VarChar(500)
  queryString  String?  @map("query_string")
  statusCode   Int?     @map("status_code")
  durationMs   BigInt?  @map("duration_ms")
  userId       BigInt?  @map("user_id")
  username     String?  @db.VarChar(255)
  userRole     String?  @map("user_role") @db.VarChar(30)
  ipAddress    String?  @map("ip_address") @db.VarChar(120)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  details      String?
  errorMessage String?  @map("error_message")

  @@map("app_log")
}

// ─────────────────────────── Chi tiêu gia đình (9/2026) ───────────────────────────
// Lõi cố ý nhỏ: Nguồn tiền, Mục đích, Giao dịch, Khoản định kỳ. Mọi con số (số dư, dư nợ, báo cáo
// tháng) SUY từ giao dịch, không lưu. Xem src/household/household-month.ts và CLAUDE.md.

model Household {
  id               BigInt   @id @default(autoincrement())
  name             String   @db.VarChar(255)
  description      String?
  ownerAdminId     BigInt?  @map("owner_admin_id")
  /// Nhóm Telegram đã liên kết (gõ /link <mã> trong nhóm). Null = chưa liên kết.
  telegramChatId   String?  @map("telegram_chat_id") @db.VarChar(40)
  telegramLinkCode String?  @map("telegram_link_code") @db.VarChar(40)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  ownerAdmin   AppUser?                @relation("HouseholdOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  permissions  HouseholdPermission[]
  playerAccess PlayerHouseholdAccess[]
  sources      HouseholdSource[]
  purposes     HouseholdPurpose[]
  transactions HouseholdTransaction[]
  recurrings   HouseholdRecurring[]
  inbox        HouseholdInbox[]

  @@map("household")
}

model HouseholdPermission {
  id          BigInt   @id @default(autoincrement())
  householdId BigInt   @map("household_id")
  adminId     BigInt   @map("admin_id")
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  admin     AppUser   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([householdId, adminId])
  @@map("household_permission")
}

model PlayerHouseholdAccess {
  id               BigInt   @id @default(autoincrement())
  playerId         BigInt   @map("player_id")
  householdId      BigInt   @map("household_id")
  grantedByAdminId BigInt?  @map("granted_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  grantedBy AppUser?  @relation("PlayerHouseholdAccessGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@unique([playerId, householdId])
  @@index([householdId])
  @@map("player_household_access")
}

/// Nguồn tiền: BANK (tài khoản), CARD (thẻ tín dụng), LOAN (vay thế chấp/tín chấp/thấu chi), CASH.
/// `openingBalance` với BANK/CASH là số dư đầu, với CARD/LOAN là DƯ NỢ đầu (số dương).
model HouseholdSource {
  id             BigInt   @id @default(autoincrement())
  householdId    BigInt   @map("household_id")
  name           String   @db.VarChar(120)
  kind           String   @default("BANK") @db.VarChar(12)
  /// Mẫu đọc tin Telegram: VPBANK | MSB | OTHER.
  bank           String   @default("") @db.VarChar(20)
  /// Số tài khoản hoặc 4 số cuối thẻ để khớp tin ngân hàng.
  matchKey       String   @default("") @map("match_key") @db.VarChar(40)
  ownerName      String   @default("") @map("owner_name") @db.VarChar(120)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  /// Lãi suất %/năm (LOAN, CARD). 0 = không lãi.
  interestRate   Decimal  @default(0) @map("interest_rate") @db.Decimal(6, 2)
  statementDay   Int      @default(0) @map("statement_day")
  dueDay         Int      @default(0) @map("due_day")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  household         Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions      HouseholdTransaction[] @relation("SourceTransactions")
  incomingTransfers HouseholdTransaction[] @relation("TargetTransactions")
  recurrings        HouseholdRecurring[]   @relation("RecurringSource")
  recurringTargets  HouseholdRecurring[]   @relation("RecurringTarget")

  @@index([householdId])
  @@map("household_source")
}

/// Mục đích do từng hộ tự đặt; `kind` quyết định luật: LIVING | SAVING | DEBT | RESERVE | LENDING | INCOME.
model HouseholdPurpose {
  id          BigInt   @id @default(autoincrement())
  householdId BigInt   @map("household_id")
  name        String   @db.VarChar(120)
  kind        String   @default("LIVING") @db.VarChar(12)
  /// Kế hoạch mỗi tháng (0 = không đặt).
  monthlyPlan Decimal  @default(0) @map("monthly_plan") @db.Decimal(14, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions HouseholdTransaction[]
  recurrings   HouseholdRecurring[]

  @@index([householdId])
  @@map("household_purpose")
}

/// `kind`: EXPENSE (tiền ra khỏi nguồn), INCOME (tiền vào nguồn), TRANSFER (nguồn → nguồn đích).
/// TRANSFER sang LOAN là trả nợ: `interest` là phần lãi (tính như chi tiêu), phần còn lại trừ gốc.
/// TRANSFER sang CARD là trả thẻ: không phải chi tiêu (đã tính lúc quẹt).
model HouseholdTransaction {
  id             BigInt    @id @default(autoincrement())
  householdId    BigInt    @map("household_id")
  kind           String    @default("EXPENSE") @db.VarChar(10)
  sourceId       BigInt    @map("source_id")
  targetSourceId BigInt?   @map("target_source_id")
  purposeId      BigInt?   @map("purpose_id")
  recurringId    BigInt?   @map("recurring_id")
  amount         Decimal   @default(0) @db.Decimal(14, 2)
  interest       Decimal   @default(0) @db.Decimal(14, 2)
  /// Số dư ngân hàng báo NGAY SAU giao dịch này (Timo có). Chỉ để so với số app tính, không tham gia tính.
  reportedBalance Decimal? @map("reported_balance") @db.Decimal(14, 2)
  /// Hạn mức KHẢ DỤNG của thẻ ngay sau giao dịch này (MSB có). Không phải hạn mức tổng, không suy ra dư nợ.
  reportedAvailable Decimal? @map("reported_available") @db.Decimal(14, 2)
  occurredAt     DateTime  @map("occurred_at")
  month          String    @db.VarChar(7)
  description    String    @default("") @db.VarChar(255)
  rawText        String?   @map("raw_text")
  /// Mã giao dịch ngân hàng / mã tin Telegram — chống ghi trùng.
  externalId     String?   @map("external_id") @db.VarChar(120)
  /// NEW = máy ghi, chưa ai xác nhận mục đích; CONFIRMED = đã có người xem.
  status         String    @default("CONFIRMED") @db.VarChar(10)
  telegramChatId String?   @map("telegram_chat_id") @db.VarChar(40)
  telegramMsgId  BigInt?   @map("telegram_msg_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  source       HouseholdSource     @relation("SourceTransactions", fields: [sourceId], references: [id], onDelete: Cascade)
  targetSource HouseholdSource?    @relation("TargetTransactions", fields: [targetSourceId], references: [id], onDelete: SetNull)
  purpose      HouseholdPurpose?   @relation(fields: [purposeId], references: [id], onDelete: SetNull)
  recurring    HouseholdRecurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([householdId, externalId])
  @@index([householdId, month])
  @@index([sourceId])
  @@map("household_transaction")
}

/// Khoản định kỳ: khai một lần, tháng nào cũng tự sinh dòng "dự kiến" và khớp với giao dịch thật.
/// `interestMode` = FROM_RATE: lãi = dư nợ nguồn đích × lãi suất / 12, cộng vào `amount` (gốc).
model HouseholdRecurring {
  id             BigInt   @id @default(autoincrement())
  householdId    BigInt   @map("household_id")
  name           String   @db.VarChar(120)
  kind           String   @default("EXPENSE") @db.VarChar(10)
  sourceId       BigInt?  @map("source_id")
  targetSourceId BigInt?  @map("target_source_id")
  purposeId      BigInt?  @map("purpose_id")
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  interestMode   String   @default("NONE") @map("interest_mode") @db.VarChar(10)
  dayOfMonth     Int      @default(1) @map("day_of_month")
  startMonth     String   @map("start_month") @db.VarChar(7)
  endMonth       String?  @map("end_month") @db.VarChar(7)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  note           String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  household    Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  source       HouseholdSource?       @relation("RecurringSource", fields: [sourceId], references: [id], onDelete: SetNull)
  targetSource HouseholdSource?       @relation("RecurringTarget", fields: [targetSourceId], references: [id], onDelete: SetNull)
  purpose      HouseholdPurpose?      @relation(fields: [purposeId], references: [id], onDelete: SetNull)
  transactions HouseholdTransaction[]

  @@index([householdId])
  @@map("household_recurring")
}

/// Tin Telegram đã nhận: cái nào đọc ra giao dịch thì PARSED, không đọc được thì UNPARSED để xử lý tay.
model HouseholdInbox {
  id            BigInt   @id @default(autoincrement())
  householdId   BigInt?  @map("household_id")
  chatId        String   @map("chat_id") @db.VarChar(40)
  messageId     BigInt   @map("message_id")
  text          String
  status        String   @default("UNPARSED") @db.VarChar(10)
  transactionId BigInt?  @map("transaction_id")
  receivedAt    DateTime @default(now()) @map("received_at")

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([chatId, messageId])
  @@index([householdId, status])
  @@map("household_inbox")
}
