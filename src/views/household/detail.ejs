<%- include('../partials/head', { title: household.name }) %>
<%- include('../partials/topbar') %>
<%
  const isAdmin = currentUser.role === 'ADMIN';
  const fmtDate = (value) => new Date(value).toLocaleDateString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });
  const fmtDateTime = (value) => new Date(value).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
  // Giá trị cho input datetime-local theo giờ VN.
  const inputDateTime = (value) => new Date(new Date(value).getTime() + 7 * 3600 * 1000).toISOString().slice(0, 16);
  const kindBadge = { EXPENSE: 'bg-danger', INCOME: 'bg-success', TRANSFER: 'bg-info' };
  const activeSources = sources.filter((source) => source.active);
  const activePurposes = purposes.filter((purpose) => purpose.active);
  // `const` ở đây KHÔNG tự sang phần con khi include — phải truyền tường minh qua tham số thứ hai.
  const hh = { isAdmin, fmtDate, fmtDateTime, inputDateTime, kindBadge, activeSources, activePurposes };
%>
<main class="app-shell team-detail-shell" data-household-id="<%= household.id %>">
  <%- include('detail-parts/hero') %>
  <nav class="section-tabs" aria-label="Mục trong hộ">
    <% (isAdmin ? ['overview','transactions','sources','recurring','settings'] : ['overview','transactions','sources','recurring']).forEach((item) => { const labelsTab = {overview:'Tổng quan', transactions:'Giao dịch', sources:'Nguồn tiền', recurring:'Định kỳ', settings:'Cài đặt'}; const icons = {overview:'chart', transactions:'receipt', sources:'card', recurring:'refresh', settings:'settings'}; %><a class="<%= section === item ? 'active' : '' %>" href="/household/<%= household.id %>/<%= item %>?month=<%= selectedMonth %>"><%- include('../partials/icon', { name: icons[item] }) %><span><%= labelsTab[item] %></span><% if (item === 'transactions' && unclassifiedAll) { %><em class="tab-count"><%= unclassifiedAll %></em><% } %></a><% }) %>
  </nav>
  <%- include('detail-parts/overview', hh) %>
  <%- include('detail-parts/transactions', hh) %>
  <%- include('detail-parts/sources', hh) %>
  <%- include('detail-parts/recurring', hh) %>
  <%- include('detail-parts/settings', hh) %>
</main>
<%- include('detail-parts/menu-scripts') %>
