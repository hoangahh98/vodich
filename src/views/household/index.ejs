<%- include('../partials/head', { title: 'Quản lý chi tiêu' }) %>
<%- include('../partials/topbar') %>
<%
  // Luôn quy về giờ Việt Nam: server chạy UTC nên toISOString sẽ hiển thị lệch ngày.
  const ymd = (d) => new Date(d).toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });
  const dmy = (d) => ymd(d).split('-').reverse().join('/');
  const monthLabel = (m) => `${Number(m.slice(5, 7))}/${m.slice(0, 4)}`;
  const today = ymd(new Date());

  const INCOME_KIND = { normal: '💵 Thu nhập', saving: '🐷 Rút tiết kiệm', debt: '🤝 Người ta trả nợ mình' };
  const EXPENSE_KIND = { normal: '💸 Chi phí', saving: '🐷 Gửi tiết kiệm', debt: '🏦 Trả nợ' };

  // Các mục xoay quanh MỘT tháng thì cần ô chọn tháng; danh mục và cài đặt thì không.
  const MONTH_SECTIONS = ['tong-quan', 'thu', 'chi', 'so-no', 'tro-ly'];
  const sectionPath = section === 'tong-quan' ? '/household' : `/household/${section}`;
  const money = (value) => `${formatMoney(value)}đ`;
  const signed = (value) => `${Number(value) < 0 ? '−' : '+'}${formatMoney(Math.abs(Number(value)))}đ`;

  const incomeCatById = new Map(book.incomeCategories.map((c) => [String(c.id), c]));
  const expenseCatById = new Map(book.expenseCategories.map((c) => [String(c.id), c]));
  const debtById = new Map(book.debts.map((d) => [String(d.id), d]));
  const oweDebts = book.debts.filter((d) => d.direction === 'owe');
  const lendDebts = book.debts.filter((d) => d.direction === 'lend');
  const liveIncomeCats = book.incomeCategories.filter((c) => c.active);
  const liveExpenseCats = book.expenseCategories.filter((c) => c.active);
  const catName = (map, id) => (map.get(String(id)) || {}).name || '(loại đã xoá)';
  // Thang tỷ lệ của dải 6 tháng: lấy số lớn nhất làm 100% để các cột so được với nhau.
  const trendPeak = Math.max(1, ...report.trend.map((t) => Math.max(t.income, t.expense)));
%>
<main class="app-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <h1>💰 <%= currentBook.name %></h1>
        <div class="muted strong-muted">Khai thu &amp; chi theo loại · tiết kiệm dồn qua các tháng · sổ nợ hai chiều.</div>
      </div>
      <% if (MONTH_SECTIONS.includes(section)) { %>
        <%# Bọc trong div: ở màn hẹp .feature-hero .flex đổi sang cột, `flex: 0 0 170px`
            của .month-filter sẽ thành CHIỀU CAO 170px và form bị kéo vuông. %>
        <div class="household-hero-tools">
          <form method="get" action="<%= sectionPath %>" class="month-filter"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <label>Tháng</label>
            <input type="month" name="month" value="<%= report.month %>" data-autosubmit>
          </form>
        </div>
      <% } %>
    </div>
  </section>

  <% if (msg) { %><div class="alert alert-success mb"><%= msg %></div><% } %>
  <% if (err) { %><div class="alert alert-danger mb"><%= err %></div><% } %>

  <% if (MONTH_SECTIONS.includes(section)) { %>
    <%# Ba con số của tháng, hiện ở mọi mục để lúc nào cũng biết đang đứng ở đâu. %>
    <div class="hh-strip mb">
      <div><span>Thu nhập tháng <%= monthLabel(report.month) %></span><strong class="hh-pos"><%= money(report.income) %></strong></div>
      <div><span>Chi phí tháng <%= monthLabel(report.month) %></span><strong class="hh-neg"><%= money(report.expense) %></strong></div>
      <div class="hh-strip-total"><span>Còn lại tháng này</span><strong class="<%= report.leftover < 0 ? 'hh-neg' : 'hh-pos' %>"><%= money(report.leftover) %></strong></div>
    </div>
  <% } %>

  <!-- ═══ TỔNG QUAN ═══ -->
  <% if (section === 'tong-quan') { %>
    <section class="grid finance-grid mb">
      <details class="metric-card gold metric-drop">
        <summary>
          <span>🐷 Tiết kiệm đang có</span><strong><%= money(report.savingBalance) %></strong>
          <small>Dồn qua tất cả các tháng, tính tới hết tháng <%= monthLabel(report.month) %></small>
        </summary>
        <div class="metric-drop-body">
          <div><span>Gửi thêm tháng này</span><strong><%= signed(report.savingIn) %></strong></div>
          <div><span>Rút ra tháng này</span><strong><%= signed(-report.savingOut) %></strong></div>
          <div><span>= Tăng/giảm tháng này</span><strong><%= signed(report.savingNet) %></strong></div>
          <% report.savingByCategory.forEach((row) => { %>
            <div><span><%= row.name %></span><strong><%= money(row.amount) %></strong></div>
          <% }) %>
          <p class="metric-drop-note">Mọi loại chi phí đánh dấu <strong>Gửi tiết kiệm</strong> đều chảy vào chung ô này.</p>
        </div>
      </details>
      <div class="metric-card red">
        <span>💸 Chi phí tháng <%= monthLabel(report.month) %></span><strong><%= money(report.expense) %></strong>
        <small><%= book.expenses.length %> khoản đã khai · gồm cả gốc &amp; lãi trả nợ</small>
      </div>
      <div class="metric-card green">
        <span>💵 Thu nhập tháng <%= monthLabel(report.month) %></span><strong><%= money(report.income) %></strong>
        <small><%= book.incomes.length %> khoản đã khai</small>
      </div>
      <details class="metric-card <%= report.leftoverTotal < 0 ? 'red' : 'blue' %> metric-drop">
        <summary>
          <span>💰 Còn lại luỹ kế</span><strong><%= money(report.leftoverTotal) %></strong>
          <small>Bấm để xem cách tính của tháng <%= monthLabel(report.month) %></small>
        </summary>
        <div class="metric-drop-body">
          <div><span>Thu nhập</span><strong><%= signed(report.income) %></strong></div>
          <div><span>Rút tiết kiệm ra tiêu</span><strong><%= signed(report.savingOut) %></strong></div>
          <div><span>Chi phí (gồm trả nợ)</span><strong><%= signed(-report.expense) %></strong></div>
          <div><span>Gửi tiết kiệm</span><strong><%= signed(-report.savingIn) %></strong></div>
          <div><span>= Còn lại tháng này</span><strong><%= money(report.leftover) %></strong></div>
          <div><span>+ Còn lại các tháng trước</span><strong><%= money(report.leftoverPrevious) %></strong></div>
          <p class="metric-drop-note">Đây là tiền mặt chưa cất đi đâu. Tiền đã gửi tiết kiệm nằm ở ô 🐷 bên trên.</p>
        </div>
      </details>
    </section>

    <section class="grid finance-grid mb">
      <div class="metric-card <%= report.oweRemaining > 0 ? 'red' : 'green' %>">
        <span>🏦 Mình đang nợ</span><strong><%= money(report.oweRemaining) %></strong>
        <small>Tháng này trả gốc <%= money(report.debtPrincipalPaid) %> · lãi <%= money(report.debtInterestPaid) %></small>
      </div>
      <div class="metric-card blue">
        <span>🤝 Người khác nợ mình</span><strong><%= money(report.lendRemaining) %></strong>
        <small>Tháng này thu về gốc <%= money(report.debtPrincipalCollected) %> · lãi <%= money(report.debtInterestCollected) %></small>
      </div>
    </section>

    <section class="card-lite mb">
      <div class="card-hdr red"><span>💸 Chi phí tháng <%= monthLabel(report.month) %> theo loại</span><span><%= money(report.expense) %></span></div>
      <div class="p">
        <div class="table-wrap"><table>
          <thead><tr><th>Loại</th><th>Số khoản</th><th>Tỷ trọng</th><th class="text-right">Số tiền</th></tr></thead>
          <tbody>
            <% report.expenseByCategory.forEach((row) => { %>
              <tr>
                <td><strong><%= row.name %></strong><% if (row.kind === 'debt') { %> <span class="muted">🏦 trả nợ</span><% } %></td>
                <td><%= row.count %></td>
                <td><div class="hh-bar"><span class="hh-bar-fill red" style="width: <%= row.share %>%"></span></div><span class="muted"><%= row.share %>%</span></td>
                <td class="text-right"><strong><%= money(row.amount) %></strong></td>
              </tr>
            <% }) %>
            <% if (!report.expenseByCategory.length) { %><tr><td colspan="4" class="muted text-center">Tháng này chưa khai khoản chi nào.</td></tr><% } %>
          </tbody>
        </table></div>
      </div>
    </section>

    <section class="card-lite mb">
      <div class="card-hdr green"><span>💵 Thu nhập tháng <%= monthLabel(report.month) %> theo loại</span><span><%= money(report.income) %></span></div>
      <div class="p">
        <div class="table-wrap"><table>
          <thead><tr><th>Loại</th><th>Số khoản</th><th>Tỷ trọng</th><th class="text-right">Số tiền</th></tr></thead>
          <tbody>
            <% report.incomeByCategory.forEach((row) => { %>
              <tr>
                <td><strong><%= row.name %></strong><% if (row.kind === 'debt') { %> <span class="muted">🤝 thu nợ</span><% } %></td>
                <td><%= row.count %></td>
                <td><div class="hh-bar"><span class="hh-bar-fill green" style="width: <%= row.share %>%"></span></div><span class="muted"><%= row.share %>%</span></td>
                <td class="text-right"><strong><%= money(row.amount) %></strong></td>
              </tr>
            <% }) %>
            <% if (!report.incomeByCategory.length) { %><tr><td colspan="4" class="muted text-center">Tháng này chưa khai khoản thu nào.</td></tr><% } %>
          </tbody>
        </table></div>
      </div>
    </section>

    <section class="card-lite mb">
      <div class="card-hdr blue"><span>📈 Sáu tháng gần nhất</span><span>Tiết kiệm đang có <%= money(report.savingBalance) %></span></div>
      <div class="p">
        <div class="table-wrap"><table>
          <thead><tr><th>Tháng</th><th>Thu / Chi</th><th>Gửi tiết kiệm</th><th class="text-right">Còn lại</th></tr></thead>
          <tbody>
            <% report.trend.forEach((row) => { %>
              <tr class="<%= row.month === report.month ? 'hh-row-total' : '' %>">
                <td><strong><%= monthLabel(row.month) %></strong></td>
                <td>
                  <div class="hh-bar"><span class="hh-bar-fill green" style="width: <%= Math.round((row.income / trendPeak) * 100) %>%"></span></div>
                  <div class="hh-bar"><span class="hh-bar-fill red" style="width: <%= Math.round((row.expense / trendPeak) * 100) %>%"></span></div>
                  <span class="muted"><%= money(row.income) %> / <%= money(row.expense) %></span>
                </td>
                <td><%= money(row.savingIn) %></td>
                <td class="text-right"><strong class="<%= row.leftover < 0 ? 'hh-neg' : 'hh-pos' %>"><%= money(row.leftover) %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      </div>
    </section>

    <%# Thiếu MỘT trong hai bên là đã không khai được rồi (không có loại chi phí thì không ghi
        nổi khoản chi nào), nên nhắc ngay ở Tổng quan chứ đừng đợi cả hai cùng rỗng. %>
    <% if (!book.incomeCategories.length || !book.expenseCategories.length) { %>
      <section class="card-lite p">
        <h2 class="section-title mb">Sổ chưa khai đủ loại</h2>
        <p class="muted">
          Đang có <%= book.incomeCategories.length %> loại thu nhập và <%= book.expenseCategories.length %> loại chi phí.
          Nạp sẵn vài loại thường gặp rồi sửa lại cho khớp nhà mình — không có số tiền nào được nạp sẵn.
        </p>
        <form method="post" action="/household/seed"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <input type="hidden" name="section" value="tong-quan">
          <button class="btn btn-success" data-loading-text="Đang nạp...">📋 Nạp danh mục mẫu</button>
        </form>
      </section>
    <% } %>
  <% } %>

  <!-- ═══ KHAI THU NHẬP ═══ -->
  <% if (section === 'thu') { %>
    <section class="card-lite mb">
      <div class="card-hdr green"><span>💵 Khai một khoản thu</span><span><%= liveIncomeCats.length %> loại thu nhập</span></div>
      <div class="p">
        <% if (liveIncomeCats.length) { %>
          <%# Ô "gốc / lãi / khoản cho vay" chỉ hiện khi loại thu là "người ta trả nợ mình";
              JS ở form-controls.js bật tắt theo data-kind. Không có JS thì hiện hết, và
              service vẫn đọc đúng ô theo kiểu của loại nên không ghi sai. %>
          <form class="household-form mb" method="post" action="/household/income" data-entry-form><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <div><label>Ngày</label><input type="date" name="occurredAt" value="<%= today %>" required></div>
            <div><label>Loại thu nhập</label>
              <select name="categoryId" data-entry-kind>
                <% liveIncomeCats.forEach((c) => { %><option value="<%= c.id %>" data-kind="<%= c.kind %>"><%= c.name %><%= c.kind === 'normal' ? '' : ` — ${INCOME_KIND[c.kind]}` %></option><% }) %>
              </select>
            </div>
            <div data-entry-plain><label>Số tiền</label><input class="money-input" name="amount"></div>
            <div data-entry-debt><label>Khoản cho vay</label>
              <select name="debtId">
                <% lendDebts.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %><%= d.counterparty ? ` — ${d.counterparty}` : '' %></option><% }) %>
                <% if (!lendDebts.length) { %><option value="">Chưa có khoản cho vay nào</option><% } %>
              </select>
            </div>
            <div data-entry-debt><label>Gốc thu về</label><input class="money-input" name="principal"></div>
            <div data-entry-debt><label>Lãi thu về</label><input class="money-input" name="interest"></div>
            <div class="household-form-wide"><label>Ghi chú</label><input name="note" placeholder="Không bắt buộc"></div>
            <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang ghi...">Ghi khoản thu</button></div>
          </form>
        <% } else { %>
          <div class="alert-lite warn mb">Chưa có loại thu nhập nào. Vào mục <strong>🏷️ Loại thu nhập</strong> khai trước đã.</div>
        <% } %>
        <div class="table-wrap"><table>
          <thead><tr><th>Ngày</th><th>Loại</th><th>Ghi chú</th><th>Số tiền</th><th></th></tr></thead>
          <tbody>
            <% book.incomes.forEach((i) => { %>
              <tr>
                <td><%= dmy(i.occurredAt) %></td>
                <td>
                  <strong><%= catName(incomeCatById, i.categoryId) %></strong>
                  <% if (i.debtId) { %><br><span class="muted">🤝 <%= (debtById.get(String(i.debtId)) || {}).name || '(khoản đã xoá)' %> · gốc <%= money(i.principal) %> · lãi <%= money(i.interest) %></span><% } %>
                </td>
                <td><%= i.note || '(không ghi)' %></td>
                <td><strong class="hh-pos"><%= signed(i.amount) %></strong></td>
                <td class="text-right"><form method="post" action="/household/income/<%= i.id %>/delete" data-confirm="Xoá khoản thu này?"><input type="hidden" name="book" value="<%= currentBook.id %>"><button class="btn btn-sm btn-danger" data-loading-text="Đang xoá...">Xoá</button></form></td>
              </tr>
            <% }) %>
            <% if (!book.incomes.length) { %><tr><td colspan="5" class="muted text-center">Chưa khai khoản thu nào cho tháng <%= monthLabel(report.month) %>.</td></tr><% } %>
          </tbody>
        </table></div>
        <form method="post" action="/household/income/copy"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <button class="btn btn-sm" data-loading-text="Đang chép...">📋 Chép các khoản thu của tháng trước</button>
        </form>
      </div>
    </section>
  <% } %>

  <!-- ═══ KHAI CHI PHÍ ═══ -->
  <% if (section === 'chi') { %>
    <section class="card-lite mb">
      <div class="card-hdr red"><span>💸 Khai một khoản chi</span><span><%= liveExpenseCats.length %> loại chi phí</span></div>
      <div class="p">
        <div class="alert-lite mb">
          Loại đánh dấu <strong>🐷 Gửi tiết kiệm</strong> thì tiền chảy vào ô Tiết kiệm chứ không tính là chi phí.
          Loại đánh dấu <strong>🏦 Trả nợ</strong> thì nhập <strong>gốc</strong> và <strong>lãi</strong> riêng —
          phần gốc tự trừ vào khoản nợ bạn chọn, lãi thì không làm giảm nợ.
        </div>
        <% if (liveExpenseCats.length) { %>
          <form class="household-form mb" method="post" action="/household/expenses" data-entry-form><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <div><label>Ngày chi</label><input type="date" name="occurredAt" value="<%= today %>" required></div>
            <div><label>Loại chi phí</label>
              <select name="categoryId" data-entry-kind>
                <% liveExpenseCats.forEach((c) => { %><option value="<%= c.id %>" data-kind="<%= c.kind %>"><%= c.name %><%= c.kind === 'normal' ? '' : ` — ${EXPENSE_KIND[c.kind]}` %></option><% }) %>
              </select>
            </div>
            <div data-entry-plain><label>Số tiền</label><input class="money-input" name="amount"></div>
            <div data-entry-debt><label>Trả cho khoản nợ</label>
              <select name="debtId">
                <% oweDebts.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %><%= d.counterparty ? ` — ${d.counterparty}` : '' %></option><% }) %>
                <% if (!oweDebts.length) { %><option value="">Chưa có khoản nợ nào</option><% } %>
              </select>
            </div>
            <div data-entry-debt><label>Trả gốc</label><input class="money-input" name="principal"></div>
            <div data-entry-debt><label>Trả lãi</label><input class="money-input" name="interest"></div>
            <div class="household-form-wide"><label>Ghi chú</label><input name="note" placeholder="Ăn trưa, đổ xăng, học phí..."></div>
            <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang ghi...">Ghi khoản chi</button></div>
          </form>
        <% } else { %>
          <div class="alert-lite warn mb">Chưa có loại chi phí nào. Vào mục <strong>🏷️ Loại chi phí</strong> khai trước đã.</div>
        <% } %>
        <div class="table-wrap"><table>
          <thead><tr><th>Ngày</th><th>Loại</th><th>Ghi chú</th><th>Số tiền</th><th></th></tr></thead>
          <tbody>
            <% book.expenses.forEach((e) => { %>
              <% const cat = expenseCatById.get(String(e.categoryId)) || {}; %>
              <tr>
                <td><%= dmy(e.occurredAt) %></td>
                <td>
                  <strong><%= cat.name || '(loại đã xoá)' %></strong>
                  <% if (cat.kind === 'saving') { %> <span class="muted">🐷 tiết kiệm</span><% } %>
                  <% if (e.debtId) { %><br><span class="muted">🏦 <%= (debtById.get(String(e.debtId)) || {}).name || '(khoản đã xoá)' %> · gốc <%= money(e.principal) %> · lãi <%= money(e.interest) %></span><% } %>
                </td>
                <td><%= e.note || '(không ghi)' %></td>
                <td><strong class="hh-neg"><%= signed(-Number(e.amount)) %></strong></td>
                <td class="text-right"><form method="post" action="/household/expenses/<%= e.id %>/delete" data-confirm="Xoá khoản chi này?"><input type="hidden" name="book" value="<%= currentBook.id %>"><button class="btn btn-sm btn-danger" data-loading-text="Đang xoá...">Xoá</button></form></td>
              </tr>
            <% }) %>
            <% if (!book.expenses.length) { %><tr><td colspan="5" class="muted text-center">Chưa khai khoản chi nào cho tháng <%= monthLabel(report.month) %>.</td></tr><% } %>
          </tbody>
        </table></div>
      </div>
    </section>
  <% } %>

  <!-- ═══ LOẠI THU NHẬP ═══ -->
  <% if (section === 'loai-thu') { %>
    <section class="card-lite mb">
      <div class="card-hdr green"><span>🏷️ Loại thu nhập</span><span><%= book.incomeCategories.length %> loại</span></div>
      <div class="p">
        <div class="alert-lite mb">
          <strong>💵 Thu nhập</strong>: tiền vào thật, cộng vào ô Thu nhập.
          <strong>🐷 Rút tiết kiệm</strong>: lấy tiền từ két ra tiêu — trừ vào ô Tiết kiệm, không tính là thu nhập.
          <strong>🤝 Người ta trả nợ mình</strong>: nhập gốc &amp; lãi, gốc trừ vào khoản cho vay trong sổ nợ.
        </div>
        <% book.incomeCategories.forEach((c) => { %>
          <%# Form xoá để rỗng, nút Xoá nằm trong form sửa và trỏ sang bằng thuộc tính `form`
              (HTML không cho lồng form) — nhờ vậy Lưu và Xoá đứng cạnh nhau trên cùng một hàng. %>
          <form id="hh-inc-del-<%= c.id %>" method="post" action="/household/income-categories/<%= c.id %>/delete"
                data-confirm="Xoá loại <%= c.name %>? Các khoản đã khai theo loại này vẫn còn trong sổ."><input type="hidden" name="book" value="<%= currentBook.id %>"><input type="hidden" name="month" value="<%= report.month %>"></form>
          <form class="household-form household-member-row" method="post" action="/household/income-categories/<%= c.id %>"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <div><label>Tên loại</label><input name="name" value="<%= c.name %>" required></div>
            <div><label>Kiểu</label>
              <select name="kind">
                <option value="normal" <%= c.kind === 'normal' ? 'selected' : '' %>>💵 Thu nhập</option>
                <option value="saving" <%= c.kind === 'saving' ? 'selected' : '' %>>🐷 Rút tiết kiệm</option>
                <option value="debt" <%= c.kind === 'debt' ? 'selected' : '' %>>🤝 Người ta trả nợ mình</option>
              </select>
            </div>
            <div><label>Trạng thái</label>
              <select name="active">
                <option value="true" <%= c.active ? 'selected' : '' %>>Đang dùng</option>
                <option value="false" <%= c.active ? '' : 'selected' %>>Ẩn đi</option>
              </select>
            </div>
            <div class="household-form-wide"><label>Ghi chú</label><input name="note" value="<%= c.note %>" placeholder="Không bắt buộc"></div>
            <div class="household-form-action">
              <button class="btn btn-success" data-loading-text="Đang lưu...">Lưu</button>
              <button class="btn btn-danger" form="hh-inc-del-<%= c.id %>" data-loading-text="Đang xoá...">Xoá</button>
            </div>
          </form>
        <% }) %>
        <% if (!book.incomeCategories.length) { %><p class="muted text-center">Chưa khai loại thu nhập nào.</p><% } %>

        <h2 class="section-title mb">➕ Thêm loại thu nhập</h2>
        <form class="household-form" method="post" action="/household/income-categories"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <div><label>Tên loại</label><input name="name" placeholder="Lương vợ / Thưởng / Cho thuê nhà" required></div>
          <div><label>Kiểu</label>
            <select name="kind">
              <option value="normal" selected>💵 Thu nhập</option>
              <option value="saving">🐷 Rút tiết kiệm</option>
              <option value="debt">🤝 Người ta trả nợ mình</option>
            </select>
          </div>
          <div class="household-form-wide"><label>Ghi chú</label><input name="note" placeholder="Không bắt buộc"></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm</button></div>
        </form>

        <% if (!book.incomeCategories.length) { %>
          <form class="mt" method="post" action="/household/seed"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <input type="hidden" name="section" value="loai-thu">
            <button class="btn btn-sm" data-loading-text="Đang nạp...">📋 Nạp danh mục mẫu</button>
          </form>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ═══ LOẠI CHI PHÍ ═══ -->
  <% if (section === 'loai-chi') { %>
    <section class="card-lite mb">
      <div class="card-hdr red"><span>🏷️ Loại chi phí</span><span><%= book.expenseCategories.length %> loại</span></div>
      <div class="p">
        <div class="alert-lite mb">
          <strong>💸 Chi phí</strong>: tiền ra thường ngày.
          <strong>🐷 Gửi tiết kiệm</strong>: tiền cất đi — cộng vào ô Tiết kiệm và <strong>dồn qua các tháng</strong>, không tính là chi phí.
          <strong>🏦 Trả nợ</strong>: khai gốc &amp; lãi riêng, gốc tự trừ vào khoản nợ được chọn trong sổ nợ.
        </div>
        <% book.expenseCategories.forEach((c) => { %>
          <form id="hh-exp-del-<%= c.id %>" method="post" action="/household/expense-categories/<%= c.id %>/delete"
                data-confirm="Xoá loại <%= c.name %>? Các khoản đã khai theo loại này vẫn còn trong sổ."><input type="hidden" name="book" value="<%= currentBook.id %>"><input type="hidden" name="month" value="<%= report.month %>"></form>
          <form class="household-form household-member-row" method="post" action="/household/expense-categories/<%= c.id %>"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <div><label>Tên loại</label><input name="name" value="<%= c.name %>" required></div>
            <div><label>Kiểu</label>
              <select name="kind">
                <option value="normal" <%= c.kind === 'normal' ? 'selected' : '' %>>💸 Chi phí</option>
                <option value="saving" <%= c.kind === 'saving' ? 'selected' : '' %>>🐷 Gửi tiết kiệm</option>
                <option value="debt" <%= c.kind === 'debt' ? 'selected' : '' %>>🏦 Trả nợ</option>
              </select>
            </div>
            <div><label>Trạng thái</label>
              <select name="active">
                <option value="true" <%= c.active ? 'selected' : '' %>>Đang dùng</option>
                <option value="false" <%= c.active ? '' : 'selected' %>>Ẩn đi</option>
              </select>
            </div>
            <div class="household-form-wide"><label>Ghi chú</label><input name="note" value="<%= c.note %>" placeholder="Không bắt buộc"></div>
            <div class="household-form-action">
              <button class="btn btn-success" data-loading-text="Đang lưu...">Lưu</button>
              <button class="btn btn-danger" form="hh-exp-del-<%= c.id %>" data-loading-text="Đang xoá...">Xoá</button>
            </div>
          </form>
        <% }) %>
        <% if (!book.expenseCategories.length) { %><p class="muted text-center">Chưa khai loại chi phí nào.</p><% } %>

        <h2 class="section-title mb">➕ Thêm loại chi phí</h2>
        <form class="household-form" method="post" action="/household/expense-categories"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <div><label>Tên loại</label><input name="name" placeholder="Ăn uống / Xăng xe / Tiết kiệm con" required></div>
          <div><label>Kiểu</label>
            <select name="kind">
              <option value="normal" selected>💸 Chi phí</option>
              <option value="saving">🐷 Gửi tiết kiệm</option>
              <option value="debt">🏦 Trả nợ</option>
            </select>
          </div>
          <div class="household-form-wide"><label>Ghi chú</label><input name="note" placeholder="Không bắt buộc"></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm</button></div>
        </form>

        <% if (!book.expenseCategories.length) { %>
          <form class="mt" method="post" action="/household/seed"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <input type="hidden" name="section" value="loai-chi">
            <button class="btn btn-sm" data-loading-text="Đang nạp...">📋 Nạp danh mục mẫu</button>
          </form>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ═══ SỔ NỢ ═══ -->
  <% if (section === 'so-no') { %>
    <section class="grid finance-grid mb">
      <div class="metric-card <%= report.oweRemaining > 0 ? 'red' : 'green' %>">
        <span>🏦 Mình đang nợ</span><strong><%= money(report.oweRemaining) %></strong>
        <small><%= oweDebts.length %> khoản · tháng này trả gốc <%= money(report.debtPrincipalPaid) %></small>
      </div>
      <div class="metric-card blue">
        <span>🤝 Người khác nợ mình</span><strong><%= money(report.lendRemaining) %></strong>
        <small><%= lendDebts.length %> khoản · tháng này thu gốc <%= money(report.debtPrincipalCollected) %></small>
      </div>
      <div class="metric-card <%= report.debtNet < 0 ? 'red' : 'green' %>">
        <span>⚖️ Chênh lệch</span><strong><%= money(report.debtNet) %></strong>
        <small><%= report.debtNet < 0 ? 'Nợ nhiều hơn cho vay' : 'Cho vay nhiều hơn nợ' %></small>
      </div>
    </section>

    <div class="alert-lite mb">
      Sổ nợ chỉ <strong>khai</strong> khoản nợ. Tiền trả hàng tháng ghi ở mục <strong>💸 Chi phí</strong> (loại kiểu 🏦 Trả nợ),
      tiền người ta trả về ghi ở mục <strong>💵 Thu nhập</strong> (loại kiểu 🤝) — phần <strong>gốc</strong> tự trừ vào đúng khoản được chọn.
    </div>

    <% [['owe', '🏦 Mình đang nợ ai', 'red'], ['lend', '🤝 Ai đang nợ mình', 'blue']].forEach((group) => { %>
      <% const rows = report.debts.filter((d) => d.direction === group[0]); %>
      <section class="card-lite mb">
        <div class="card-hdr <%= group[2] %>"><span><%= group[1] %></span><span><%= rows.length %> khoản</span></div>
        <div class="p">
          <% rows.forEach((d) => { %>
            <div class="hh-debt">
              <div class="flex between center gap">
                <div>
                  <strong><%= d.name %></strong><%= d.settled ? ' ✅' : '' %><br>
                  <span class="muted">
                    <%= d.counterparty || 'chưa ghi tên' %> · từ <%= dmy(d.startDate) %><%= d.dueDate ? ` · hẹn ${dmy(d.dueDate)}` : '' %><%= d.active ? '' : ' · tạm dừng theo dõi' %>
                  </span>
                </div>
                <div class="text-right">
                  <span class="muted"><%= group[0] === 'owe' ? 'Còn nợ' : 'Còn phải thu' %></span><br>
                  <strong class="<%= d.settled ? 'hh-pos' : 'hh-neg' %> hh-big"><%= money(Math.max(0, d.remaining)) %></strong>
                </div>
              </div>
              <div class="hh-bar mt"><span class="hh-bar-fill <%= group[2] %>" style="width: <%= d.progress %>%"></span></div>
              <div class="muted">
                Ban đầu <%= money(d.initialAmount) %> · đã <%= group[0] === 'owe' ? 'trả' : 'thu' %> gốc <%= money(d.principalPaid) %> (<%= d.progress %>%) · lãi <%= money(d.interestPaid) %>
                <% if (d.principalThisMonth || d.interestThisMonth) { %>
                  <br>Tháng <%= monthLabel(report.month) %>: gốc <%= money(d.principalThisMonth) %> · lãi <%= money(d.interestThisMonth) %>
                <% } %>
                <% if (d.note) { %><br><%= d.note %><% } %>
              </div>
            </div>
          <% }) %>
          <% if (!rows.length) { %><p class="muted text-center">Chưa khai khoản nào.</p><% } %>
        </div>
      </section>
    <% }) %>

    <%# KHAI mới và SỬA khoản cũ tách làm hai phần riêng: khai là việc thỉnh thoảng mới làm
        nhưng cần thấy ngay, còn sửa thì lọt thỏm giữa một đống form nếu để chung. %>
    <section class="card-lite mb">
      <div class="card-hdr green"><span>➕ Khai khoản nợ mới</span><span>Vay mới, hoặc cho ai đó vay</span></div>
      <div class="p">
        <form class="household-form" method="post" action="/household/debts"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <div><label>Chiều</label>
            <select name="direction">
              <option value="owe" selected>🏦 Mình nợ người ta</option>
              <option value="lend">🤝 Người ta nợ mình</option>
            </select>
          </div>
          <div><label>Tên khoản</label><input name="name" placeholder="Vay ngân hàng mua nhà" required></div>
          <div><label>Với ai</label><input name="counterparty" placeholder="Ngân hàng / anh Nam"></div>
          <div><label>Số tiền ban đầu</label><input class="money-input" name="initialAmount"></div>
          <div><label>Từ ngày</label><input type="date" name="startDate" value="<%= today %>"></div>
          <div><label>Hẹn trả</label><input type="date" name="dueDate"></div>
          <div class="household-form-wide"><label>Ghi chú</label><input name="note" placeholder="Không bắt buộc"></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Khai khoản nợ</button></div>
        </form>
        <p class="muted">Khai xong mới ghi tiền trả hàng tháng được — phần trả nằm ở mục 💸 Chi phí (loại kiểu 🏦 Trả nợ).</p>
      </div>
    </section>

    <details class="card-lite hh-manage">
      <summary class="card-hdr warn"><span>⚙️ Sửa khoản nợ đã khai</span><span><%= book.debts.length %> khoản</span></summary>
      <div class="p">
        <% book.debts.forEach((d) => { %>
          <form id="hh-debt-del-<%= d.id %>" method="post" action="/household/debts/<%= d.id %>/delete"
                data-confirm="Xoá khoản <%= d.name %>? Các lần trả đã ghi vẫn còn trong sổ chi tiêu."><input type="hidden" name="book" value="<%= currentBook.id %>"><input type="hidden" name="month" value="<%= report.month %>"></form>
          <form class="household-form household-member-row" method="post" action="/household/debts/<%= d.id %>"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <div><label>Chiều</label>
              <select name="direction">
                <option value="owe" <%= d.direction === 'owe' ? 'selected' : '' %>>🏦 Mình nợ người ta</option>
                <option value="lend" <%= d.direction === 'lend' ? 'selected' : '' %>>🤝 Người ta nợ mình</option>
              </select>
            </div>
            <div><label>Tên khoản</label><input name="name" value="<%= d.name %>" required></div>
            <div><label>Với ai</label><input name="counterparty" value="<%= d.counterparty %>" placeholder="Ngân hàng / anh Nam"></div>
            <div><label>Số tiền ban đầu</label><input class="money-input" name="initialAmount" value="<%= formatMoney(d.initialAmount) %>"></div>
            <div><label>Từ ngày</label><input type="date" name="startDate" value="<%= ymd(d.startDate) %>"></div>
            <div><label>Hẹn trả</label><input type="date" name="dueDate" value="<%= d.dueDate ? ymd(d.dueDate) : '' %>"></div>
            <div><label>Trạng thái</label>
              <select name="active">
                <option value="true" <%= d.active ? 'selected' : '' %>>Đang theo dõi</option>
                <option value="false" <%= d.active ? '' : 'selected' %>>Tạm dừng</option>
              </select>
            </div>
            <div class="household-form-wide"><label>Ghi chú</label><input name="note" value="<%= d.note %>" placeholder="Không bắt buộc"></div>
            <div class="household-form-action">
              <button class="btn btn-success" data-loading-text="Đang lưu...">Lưu</button>
              <button class="btn btn-danger" form="hh-debt-del-<%= d.id %>" data-loading-text="Đang xoá...">Xoá</button>
            </div>
          </form>
        <% }) %>
        <% if (!book.debts.length) { %><p class="muted text-center">Chưa khai khoản nợ nào để mà sửa.</p><% } %>
      </div>
    </details>
  <% } %>

  <!-- ═══ TRỢ LÝ AI ═══ -->
  <% if (section === 'tro-ly') { %>
    <% if (!aiConfigured) { %>
      <div class="alert-lite warn mb">Chưa cấu hình <strong>GROQ_API_KEY</strong> nên trợ lý chưa chạy được. Đặt biến môi trường này rồi khởi động lại app.</div>
    <% } %>

    <section class="card-lite mb">
      <div class="card-hdr blue"><span>⚡ Ghi nhanh bằng câu nói</span><span>Trợ lý đọc hộ, bạn bấm xác nhận</span></div>
      <div class="p">
        <form class="household-form mb" method="post" action="/household/ai/draft"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <div class="household-form-wide"><label>Nói tự nhiên</label><input name="text" placeholder="trưa nay ăn cơm hết 65k" <%= aiConfigured ? '' : 'disabled' %>></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang đọc..." <%= aiConfigured ? '' : 'disabled' %>>Đọc hộ tôi</button></div>
        </form>

        <% if (draft) { %>
          <%# Trợ lý KHÔNG tự ghi vào sổ. Đây chỉ là form điền sẵn, bấm Ghi mới thật sự lưu,
              và nó đi qua đúng đường ghi thường nên vẫn được kiểm quyền đầy đủ. %>
          <div class="alert-lite mb">Trợ lý đọc ra khoản dưới đây. Sửa lại nếu chưa đúng rồi bấm <strong>Ghi vào sổ</strong>.</div>
          <form class="household-form hh-draft" method="post" action="<%= draft.type === 'income' ? '/household/income' : '/household/expenses' %>"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <div><label>Ngày</label><input type="date" name="occurredAt" value="<%= draft.occurredAt %>" required></div>
            <div><label><%= draft.type === 'income' ? 'Loại thu nhập' : 'Loại chi phí' %></label>
              <select name="categoryId">
                <% (draft.type === 'income' ? liveIncomeCats : liveExpenseCats).forEach((c) => { %>
                  <option value="<%= c.id %>" <%= String(c.id) === draft.categoryId ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div><label>Số tiền</label><input class="money-input" name="amount" value="<%= formatMoney(draft.amount) %>"></div>
            <div class="household-form-wide"><label>Ghi chú</label><input name="note" value="<%= draft.note %>"></div>
            <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang ghi...">Ghi vào sổ</button></div>
          </form>
          <p class="muted">Loại kiểu 🏦 Trả nợ phải khai ở mục <strong>💸 Chi phí</strong> để còn chọn khoản nợ và tách gốc/lãi.</p>
        <% } %>
      </div>
    </section>

    <section class="card-lite mb">
      <div class="card-hdr green"><span>🤖 Hỏi trợ lý về sổ của bạn</span><span>Tháng <%= monthLabel(report.month) %></span></div>
      <div class="p">
        <div class="hh-chat">
          <% chat.forEach((m) => { %>
            <div class="hh-msg <%= m.role === 'user' ? 'me' : 'bot' %>">
              <% if (m.role === 'user' && m.askedBy) { %><span class="hh-msg-who"><%= m.askedBy %></span><% } %>
              <p><%= m.content %></p>
            </div>
          <% }) %>
          <% if (!chat.length) { %>
            <div class="hh-msg bot"><p>Chào bạn 👋 Mình xem được toàn bộ sổ này. Thử hỏi: “tháng này nhà mình tiêu nhiều nhất vào khoản gì?”, “còn bao nhiêu tiền tiết kiệm?”, “bao giờ trả hết nợ ngân hàng?”</p></div>
          <% } %>
        </div>
        <form class="household-form mt" method="post" action="/household/ai/ask"><input type="hidden" name="book" value="<%= currentBook.id %>">
          <input type="hidden" name="month" value="<%= report.month %>">
          <div class="household-form-wide"><label>Câu hỏi</label><input name="question" placeholder="Tháng này mình tiêu nhiều nhất vào khoản gì?" <%= aiConfigured ? '' : 'disabled' %>></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang hỏi..." <%= aiConfigured ? '' : 'disabled' %>>Hỏi</button></div>
        </form>
        <% if (chat.length) { %>
          <form class="mt" method="post" action="/household/ai/clear" data-confirm="Xoá toàn bộ lịch sử trò chuyện?"><input type="hidden" name="book" value="<%= currentBook.id %>">
            <input type="hidden" name="month" value="<%= report.month %>">
            <button class="btn btn-sm btn-danger" data-loading-text="Đang xoá...">Xoá lịch sử trò chuyện</button>
          </form>
        <% } %>
        <p class="muted">Trợ lý chỉ đọc số liệu của sổ này và <strong>không bao giờ tự ghi</strong> khoản nào vào sổ.</p>
      </div>
    </section>
  <% } %>

  <!-- ═══ CÀI ĐẶT ═══ -->
  <% if (section === 'cai-dat') { %>
    <%# Chỉ hiện khi admin này vào được nhiều hơn một sổ — một sổ thì thanh chọn chỉ gây rối. %>
    <% if (books.length > 1) { %>
      <section class="card-lite p mb">
        <form method="get" action="/household/cai-dat" class="month-filter">
          <label>Sổ chi tiêu</label>
          <select name="book" data-autosubmit>
            <% books.forEach((b) => { %>
              <option value="<%= b.id %>" <%= b.id === currentBook.id ? 'selected' : '' %>>
                <%= b.name %><%= b.ownerAdminId?.toString() === currentUser.id ? ' (của tôi)' : ` — ${b.ownerAdmin?.displayName || 'admin khác'}` %>
              </option>
            <% }) %>
          </select>
        </form>
      </section>
    <% } %>

    <section class="card-lite p tournament-edit-card mb">
      <div class="section-heading mb"><div><span class="feature-icon">⚙️</span><h2 class="section-title">Cài đặt chung</h2><p class="muted">Tên sổ và mốc bắt đầu ghi sổ.</p></div></div>
      <form class="household-form" method="post" action="/household/config"><input type="hidden" name="book" value="<%= currentBook.id %>">
        <div><label>Tên sổ</label><input name="name" value="<%= currentBook.name %>" maxlength="120"></div>
        <div><label>Bắt đầu ghi sổ từ</label><input type="date" name="anchorDate" value="<%= ymd(config.anchorDate) %>"></div>
        <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang lưu...">Lưu cài đặt</button></div>
      </form>
      <p class="muted">Số <strong>tiết kiệm đang có</strong> và <strong>còn lại luỹ kế</strong> được cộng từ mọi khoản đã khai, nên sửa số của tháng cũ là các tháng sau tự đúng theo — không cần chốt sổ.</p>
    </section>

    <section class="card-lite p tournament-edit-card mb">
      <div class="section-heading mb"><div><span class="feature-icon">📋</span><h2 class="section-title">Danh mục mẫu</h2><p class="muted">Vài loại thu nhập và loại chi phí thường gặp để bắt đầu cho nhanh.</p></div></div>
      <form method="post" action="/household/seed"><input type="hidden" name="book" value="<%= currentBook.id %>">
        <input type="hidden" name="month" value="<%= report.month %>">
        <input type="hidden" name="section" value="cai-dat">
        <button class="btn btn-success" data-loading-text="Đang nạp...">Nạp danh mục mẫu</button>
      </form>
      <p class="muted">Chỉ nạp phần nào đang trống nên bấm nhiều lần cũng không sinh dòng trùng. Không nạp sẵn số tiền nào.</p>
    </section>

    <%# Phân quyền: chỉ CHỦ SỔ thấy phần này. Người được mời vẫn xem/sửa được sổ
        nhưng không mời tiếp được người khác — giống hồ sơ y tế. %>
    <section class="card-lite p tournament-edit-card mt">
      <div class="section-heading mb"><div><span class="feature-icon">🔐</span><h2 class="section-title">Phân quyền admin</h2><p class="muted">Cho admin khác cùng xem và ghi sổ chi tiêu này.</p></div></div>
      <div class="grid module-grid mb">
        <div><span class="muted">Người tạo sổ</span><br><strong><%= currentBook.ownerAdmin?.displayName || currentBook.ownerAdmin?.username || 'Admin gốc / dữ liệu cũ' %></strong></div>
        <div><span class="muted">Đang được phân quyền</span><br><strong><%= (currentBook.permissions || []).length %> admin</strong></div>
      </div>
      <% if (isOwner) { %>
        <% if (admins && admins.length) { %>
          <form class="permission-create-form mb" method="post" action="/household/permissions">
            <input type="hidden" name="book" value="<%= currentBook.id %>">
            <div><label>Thêm admin</label><select name="adminId" required><% admins.forEach((admin) => { %><option value="<%= admin.id %>"><%= admin.displayName %> (<%= admin.username %>)</option><% }) %></select></div>
            <div class="permission-create-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm quyền</button></div>
          </form>
        <% } else { %>
          <div class="alert-lite info mb">Không còn admin nào để thêm.</div>
        <% } %>
        <div class="permission-admin-list">
          <% (currentBook.permissions || []).forEach((permission) => { %>
            <div class="permission-admin-card">
              <div class="flex between center gap">
                <div><strong><%= permission.admin.displayName %></strong><br><span class="muted"><%= permission.admin.username %></span></div>
                <form method="post" action="/household/permissions/<%= permission.id %>/delete" data-confirm="Gỡ quyền admin này?">
                  <input type="hidden" name="book" value="<%= currentBook.id %>">
                  <button class="btn btn-sm btn-danger" data-loading-text="Đang gỡ...">Gỡ quyền</button>
                </form>
              </div>
            </div>
          <% }) %>
          <% if (!(currentBook.permissions || []).length) { %><div class="alert-lite info">Chưa cấp quyền cho admin nào.</div><% } %>
        </div>
      <% } else { %>
        <div class="alert-lite info">Bạn được chủ sổ mời vào sổ này. Chỉ người tạo sổ mới cấp hoặc gỡ quyền được.</div>
      <% } %>
    </section>
  <% } %>
</main>
<%- include('../partials/bottom-menu') %>
