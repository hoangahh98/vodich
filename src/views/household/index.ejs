<%- include('../partials/head', { title: 'Quản lý chi tiêu' }) %>
<%- include('../partials/topbar') %>
<%
  // Luôn quy về giờ Việt Nam: server chạy UTC nên toISOString sẽ hiển thị lệch ngày.
  const ymd = (d) => new Date(d).toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });
  const dmy = (d) => ymd(d).split('-').reverse().join('/');
  const monthLabel = (m) => `${Number(m.slice(5, 7))}/${m.slice(0, 4)}`;
  const kindLabel = { savings: '🐷 Tiết kiệm', debt: '🏦 Trả nợ', other: '📌 Khác' };
  const today = ymd(new Date());
%>
<main class="app-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <h1>💰 Quản lý chi tiêu</h1>
        <div class="muted strong-muted">Lương gộp vào quỹ chung → trích tiết kiệm &amp; trả nợ → mỗi đầu tuần nạp ví cho từng người.</div>
      </div>
      <% if (section === 'thu-nhap') { %>
        <%# Bọc trong div: ở màn hẹp .feature-hero .flex đổi sang cột, `flex: 0 0 170px`
            của .month-filter sẽ thành CHIỀU CAO 170px và form bị kéo vuông. %>
        <div class="household-hero-tools">
          <form method="get" action="/household/thu-nhap" class="month-filter">
            <label>Tháng</label>
            <input type="month" name="month" value="<%= book.month %>" data-autosubmit>
          </form>
        </div>
      <% } %>
    </div>
  </section>

  <% if (msg) { %><div class="alert alert-success mb"><%= msg %></div><% } %>
  <% if (err) { %><div class="alert alert-danger mb"><%= err %></div><% } %>

  <% if (!members.length) { %>
    <div class="alert-lite warn mb">Chưa có thành viên nào. Vào <a href="/household/cai-dat">⚙️ Cài đặt</a> thêm người nhận tiền tiêu (chồng, vợ, con...).</div>
  <% } %>

  <!-- ═══ TỔNG QUAN ═══ -->
  <% if (section === 'tong-quan') { %>
    <section class="grid finance-grid mb">
      <details class="metric-card <%= summary.potBalance < 0 ? 'red' : 'green' %> metric-drop">
        <summary>
          <span>🏦 Quỹ chung còn lại</span><strong><%= formatMoney(summary.potBalance) %>đ</strong>
          <small>Bấm để xem dòng tiền chi tiết</small>
        </summary>
        <div class="metric-drop-body">
          <div><span>Tổng thu đã gộp</span><strong>+<%= formatMoney(summary.totalIncome) %>đ</strong></div>
          <div><span>Trích tiết kiệm</span><strong>−<%= formatMoney(summary.savingsTotal) %>đ</strong></div>
          <div><span>Trích trả nợ</span><strong>−<%= formatMoney(summary.debtTotal) %>đ</strong></div>
          <div><span>Trích khoản khác</span><strong>−<%= formatMoney(summary.otherAllocationTotal) %>đ</strong></div>
          <div><span>Tiền tiêu đã trích</span><strong>−<%= formatMoney(summary.allowanceBudget) %>đ</strong></div>
          <div><span>Chi chung của nhà</span><strong>−<%= formatMoney(summary.commonSpent) %>đ</strong></div>
          <% if (summary.overspendTotal > 0) { %>
            <div><span>Nhà bù khi tiêu quá ví</span><strong>−<%= formatMoney(summary.overspendTotal) %>đ</strong></div>
          <% } %>
          <p class="metric-drop-note">Tiền tiêu đã trích không còn trong quỹ chung — nó nằm ở ví từng người.</p>
        </div>
      </details>
      <div class="metric-card orange">
        <span>👛 Tiền tiêu mỗi tuần</span><strong><%= formatMoney(summary.weeklyPayout) %>đ</strong>
        <small><%= summary.wallets.filter((w) => w.active).length %> người · mặc định <%= formatMoney(summary.defaultWeeklyAllowance) %>đ/người</small>
      </div>
      <div class="metric-card blue">
        <span>🐷 Tiết kiệm lũy kế</span><strong><%= formatMoney(summary.savingsTotal) %>đ</strong>
        <small>Đã trả nợ <%= formatMoney(summary.debtTotal) %>đ · khoản khác <%= formatMoney(summary.otherAllocationTotal) %>đ</small>
      </div>
      <% if (summary.kidSavingsTotal > 0) { %>
        <div class="metric-card gold">
          <span>🧸 Quỹ tiết kiệm của con</span><strong><%= formatMoney(summary.kidSavingsTotal) %>đ</strong>
          <small>Phần con chưa cầm tay · con tiêu quá thì quỹ này vơi đi</small>
        </div>
      <% } %>
    </section>

    <section class="card-lite mb">
      <div class="card-hdr blue"><span>👛 Ví từng người</span><span>Tuần này chi <%= formatMoney(summary.spentThisWeek) %>đ</span></div>
      <div class="p">
        <div class="table-wrap"><table>
          <thead><tr><th>Người</th><th>Đã tiêu</th><th class="text-right">Còn lại</th></tr></thead>
          <tbody>
            <% summary.wallets.forEach((w) => { %>
              <tr>
                <td>
                  <strong><%= w.name %></strong><br>
                  <span class="muted"><%= formatMoney(w.allowance) %>đ/<%= w.rollover ? 'tháng' : 'tuần' %><%= w.active ? '' : ' · tạm dừng' %></span>
                </td>
                <td>
                  <strong><%= formatMoney(w.rollover ? w.spentTotal : w.spentThisPeriod) %>đ</strong><br>
                  <span class="muted"><%= w.rollover ? `tháng này ${formatMoney(w.spentThisPeriod)}đ` : 'tuần này' %></span>
                </td>
                <td class="text-right">
                  <strong style="color:<%= w.remaining < 0 ? '#dc3545' : '#198754' %>"><%= formatMoney(w.remaining) %>đ</strong>
                  <% if (w.rollover && w.kidSavings > 0) { %><br><span class="muted">🧸 <%= formatMoney(w.kidSavings) %>đ</span><% } %>
                  <% if (w.kidShortfall > 0) { %><br><span class="muted" style="color:#dc3545">lẹm <%= formatMoney(w.kidShortfall) %>đ</span><% } %>
                  <% if (w.overspend > 0) { %><br><span class="muted" style="color:#dc3545">nhà bù <%= formatMoney(w.overspend) %>đ</span><% } %>
                </td>
              </tr>
            <% }) %>
            <% if (!summary.wallets.length) { %><tr><td colspan="3" class="muted text-center">Chưa có thành viên nào.</td></tr><% } %>
          </tbody>
        </table></div>
        <p class="muted">
          <strong>Hàng tuần</strong>: sang tuần mới nạp lại đủ mức, số dư tuần cũ bị xoá.
          <strong>Hàng tháng</strong> (con): tiêu không hết thì dồn sang tháng sau; tiêu quá thì trừ vào 🧸 quỹ tiết kiệm của con.
        </p>
      </div>
    </section>
  <% } %>

  <!-- ═══ THU & PHÂN BỔ ═══ -->
  <% if (section === 'thu-nhap') { %>
    <section class="grid finance-grid mb">
      <div class="metric-card green">
        <span>💵 Tổng thu tháng <%= monthLabel(book.month) %></span><strong><%= formatMoney(book.incomeTotal) %>đ</strong>
        <small><%= book.incomes.length %> khoản thu</small>
      </div>
      <details class="metric-card blue metric-drop">
        <summary>
          <span>✂️ Đã trích ra</span><strong><%= formatMoney(book.allocationTotal) %>đ</strong>
          <small>Bấm để xem chi tiết</small>
        </summary>
        <div class="metric-drop-body">
          <div><span>Trích tay (<%= book.allocations.length %> khoản)</span><strong><%= formatMoney(book.manualAllocationTotal) %>đ</strong></div>
          <div><span>Tiền tiêu cả nhà (tự trích)</span><strong><%= formatMoney(book.allowanceCost) %>đ</strong></div>
          <p class="metric-drop-note"><%= book.weeksInMonth %> tuần trong tháng, tính theo mức tuần của từng thành viên — không phải nhập tay.</p>
        </div>
      </details>
      <div class="metric-card <%= book.leftover < 0 ? 'red' : 'orange' %>">
        <span>💰 Còn lại trong quỹ</span><strong><%= formatMoney(book.leftover) %>đ</strong>
        <small>= Thu <%= formatMoney(book.incomeTotal) %>đ − Đã trích <%= formatMoney(book.allocationTotal) %>đ</small>
      </div>
    </section>

    <section class="card-lite mb">
      <div class="card-hdr green"><span>💵 Lương &amp; các khoản thu</span><span><%= formatMoney(book.incomeTotal) %>đ</span></div>
      <div class="p">
        <form class="household-form mb" method="post" action="/household/income">
          <input type="hidden" name="month" value="<%= book.month %>">
          <div><label>Nguồn thu</label><input name="source" placeholder="Lương chồng / Lương vợ / Thưởng" required></div>
          <div><label>Số tiền</label><input class="money-input" name="amount" required></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm</button></div>
        </form>
        <div class="table-wrap"><table>
          <thead><tr><th>Nguồn thu</th><th>Số tiền</th><th></th></tr></thead>
          <tbody>
            <% book.incomes.forEach((i) => { %>
              <tr>
                <td><strong><%= i.source %></strong><% if (i.note) { %><br><span class="muted"><%= i.note %></span><% } %></td>
                <td><strong>+<%= formatMoney(i.amount) %>đ</strong></td>
                <td class="text-right"><form method="post" action="/household/income/<%= i.id %>/delete" data-confirm="Xoá khoản thu này?"><button class="btn btn-sm btn-danger" data-loading-text="Đang xoá...">Xoá</button></form></td>
              </tr>
            <% }) %>
            <% if (!book.incomes.length) { %><tr><td colspan="3" class="muted text-center">Chưa nhập khoản thu nào cho tháng <%= monthLabel(book.month) %>.</td></tr><% } %>
          </tbody>
        </table></div>
      </div>
    </section>

    <section class="card-lite">
      <div class="card-hdr warn"><span>✂️ Các khoản trích ra</span><span><%= formatMoney(book.allocationTotal) %>đ</span></div>
      <div class="p">
        <div class="alert-lite mb">
          🤖 <strong>Tiền tiêu cả nhà tháng <%= monthLabel(book.month) %>: <%= formatMoney(book.allowanceCost) %>đ</strong>
          — tự trích, <%= book.weeksInMonth %> tuần × mức tuần của từng người.
        </div>
        <form class="household-form mb" method="post" action="/household/allocations">
          <input type="hidden" name="month" value="<%= book.month %>">
          <div><label>Loại</label>
            <select name="kind">
              <option value="savings">🐷 Tiết kiệm</option>
              <option value="debt">🏦 Trả nợ</option>
              <option value="other" selected>📌 Khác</option>
            </select>
          </div>
          <div><label>Tên khoản</label><input name="name" placeholder="Tiết kiệm / Trả nợ nhà / Học phí" required></div>
          <div><label>Số tiền</label><input class="money-input" name="amount" required></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm</button></div>
        </form>
        <div class="table-wrap"><table>
          <thead><tr><th>Loại</th><th>Tên khoản</th><th>Số tiền</th><th></th></tr></thead>
          <tbody>
            <% book.allocations.forEach((a) => { %>
              <tr>
                <td><%= kindLabel[a.kind] || kindLabel.other %></td>
                <td><strong><%= a.name %></strong><% if (a.note) { %><br><span class="muted"><%= a.note %></span><% } %></td>
                <td><strong>−<%= formatMoney(a.amount) %>đ</strong></td>
                <td class="text-right"><form method="post" action="/household/allocations/<%= a.id %>/delete" data-confirm="Xoá khoản trích này?"><button class="btn btn-sm btn-danger" data-loading-text="Đang xoá...">Xoá</button></form></td>
              </tr>
            <% }) %>
            <% if (!book.allocations.length) { %><tr><td colspan="4" class="muted text-center">Chưa có khoản trích tay nào cho tháng <%= monthLabel(book.month) %>.</td></tr><% } %>
          </tbody>
        </table></div>
        <form method="post" action="/household/allocations/copy">
          <input type="hidden" name="month" value="<%= book.month %>">
          <button class="btn btn-sm" data-loading-text="Đang chép...">📋 Chép các khoản của tháng trước</button>
        </form>
      </div>
    </section>
  <% } %>

  <!-- ═══ CHI TIÊU ═══ -->
  <% if (section === 'chi-tieu') { %>
    <section class="card-lite mb">
      <div class="card-hdr blue"><span>🧾 Các khoản đã chi</span><span>Tháng này <%= formatMoney(summary.spentThisMonth) %>đ</span></div>
      <div class="p">
        <form class="household-form mb" method="post" action="/household/txns">
          <div><label>Ngày chi</label><input type="date" name="occurredAt" value="<%= today %>" required></div>
          <div><label>Nội dung</label><input name="description" placeholder="Cà phê, đi chợ, tiền điện..."></div>
          <div><label>Của ai</label>
            <select name="memberId">
              <option value="">🏠 Chi chung</option>
              <% members.forEach((m) => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
            </select>
          </div>
          <div><label>Số tiền</label><input class="money-input" name="amount" required></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang lưu...">Thêm</button></div>
        </form>
        <div class="table-wrap"><table>
          <thead><tr><th>Ngày</th><th>Nội dung</th><th>Của ai</th><th>Tiền</th><th></th></tr></thead>
          <tbody>
            <% txns.forEach((t) => { %>
              <tr>
                <td><%= dmy(t.occurredAt) %></td>
                <td><strong><%= t.description || '(không ghi)' %></strong></td>
                <td><%= t.member ? t.member.name : '🏠 Chi chung' %></td>
                <td><strong><%= formatMoney(t.amount) %>đ</strong></td>
                <td class="text-right"><form method="post" action="/household/txns/<%= t.id %>/delete" data-confirm="Xoá khoản chi này?"><button class="btn btn-sm btn-danger" data-loading-text="Đang xoá...">Xoá</button></form></td>
              </tr>
            <% }) %>
            <% if (!txns.length) { %><tr><td colspan="5" class="muted text-center">Chưa ghi khoản chi nào.</td></tr><% } %>
          </tbody>
        </table></div>
      </div>
    </section>
  <% } %>

  <!-- ═══ CÀI ĐẶT ═══ -->
  <% if (section === 'cai-dat') { %>
    <section class="card-lite p tournament-edit-card mb">
      <div class="section-heading mb"><div><span class="feature-icon">⚙️</span><h2 class="section-title">Cài đặt chung</h2><p class="muted">Mức tiền tiêu mặc định và mốc bắt đầu theo dõi.</p></div></div>
      <form class="household-form" method="post" action="/household/config">
        <div><label>Tiền tiêu mỗi tuần / người</label><input class="money-input" name="weeklyAllowance" value="<%= formatMoney(config.weeklyAllowance) %>"></div>
        <div><label>Tuần bắt đầu từ</label>
          <select name="weekStartDow">
            <% const dows = [['1','Thứ Hai'],['2','Thứ Ba'],['3','Thứ Tư'],['4','Thứ Năm'],['5','Thứ Sáu'],['6','Thứ Bảy'],['0','Chủ Nhật']]; %>
            <% dows.forEach((d) => { %><option value="<%= d[0] %>" <%= config.weekStartDow === Number(d[0]) ? 'selected' : '' %>><%= d[1] %></option><% }) %>
          </select>
        </div>
        <div><label>Ngày bắt đầu theo dõi</label><input type="date" name="anchorDate" value="<%= ymd(config.anchorDate) %>"></div>
        <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang lưu...">Lưu cài đặt</button></div>
      </form>
      <p class="muted">Mức mặc định áp dụng cho mọi người không đặt mức riêng. Ngày bắt đầu theo dõi quyết định số tuần đã trích tiền tiêu.</p>
    </section>

    <section class="card-lite">
      <div class="card-hdr green"><span>👨‍👩‍👦 Thành viên nhận tiền tiêu</span><span><%= members.length %> người</span></div>
      <div class="p">
        <div class="alert-lite mb">
          <strong>Hàng tuần</strong> (vợ chồng): nhận đủ mức mỗi đầu tuần, số dư tuần cũ bị xoá.<br>
          <strong>Hàng tháng</strong> (con): cầm mức đó cho cả tháng, tiêu không hết thì dồn sang tháng sau. Nhà vẫn dành
          <%= formatMoney(config.weeklyAllowance) %>đ/tuần cho con — phần chênh vào 🧸 quỹ tiết kiệm của con, con tiêu quá thì quỹ đó vơi đi.
        </div>

        <% members.forEach((m) => { %>
          <%# Form xoá để rỗng, nút Xoá nằm trong form sửa và trỏ sang bằng thuộc tính `form`
              (HTML không cho lồng form) — nhờ vậy Lưu và Xoá đứng cạnh nhau trên cùng một hàng. %>
          <form id="hh-del-<%= m.id %>" method="post" action="/household/members/<%= m.id %>/delete"
                data-confirm="Xoá <%= m.name %>? Các khoản chi cũ của người này sẽ chuyển thành chi chung."></form>
          <form class="household-form household-member-row" method="post" action="/household/members/<%= m.id %>">
            <div><label>Tên</label><input name="name" value="<%= m.name %>" required></div>
            <div><label>Chu kỳ nhận</label>
              <select name="cycle">
                <option value="weekly" <%= m.cycle === 'monthly' ? '' : 'selected' %>>Hàng tuần</option>
                <option value="monthly" <%= m.cycle === 'monthly' ? 'selected' : '' %>>Hàng tháng (con)</option>
              </select>
            </div>
            <div><label>Mức riêng</label><input class="money-input" name="allowance" value="<%= m.allowance === null ? '' : formatMoney(m.allowance) %>" placeholder="<%= formatMoney(config.weeklyAllowance) %>"></div>
            <div><label>Nhận từ ngày</label><input type="date" name="startedOn" value="<%= ymd(m.startedOn) %>"></div>
            <div><label>Trạng thái</label>
              <select name="active">
                <option value="true" <%= m.active ? 'selected' : '' %>>Đang nhận</option>
                <option value="false" <%= m.active ? '' : 'selected' %>>Tạm dừng</option>
              </select>
            </div>
            <div class="household-form-action">
              <button class="btn btn-success" data-loading-text="Đang lưu...">Lưu</button>
              <button class="btn btn-danger" form="hh-del-<%= m.id %>" data-loading-text="Đang xoá...">Xoá</button>
            </div>
          </form>
        <% }) %>

        <h2 class="section-title mb">➕ Thêm thành viên</h2>
        <form class="household-form" method="post" action="/household/members">
          <div><label>Tên</label><input name="name" placeholder="Chồng / Vợ / Con zai" required></div>
          <div><label>Chu kỳ nhận</label>
            <select name="cycle">
              <option value="weekly" selected>Hàng tuần</option>
              <option value="monthly">Hàng tháng (con)</option>
            </select>
          </div>
          <div><label>Mức riêng</label><input class="money-input" name="allowance" placeholder="<%= formatMoney(config.weeklyAllowance) %>"></div>
          <div><label>Nhận từ ngày</label><input type="date" name="startedOn" value="<%= ymd(config.anchorDate) %>"></div>
          <div class="household-form-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm</button></div>
        </form>
      </div>
    </section>
  <% } %>
</main>
<%- include('../partials/bottom-menu') %>
