<% if (section === 'sources') { %>
  <%
    // Ô nào hiện tuỳ loại nguồn (household.js đọc data-for): tài khoản → ngân hàng, số TK, chủ, số dư;
    // tiết kiệm / đầu tư / tiền mặt → chủ + số dư; khoản vay → lãi suất + nợ hiện tại; thẻ tín dụng →
    // KHÔNG có ô hạn mức lẫn ô nợ (chủ app 10/9/2026: thẻ thông dùng chung hạn mức nên khai kiểu gì cũng
    // sai) — dư nợ cộng từ giao dịch, hạn mức khả dụng lấy theo mail gần nhất.
    // Ngày sao kê / đến hạn đã bỏ khỏi form theo ý chủ app (cột vẫn còn trong DB, không dùng).
    // Ô số dư / nợ nhập số HIỆN TẠI (chủ app: khỏi nhập số dư đầu rồi so lệch). Server tự suy số đầu kỳ
    // = số hiện tại trừ/cộng dòng tiền đã ghi. `current` là số app đang tính cho nguồn đó (form sửa).
    const kindOptions = Object.keys(labels.source);
    const esc = (value) => String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    // Thẻ thông = hai thẻ dùng chung một hạn mức (quẹt thẻ này là hạn mức thẻ kia cũng giảm). Khai bằng
    // cách chọn thẻ kia; server cho cả hai cùng mã nhóm. Không phải khai hạn mức, chỉ khai "chung với ai".
    const cardList = sources.filter((item) => item.kind === 'CARD');
    const twinOf = (source) => (source && source.limitGroup ? cardList.find((item) => item.limitGroup === source.limitGroup && item.id.toString() !== source.id.toString()) : null);
    const sourceForm = (source, current) => `
      <div><label>Tên nguồn</label><input name="name" value="${source ? source.name.replace(/"/g, '&quot;') : ''}" placeholder="Ví dụ: Timo, Thẻ MSB" required></div>
      <div><label>Loại</label><select name="kind" data-source-kind>${kindOptions.map((kind) => `<option value="${kind}" ${source && source.kind === kind ? 'selected' : ''}>${labels.source[kind]}</option>`).join('')}</select></div>
      <div data-for="BANK CARD"><label>Ngân hàng</label><select name="bank">${['TIMO','MSB','OTHER'].map((bank) => `<option value="${bank}" ${(source ? source.bank : 'TIMO') === bank ? 'selected' : ''}>${labels.bank[bank]}</option>`).join('')}</select></div>
      <div data-for="BANK"><label>Số tài khoản</label><input name="matchKey" value="${source ? source.matchKey : ''}" placeholder="Chỉ cần khi có nhiều tài khoản cùng ngân hàng" inputmode="numeric" data-match-key></div>
      <div data-for="CARD"><label>4 số cuối thẻ</label><input value="${source ? source.matchKey : ''}" placeholder="3065" inputmode="numeric" maxlength="4" data-match-key></div>
      <div data-for="BANK CARD CASH SAVING INVEST LOAN"><label>Chủ nguồn</label><input name="ownerName" value="${source ? source.ownerName.replace(/"/g, '&quot;') : ''}" placeholder="Chồng / Vợ"></div>
      <div data-for="BANK CASH SAVING INVEST" data-balance-box><label>Số dư</label><input class="money-input" name="currentBalance" value="${source ? formatMoney(current) : ''}" inputmode="numeric" data-opening></div>
      <div data-for="BANK" data-timo-note hidden><label>Số dư</label><div class="field-static">Tự lấy từ mail Timo gần nhất${source ? ': ' + formatMoney(current) + 'đ' : ''}</div></div>
      <div data-for="CARD"><label>Thẻ thông (chung hạn mức)</label><select name="limitGroupWith"><option value="">— Thẻ riêng —</option>${cardList
        .filter((item) => !source || item.id.toString() !== source.id.toString())
        .map((item) => `<option value="${item.id}" ${twinOf(source) && twinOf(source).id === item.id ? 'selected' : ''}>${esc(item.name)}</option>`)
        .join('')}</select><small class="field-hint">Chọn thẻ kia nếu quẹt thẻ này thì hạn mức thẻ kia cũng giảm — khỏi bị báo lệch. Hai thẻ khác hạn mức nhau vẫn chọn được.</small></div>
      <div data-for="CARD" class="hh-form-wide"><label>Hạn mức và dư nợ</label><div class="field-static">Hạn mức còn lấy theo mail ngân hàng gần nhất; phần đã quẹt chưa trả cộng từ giao dịch${source ? ' — đang là ' + formatMoney(current) + 'đ' : ''}</div></div>
      <div data-for="LOAN"><label>Nợ hiện tại</label><input class="money-input" value="${source ? formatMoney(current) : ''}" inputmode="numeric" data-opening></div>
      <div data-for="LENT"><label>Đã cho vay</label><input class="money-input" value="${source ? formatMoney(current) : ''}" inputmode="numeric" data-opening></div>
      <div data-for="LOAN"><label>Lãi suất %/năm</label><input name="interestRate" value="${source ? Number(source.interestRate) : ''}" placeholder="Ví dụ: 10.5" inputmode="decimal"></div>`;
  %>
  <section class="card-lite p mb">
    <div class="section-heading">
      <div><span class="feature-icon"><%- include('../../partials/icon', { name: 'card' }) %></span><h2 class="section-title">Nguồn tiền</h2><p class="muted">Tài khoản, thẻ tín dụng, tiết kiệm, đầu tư, khoản vay, tiền mặt. Nhập số dư đang có, sau đó mọi thay đổi tự cộng từ giao dịch; thẻ tín dụng thì dư nợ cộng từ giao dịch và hạn mức khả dụng lấy theo mail ngân hàng.</p></div>
      <span class="badge badge-dark">Có <%= formatMoney(totals.cash) %>đ<% if (totals.saved) { %> · để dành <%= formatMoney(totals.saved) %>đ<% } %> · nợ <%= formatMoney(totals.debt) %>đ</span>
    </div>
  </section>

  <% if (isAdmin) { %>
    <section class="card-lite p mb">
      <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'plus' }) %> Thêm nguồn</h2>
      <form class="hh-form" method="post" action="/household/<%= household.id %>/sources" data-source-form>
        <%- sourceForm(null, 0) %>
        <div class="hh-form-action"><button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Thêm nguồn</button></div>
      </form>
      <p class="muted mt">Thẻ tín dụng: quẹt thẻ là chi tiêu ngay lúc quẹt; trả thẻ ghi là <strong>Chuyển nguồn</strong> từ tài khoản sang thẻ, không tính chi lần hai. Khoản vay: trả nợ ghi Chuyển nguồn sang khoản vay, chọn trả gốc hay trả lãi. Cho vay: tạo một nguồn loại <strong>Cho vay</strong> mang tên người vay; chuyển tiền sang là cho vay thêm, họ trả thì chuyển ngược về tài khoản (trên Telegram có nút sẵn).</p>
    </section>
  <% } %>

  <div class="hh-source-list">
    <% balances.forEach((item) => { const source = sources.find((row) => row.id.toString() === item.source.id); const debt = ['CARD', 'LOAN'].includes(item.source.kind); const lent = item.source.kind === 'LENT'; %>
      <section class="card-lite p hh-source <%= item.source.active ? '' : 'is-muted' %>">
        <div class="hh-source-head">
          <div><h3 class="mb-0"><%= item.source.name %></h3><span class="badge"><%= labels.source[item.source.kind] %></span> <% if (['BANK', 'CARD'].includes(item.source.kind) && source.bank !== 'OTHER') { %><span class="badge"><%= labels.bank[source.bank] %><%= source.matchKey ? ' · ' + source.matchKey : '' %></span><% } %><% const twin = twinOf(source); %><% if (twin) { %><span class="badge">thẻ thông với <%= twin.name %></span><% } %><% if (!item.source.active) { %><span class="badge">đã ẩn</span><% } %></div>
        </div>
        <%# Mọi con số nằm trong ô (chủ app: "mấy cái đang không trong ô thì cho vào ô"). %>
        <div class="grid kv-grid mt">
          <%# Thẻ tín dụng: ô đầu là HẠN MỨC CÒN ngân hàng báo (số thật, mail nào cũng có). Con số cộng từ sổ
              chỉ là "đã quẹt chưa trả" — không có hạn mức tổng thì nó không phải dư nợ thật của thẻ. %>
          <% if (item.source.kind === 'CARD') { %>
            <div class="kv"><span>Hạn mức còn</span><strong><% if (item.reportedAvailable) { %><%= formatMoney(item.reportedAvailable.value) %>đ<br><small class="muted"><%= fmtDateTime(item.reportedAvailable.at) %></small><% } else { %>—<br><small class="muted">chờ mail ngân hàng</small><% } %></strong></div>
            <%# Số này chỉ đếm những gì SỔ ghi được: quẹt cộng vào, thanh toán / hoàn tiền trừ đi. Trả nhiều
                hơn phần sổ ghi được thì ĐỔI TÊN ô thành "Đã trả dư" và để số DƯƠNG — chủ app 10/9/2026:
                đừng bao giờ hiện số âm ở đây, nhìn dễ hiểu nhầm là thẻ đang nợ. %>
            <div class="kv"><span><%= item.balance < 0 ? 'Đã trả dư' : 'Đã quẹt chưa trả' %></span><strong class="<%= item.balance > 0 ? 'text-danger' : '' %>"><%= formatMoney(Math.abs(item.balance)) %>đ</strong><% if (item.balance < 0) { %><small class="muted">thanh toán nhiều hơn phần sổ ghi được — khoản quẹt từ trước khi dùng app không có trong sổ</small><% } %></div>
          <% } else { %>
            <div class="kv"><span><%= debt ? 'Nợ hiện tại' : lent ? 'Đã cho vay' : 'Số dư' %></span><strong class="<%= debt && item.balance > 0 ? 'text-danger' : '' %>"><%= formatMoney(item.balance) %>đ</strong></div>
          <% } %>
          <% if (source.ownerName) { %><div class="kv"><span>Chủ nguồn</span><strong><%= source.ownerName %></strong></div><% } %>
          <% if (Number(source.interestRate)) { %><div class="kv"><span>Lãi suất</span><strong><%= Number(source.interestRate) %>%/năm</strong></div><% } %>
          <% if (item.reported) { %><div class="kv"><span>Ngân hàng báo</span><strong><%= formatMoney(item.reported.value) %>đ<br><small class="muted"><%= fmtDateTime(item.reported.at) %></small></strong></div><% } %>
        </div>
        <%# Sổ lệch số ngân hàng = thiếu giao dịch. App KHÔNG tự bù (chủ app 10/9/2026) — nhắc để thêm tay. %>
        <% if (item.diff) { %>
          <div class="alert-lite warn mt"><span>Sổ lệch <strong><%= formatMoney(Math.abs(item.diff)) %>đ</strong> so với ngân hàng — thiếu <%= item.source.kind === 'CARD' ? (item.diff > 0 ? 'khoản quẹt thẻ' : 'khoản hoàn tiền / trả thẻ') : item.diff > 0 ? 'khoản chi' : 'khoản thu' %> chưa ghi. <a href="/household/<%= household.id %>/transactions?month=<%= selectedMonth %>">Thêm giao dịch tay</a>.<% if (item.source.kind === 'CARD' && !twin) { %> Hoặc thẻ này dùng chung hạn mức với thẻ khác — bấm <strong>Sửa nguồn</strong> rồi chọn <strong>Thẻ thông</strong>.<% } %></span></div>
        <% } %>
        <% if (isAdmin) { %>
          <details class="hh-edit mt"><summary class="btn btn-sm"><%- include('../../partials/icon', { name: 'edit' }) %> Sửa nguồn</summary>
            <form class="hh-form hh-form-inline" method="post" action="/household/<%= household.id %>/sources/<%= source.id %>" data-source-form>
              <%- sourceForm(source, item.balance) %>
              <div><label>Trạng thái</label><select name="active"><option value="on" <%= source.active ? 'selected' : '' %>>Đang dùng</option><option value="off" <%= source.active ? '' : 'selected' %>>Ẩn</option></select></div>
              <div class="hh-form-action"><button class="btn btn-sm btn-primary" data-loading-text="…">Lưu</button></div>
            </form>
            <form method="post" action="/household/<%= household.id %>/sources/<%= source.id %>/delete" data-confirm="Xoá nguồn '<%= source.name %>'? Nguồn đã có giao dịch sẽ chỉ bị ẩn."><button class="btn btn-sm btn-danger" data-loading-text="…">Xoá / ẩn</button></form>
          </details>
        <% } %>
      </section>
    <% }) %>
    <%# Cho vay ghi bằng giao dịch (mục đích Cho vay), gom theo nội dung — hiện cùng kiểu thẻ với nguồn khai tay. %>
    <% (typeof lending !== 'undefined' ? lending.rows : []).forEach((row) => { %>
      <section class="card-lite p hh-source <%= row.outstanding > 0 ? '' : 'is-muted' %>">
        <div class="hh-source-head">
          <div><h3 class="mb-0"><%= row.name %></h3><span class="badge"><%= labels.source.LENT %></span> <span class="badge">từ giao dịch</span><% if (row.outstanding <= 0) { %><span class="badge">đã trả hết</span><% } %></div>
        </div>
        <div class="grid kv-grid mt">
          <div class="kv"><span>Đã cho vay</span><strong class="<%= row.outstanding > 0 ? 'text-danger' : '' %>"><%= formatMoney(row.outstanding) %>đ</strong></div>
          <div class="kv"><span>Đã trả</span><strong><%= formatMoney(row.repaid) %>đ</strong></div>
        </div>
        <% if (isAdmin) { %><p class="muted mt mb-0">Ghi từ giao dịch có mục đích Cho vay, gom theo ô Nội dung. Họ trả: khoản Thu vào tài khoản với mục đích Cho vay, hoặc bấm "Người vay trả nợ" trên Telegram.</p><% } %>
      </section>
    <% }) %>
  </div>
  <% if (!balances.length) { %><section class="card-lite empty-state"><%- include('../../partials/icon', { name: 'card' }) %><p>Chưa có nguồn tiền nào.</p></section><% } %>
<% } %>
