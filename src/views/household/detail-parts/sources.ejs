<% if (section === 'sources') { %>
  <%
    // Ô nào hiện tuỳ loại nguồn (household.js đọc data-for): tài khoản → ngân hàng, số TK, chủ, số dư;
    // tiết kiệm / đầu tư / tiền mặt → chủ + số dư; khoản vay → lãi suất + nợ hiện tại; thẻ tín dụng →
    // ô HẠN MỨC THẺ (khai tay lại từ 11/9/2026) nhưng KHÔNG có ô dư nợ: đã quẹt chưa trả cộng từ giao
    // dịch, hạn mức còn = hạn mức khai − phần ấy (cộng cả thẻ ăn theo, xem `limitUsed`).
    // Ngày sao kê / đến hạn đã bỏ khỏi form theo ý chủ app (cột vẫn còn trong DB, không dùng).
    // Ô số dư / nợ nhập số HIỆN TẠI (chủ app: khỏi nhập số dư đầu rồi so lệch). Server tự suy số đầu kỳ
    // = số hiện tại trừ/cộng dòng tiền đã ghi. `current` là số app đang tính cho nguồn đó (form sửa).
    const kindOptions = Object.keys(labels.source);
    const esc = (value) => String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    // Thẻ thông = quẹt thẻ này thì hạn mức thẻ kia cũng giảm. Khai bằng cách chọn thẻ kia (quan hệ CÓ
    // HƯỚNG, xem `affectsLimitOf`); hạn mức thì mỗi thẻ vẫn khai riêng số của nó.
    const cardList = sources.filter((item) => item.kind === 'CARD');
    // Thẻ thông CÓ HƯỚNG: `limitSharesWith` = thẻ mà giao dịch của thẻ này cũng làm đổi hạn mức của nó.
    // `feeders` = mấy thẻ đang trỏ VỀ thẻ này (thẻ này ăn theo chúng).
    const sharesWith = (source) => (source && source.limitSharesWith ? cardList.find((item) => item.id.toString() === source.limitSharesWith.toString()) : null);
    const feedersOf = (source) => (source ? cardList.filter((item) => item.limitSharesWith && item.limitSharesWith.toString() === source.id.toString()) : []);
    const sourceForm = (source, current) => `
      <div><label>Tên nguồn</label><input name="name" value="${source ? source.name.replace(/"/g, '&quot;') : ''}" placeholder="Ví dụ: Timo, Thẻ MSB" required></div>
      <div><label>Loại</label><select name="kind" data-source-kind>${kindOptions.map((kind) => `<option value="${kind}" ${source && source.kind === kind ? 'selected' : ''}>${labels.source[kind]}</option>`).join('')}</select></div>
      <div data-for="BANK CARD"><label>Ngân hàng</label><select name="bank">${['TIMO','MSB','OTHER'].map((bank) => `<option value="${bank}" ${(source ? source.bank : 'TIMO') === bank ? 'selected' : ''}>${labels.bank[bank]}</option>`).join('')}</select></div>
      <div data-for="BANK"><label>Số tài khoản</label><input name="matchKey" value="${source ? source.matchKey : ''}" placeholder="Chỉ cần khi có nhiều tài khoản cùng ngân hàng" inputmode="numeric" data-match-key></div>
      <div data-for="CARD"><label>4 số cuối thẻ</label><input value="${source ? source.matchKey : ''}" placeholder="3065" inputmode="numeric" maxlength="4" data-match-key></div>
      <div data-for="BANK CARD CASH SAVING INVEST LOAN"><label>Chủ nguồn</label><input name="ownerName" value="${source ? source.ownerName.replace(/"/g, '&quot;') : ''}" placeholder="Chồng / Vợ"></div>
      <div data-for="BANK CASH SAVING INVEST" data-balance-box><label>Số dư</label><input class="money-input" name="currentBalance" value="${source ? formatMoney(current) : ''}" inputmode="numeric" data-opening></div>
      <div data-for="BANK" data-timo-note hidden><label>Số dư</label><div class="field-static">Tự lấy từ mail Timo gần nhất${source ? ': ' + formatMoney(current) + 'đ' : ''}</div></div>
      <div data-for="CARD"><label>Thẻ thông của thẻ này</label><select name="limitSharesWith"><option value="">— Không có —</option>${cardList
        .filter((item) => !source || item.id.toString() !== source.id.toString())
        .map((item) => `<option value="${item.id}" ${sharesWith(source) && sharesWith(source).id === item.id ? 'selected' : ''}>${esc(item.name)}</option>`)
        .join('')}</select><small class="field-hint">Chọn thẻ mà <strong>quẹt / trả thẻ này thì hạn mức thẻ đó cũng đổi theo</strong>. Thẻ ăn theo (thẻ nhìn thấy hạn mức của thẻ khác) thì để trống. Hai thẻ thông nhau thì khai ở CẢ HAI thẻ, mỗi thẻ trỏ về thẻ kia. Hạn mức mỗi thẻ một khác không sao.${feedersOf(source).length ? ' Đang có ăn theo: ' + feedersOf(source).map((item) => esc(item.name)).join(', ') + '.' : ''}</small></div>
      <div data-for="CARD"><label>Hạn mức thẻ</label><input class="money-input" name="creditLimit" value="${source && Number(source.creditLimit) ? formatMoney(source.creditLimit) : ''}" placeholder="Ví dụ: 20.000.000" inputmode="numeric"><small class="field-hint">Hạn mức ngân hàng cấp cho thẻ này. <strong>Hạn mức còn</strong> = số này trừ các khoản quẹt, cộng lại các khoản hoàn tiền / trả thẻ. Để trống thì app quay về lấy hạn mức khả dụng trong mail gần nhất. Thẻ còn khoản quẹt cũ từ trước khi dùng app thì trừ luôn phần ấy vào đây cho khớp.</small></div>
      <div data-for="CARD" class="hh-form-wide"><label>Đã quẹt chưa trả</label><div class="field-static">Cộng từ giao dịch, không khai tay${source ? ' — đang là ' + formatMoney(current) + 'đ' : ''}</div></div>
      <div data-for="LOAN"><label>Nợ hiện tại</label><input class="money-input" value="${source ? formatMoney(current) : ''}" inputmode="numeric" data-opening></div>
      <div data-for="LENT"><label>Đã cho vay</label><input class="money-input" value="${source ? formatMoney(current) : ''}" inputmode="numeric" data-opening></div>
      <div data-for="LOAN"><label>Lãi suất %/năm</label><input name="interestRate" value="${source ? Number(source.interestRate) : ''}" placeholder="Ví dụ: 10.5" inputmode="decimal"></div>`;
  %>
  <section class="card-lite p mb">
    <div class="section-heading">
      <div><span class="feature-icon"><%- include('../../partials/icon', { name: 'card' }) %></span><h2 class="section-title">Nguồn tiền</h2><p class="muted">Tài khoản, thẻ tín dụng, tiết kiệm, đầu tư, khoản vay, tiền mặt. Nhập số dư đang có, sau đó mọi thay đổi tự cộng từ giao dịch; thẻ tín dụng thì khai hạn mức thẻ, còn hạn mức còn app tự trừ các khoản quẹt và cộng lại khoản hoàn tiền / trả thẻ.</p></div>
      <span class="badge badge-dark">Có <%= formatMoney(totals.cash) %>đ<% if (totals.saved) { %> · để dành <%= formatMoney(totals.saved) %>đ<% } %> · nợ <%= formatMoney(totals.debt) %>đ</span>
    </div>
  </section>

  <% if (isAdmin) { %>
    <section class="card-lite p mb">
      <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'plus' }) %> Thêm nguồn</h2>
      <form class="hh-form" method="post" action="/household/<%= household.id %>/sources" data-source-form>
        <%- sourceForm(null, 0) %>
        <div class="hh-form-action"><button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Thêm nguồn</button></div>
      </form>
      <p class="muted mt">Thẻ tín dụng: quẹt thẻ là chi tiêu ngay lúc quẹt; trả thẻ ghi là <strong>Chuyển nguồn</strong> từ tài khoản sang thẻ, không tính chi lần hai. Khoản vay: trả nợ ghi Chuyển nguồn sang khoản vay, chọn trả gốc hay trả lãi. Cho vay: tạo một nguồn loại <strong>Cho vay</strong> mang tên người vay; chuyển tiền sang là cho vay thêm, họ trả thì chuyển ngược về tài khoản (trên Telegram có nút sẵn).</p>
    </section>
  <% } %>

  <div class="hh-source-list">
    <% balances.forEach((item) => { const source = sources.find((row) => row.id.toString() === item.source.id); const debt = ['CARD', 'LOAN'].includes(item.source.kind); const lent = item.source.kind === 'LENT'; const cardLimit = Number(item.source.creditLimit); %>
      <section class="card-lite p hh-source <%= item.source.active ? '' : 'is-muted' %>">
        <div class="hh-source-head">
          <div><h3 class="mb-0"><%= item.source.name %></h3><span class="badge"><%= labels.source[item.source.kind] %></span> <% if (['BANK', 'CARD'].includes(item.source.kind) && source.bank !== 'OTHER') { %><span class="badge"><%= labels.bank[source.bank] %><%= source.matchKey ? ' · ' + source.matchKey : '' %></span><% } %><% const twin = sharesWith(source); const feeders = feedersOf(source); %><% if (twin) { %><span class="badge">thông sang <%= twin.name %></span><% } %><% if (feeders.length) { %><span class="badge">theo <%= feeders.map((item) => item.name).join(', ') %></span><% } %><% if (!item.source.active) { %><span class="badge">đã ẩn</span><% } %></div>
        </div>
        <%# Mọi con số nằm trong ô (chủ app: "mấy cái đang không trong ô thì cho vào ô"). %>
        <div class="grid kv-grid mt">
          <%# Thẻ tín dụng: ô đầu là HẠN MỨC CÒN. Đã khai hạn mức thì SỔ tính (hạn mức khai − đã quẹt chưa
              trả của cả cụm thẻ thông) — chủ app 11/9/2026, khỏi phụ thuộc mail về sớm hay muộn; chưa khai
              thì vẫn lấy hạn mức khả dụng mail gần nhất. Số ngân hàng báo hiện thêm một ô để so mắt thường.
              HẠN MỨC KHAI đứng thành ô riêng chứ không nhét chữ nhỏ dưới ô Hạn mức còn (chủ app 11/9/2026:
              số nào cũng phải nằm trong ô của nó), phần đã dùng tính cả thẻ ăn theo cũng vậy. %>
          <% if (item.source.kind === 'CARD') { %>
            <div class="kv"><span>Hạn mức còn</span><strong><% if (cardLimit) { %><%= formatMoney(item.available) %>đ<% } else if (item.reportedAvailable) { %><%= formatMoney(item.reportedAvailable.value) %>đ<br><small class="muted">ngân hàng báo <%= fmtDateTime(item.reportedAvailable.at) %></small><% } else { %>—<br><small class="muted">chưa khai hạn mức thẻ</small><% } %></strong></div>
            <% if (cardLimit) { %><div class="kv"><span>Hạn mức thẻ</span><strong><%= formatMoney(cardLimit) %>đ</strong></div><% } %>
            <%# Số này chỉ đếm những gì SỔ ghi được: quẹt cộng vào, trả thẻ trừ đi. Trả hết là về 0 — KHÔNG
                có chuyện "trả dư" (trả thẻ chỉ là trả nợ thẻ, chủ app 10/9/2026). Xuống dưới 0 nghĩa là SỔ
                THIẾU khoản quẹt: kẹp về 0 và báo phần thiếu. %>
            <div class="kv"><span>Đã quẹt chưa trả</span><strong class="<%= item.balance > 0 ? 'text-danger' : '' %>"><%= formatMoney(Math.max(0, item.balance)) %>đ</strong></div>
            <%# Thẻ ăn theo quẹt cũng ngốn hạn mức thẻ này, nên số trừ vào hạn mức to hơn phần quẹt của chính nó. %>
            <% if (cardLimit && item.limitUsed > Math.max(0, item.balance)) { %><div class="kv"><span>Đã dùng cả thẻ ăn theo</span><strong><%= formatMoney(item.limitUsed) %>đ</strong></div><% } %>
            <% if (cardLimit && item.reportedAvailable) { %><div class="kv"><span>Ngân hàng báo còn</span><strong><%= formatMoney(item.reportedAvailable.value) %>đ<br><small class="muted"><%= fmtDateTime(item.reportedAvailable.at) %></small></strong></div><% } %>
          <% } else { %>
            <div class="kv"><span><%= debt ? 'Nợ hiện tại' : lent ? 'Đã cho vay' : 'Số dư' %></span><strong class="<%= debt && item.balance > 0 ? 'text-danger' : '' %>"><%= formatMoney(item.balance) %>đ</strong></div>
          <% } %>
          <% if (source.ownerName) { %><div class="kv"><span>Chủ nguồn</span><strong><%= source.ownerName %></strong></div><% } %>
          <% if (Number(source.interestRate)) { %><div class="kv"><span>Lãi suất</span><strong><%= Number(source.interestRate) %>%/năm</strong></div><% } %>
          <% if (item.reported) { %><div class="kv"><span>Ngân hàng báo</span><strong><%= formatMoney(item.reported.value) %>đ<br><small class="muted"><%= fmtDateTime(item.reported.at) %></small></strong></div><% } %>
        </div>
        <%# Sổ lệch số ngân hàng = thiếu giao dịch. App KHÔNG tự bù (chủ app 10/9/2026) — nhắc để thêm tay. %>
        <%# Dưới 0 = đã trả nhiều hơn phần quẹt SỔ ghi được. Gần như luôn là trả cho khoản quẹt có từ trước
            khi dùng app (app không khai nợ đầu của thẻ) — nói đúng thế, đừng bảo "thiếu khoản quẹt" rồi
            chủ app ghi thêm một khoản chi không có thật. %>
        <% if (item.source.kind === 'CARD' && item.balance < 0) { %>
          <div class="alert-lite warn mt"><span>Đã trả nhiều hơn phần quẹt trong sổ <strong><%= formatMoney(-item.balance) %>đ</strong> — thường là trả cho khoản quẹt có trước khi dùng app, sổ chưa có. Nếu là mail quẹt bị bỏ sót thì <a href="/household/<%= household.id %>/transactions?month=<%= selectedMonth %>">thêm giao dịch tay</a>.</span></div>
        <% } %>
        <%# Đã quẹt chưa trả vượt cả hạn mức khai: hoặc ô Hạn mức thẻ gõ thiếu, hoặc sổ thiếu khoản trả thẻ. %>
        <% if (cardLimit && item.limitUsed > cardLimit) { %>
          <div class="alert-lite warn mt"><span>Đã quẹt chưa trả <strong><%= formatMoney(item.limitUsed) %>đ</strong> vượt hạn mức khai <strong><%= formatMoney(item.limitUsed - cardLimit) %>đ</strong> — xem lại ô <strong>Hạn mức thẻ</strong>, hoặc sổ còn thiếu khoản trả thẻ / hoàn tiền.</span></div>
        <% } %>
        <% if (item.diff) { %>
          <div class="alert-lite warn mt"><span>Sổ lệch <strong><%= formatMoney(Math.abs(item.diff)) %>đ</strong> so với ngân hàng — thiếu <%= item.source.kind === 'CARD' ? (item.diff > 0 ? 'khoản quẹt thẻ' : 'khoản hoàn tiền / trả thẻ') : item.diff > 0 ? 'khoản chi' : 'khoản thu' %> chưa ghi. <a href="/household/<%= household.id %>/transactions?month=<%= selectedMonth %>">Thêm giao dịch tay</a>.<% if (item.source.kind === 'CARD' && cardLimit) { %> Hoặc ô <strong>Hạn mức thẻ</strong> khai chưa đúng (thẻ còn khoản quẹt cũ từ trước khi dùng app thì trừ luôn vào hạn mức khai).<% } %><% if (item.source.kind === 'CARD' && !twin) { %> Hoặc quẹt thẻ này làm đổi hạn mức thẻ khác — bấm <strong>Sửa nguồn</strong> rồi chọn <strong>Thẻ thông</strong>.<% } %></span></div>
        <% } %>
        <% if (isAdmin) { %>
          <details class="hh-edit mt"><summary class="btn btn-sm"><%- include('../../partials/icon', { name: 'edit' }) %> Sửa nguồn</summary>
            <form class="hh-form hh-form-inline" method="post" action="/household/<%= household.id %>/sources/<%= source.id %>" data-source-form>
              <%- sourceForm(source, item.balance) %>
              <div><label>Trạng thái</label><select name="active"><option value="on" <%= source.active ? 'selected' : '' %>>Đang dùng</option><option value="off" <%= source.active ? '' : 'selected' %>>Ẩn</option></select></div>
              <div class="hh-form-action"><button class="btn btn-sm btn-primary" data-loading-text="…">Lưu</button></div>
            </form>
            <form method="post" action="/household/<%= household.id %>/sources/<%= source.id %>/delete" data-confirm="Xoá nguồn '<%= source.name %>'? Nguồn đã có giao dịch sẽ chỉ bị ẩn."><button class="btn btn-sm btn-danger" data-loading-text="…">Xoá / ẩn</button></form>
          </details>
        <% } %>
      </section>
    <% }) %>
    <%# Cho vay ghi bằng giao dịch (mục đích Cho vay), gom theo nội dung — hiện cùng kiểu thẻ với nguồn khai tay. %>
    <% (typeof lending !== 'undefined' ? lending.rows : []).forEach((row) => { %>
      <section class="card-lite p hh-source <%= row.outstanding > 0 ? '' : 'is-muted' %>">
        <div class="hh-source-head">
          <div><h3 class="mb-0"><%= row.name %></h3><span class="badge"><%= labels.source.LENT %></span> <span class="badge">từ giao dịch</span><% if (row.outstanding <= 0) { %><span class="badge">đã trả hết</span><% } %></div>
        </div>
        <div class="grid kv-grid mt">
          <div class="kv"><span>Đã cho vay</span><strong class="<%= row.outstanding > 0 ? 'text-danger' : '' %>"><%= formatMoney(row.outstanding) %>đ</strong></div>
          <div class="kv"><span>Đã trả</span><strong><%= formatMoney(row.repaid) %>đ</strong></div>
        </div>
        <% if (isAdmin) { %><p class="muted mt mb-0">Ghi từ giao dịch có mục đích Cho vay, gom theo ô Nội dung. Họ trả: khoản Thu vào tài khoản với mục đích Cho vay, hoặc bấm "Người vay trả nợ" trên Telegram.</p><% } %>
      </section>
    <% }) %>
  </div>
  <% if (!balances.length) { %><section class="card-lite empty-state"><%- include('../../partials/icon', { name: 'card' }) %><p>Chưa có nguồn tiền nào.</p></section><% } %>
<% } %>
