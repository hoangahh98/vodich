<% if (section === 'settings' && isAdmin) { %>
  <section class="card-lite p tournament-edit-card mb">
    <div class="section-heading mb"><div><span class="feature-icon"><%- include('../../partials/icon', { name: 'settings' }) %></span><h2 class="section-title">Cài đặt hộ</h2><p class="muted">Thông tin, mục đích, thành viên được xem, Telegram và phân quyền admin.</p></div></div>
    <form class="tournament-form" method="post" action="/household/<%= household.id %>/settings">
      <section class="form-section">
        <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'note' }) %> Thông tin</h2>
        <div class="row">
          <div class="col-12"><label>Tên hộ</label><input name="name" value="<%= household.name %>" required></div>
          <div class="col-12"><label>Ghi chú</label><textarea name="description" rows="2"><%= household.description || '' %></textarea></div>
        </div>
      </section>
      <div class="form-actions mb-4"><button class="btn btn-success" data-loading-text="Đang lưu..."><%- include('../../partials/icon', { name: 'save' }) %> Lưu</button></div>
    </form>
  </section>

  <section class="card-lite p mb">
    <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'target' }) %> Mục đích</h2>
    <p class="muted">Tên tuỳ ý, <strong>loại</strong> quyết định cách tính: chi tiêu, tiết kiệm, trả nợ, dự phòng, cho vay, thu nhập. Kế hoạch tháng để so "đã dùng / kế hoạch".</p>
    <div class="hh-list">
      <% purposes.forEach((purpose) => { %>
        <details class="hh-edit hh-row <%= purpose.active ? '' : 'is-muted' %>">
          <summary><span class="hh-row-main"><strong><%= purpose.name %></strong><span class="badge"><%= labels.purpose[purpose.kind] %></span><% if (!purpose.active) { %><span class="badge">đã ẩn</span><% } %></span><span class="hh-row-side"><%= Number(purpose.monthlyPlan) ? formatMoney(purpose.monthlyPlan) + 'đ / tháng' : 'Chưa đặt kế hoạch' %></span></summary>
          <form class="hh-form hh-form-inline" method="post" action="/household/<%= household.id %>/purposes/<%= purpose.id %>">
            <div><label>Tên</label><input name="name" value="<%= purpose.name %>" required></div>
            <div><label>Loại</label><select name="kind"><% ['LIVING','SAVING','DEBT','RESERVE','LENDING','INCOME'].forEach((kind) => { %><option value="<%= kind %>" <%= purpose.kind === kind ? 'selected' : '' %>><%= labels.purpose[kind] %></option><% }) %></select></div>
            <div><label>Kế hoạch / tháng</label><input class="money-input" name="monthlyPlan" value="<%= Number(purpose.monthlyPlan) ? formatMoney(purpose.monthlyPlan) : '' %>" inputmode="numeric"></div>
            <div><label>Trạng thái</label><select name="active"><option value="on" <%= purpose.active ? 'selected' : '' %>>Đang dùng</option><option value="off" <%= purpose.active ? '' : 'selected' %>>Ẩn</option></select></div>
            <div class="hh-form-action"><button class="btn btn-sm btn-primary" data-loading-text="…">Lưu</button></div>
          </form>
          <form method="post" action="/household/<%= household.id %>/purposes/<%= purpose.id %>/delete" data-confirm="Xoá mục '<%= purpose.name %>'? Đã có giao dịch thì chỉ ẩn."><button class="btn btn-sm btn-danger" data-loading-text="…">Xoá / ẩn</button></form>
        </details>
      <% }) %>
    </div>
    <form class="hh-form mt" method="post" action="/household/<%= household.id %>/purposes">
      <div><label>Mục mới</label><input name="name" placeholder="Ví dụ: Hiếu hỉ" required></div>
      <div><label>Loại</label><select name="kind"><% ['LIVING','SAVING','DEBT','RESERVE','LENDING','INCOME'].forEach((kind) => { %><option value="<%= kind %>"><%= labels.purpose[kind] %></option><% }) %></select></div>
      <div><label>Kế hoạch / tháng</label><input class="money-input" name="monthlyPlan" inputmode="numeric"></div>
      <div class="hh-form-action"><button class="btn btn-success" data-loading-text="…"><%- include('../../partials/icon', { name: 'plus' }) %> Thêm mục</button></div>
    </form>
  </section>

  <section class="card-lite p mb">
    <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'bolt' }) %> Telegram</h2>
    <% if (linked) { %>
      <div class="alert-lite info mb"><span>Đã liên kết với một nhóm Telegram. Tin ngân hàng gửi vào nhóm sẽ tự ghi sổ; bấm nút dưới tin để chọn mục đích.</span></div>
      <form method="post" action="/household/<%= household.id %>/telegram/unlink" data-confirm="Gỡ liên kết nhóm Telegram?"><button class="btn btn-sm btn-danger" data-loading-text="…">Gỡ liên kết</button></form>
    <% } else { %>
      <ol class="hh-steps">
        <li>Thêm bot của app vào một nhóm Telegram riêng của gia đình (bot cần quyền đọc tin nhắn trong nhóm).</li>
        <li>Trong nhóm gõ: <code>/link <%= linkCode %></code></li>
        <li>Cài Apps Script trên Gmail gửi mail Timo / MSB vào app (hướng dẫn ở README, mục Telegram).</li>
      </ol>
      <p class="muted">Mã liên kết: <strong class="hh-code"><%= linkCode %></strong> — dùng một lần, tải lại trang vẫn giữ mã cho tới khi liên kết xong.</p>
    <% } %>
  </section>

  <section class="card-lite p mb">
    <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'users' }) %> Thành viên trong nhà</h2>
    <p class="muted">Thành viên đăng nhập bằng email trong danh sách Thành viên (mật khẩu chung như vận động viên) và chỉ XEM được hộ này.</p>
    <div class="table-wrap member-table"><table class="member-list"><thead><tr><th>Tên</th><th>Email</th><th></th></tr></thead><tbody>
      <% members.forEach((access) => { %>
        <tr><td><strong><%= access.player.displayName %></strong></td><td><%= access.player.email %></td><td class="text-right row-action"><form method="post" action="/household/<%= household.id %>/members/<%= access.id %>/delete" data-confirm="Bỏ quyền xem của <%= access.player.displayName %>?"><button class="btn btn-sm btn-danger btn-icon" aria-label="Bỏ" data-loading-text="…"><%- include('../../partials/icon', { name: 'trash' }) %></button></form></td></tr>
      <% }) %>
      <% if (!members.length) { %><tr><td colspan="3" class="muted text-center">Chưa có thành viên nào được xem.</td></tr><% } %>
    </tbody></table></div>
    <% if (players.length) { %>
      <form class="mt" method="post" action="/household/<%= household.id %>/members" data-require-checked="playerIds">
        <label>Thêm người được xem</label>
        <div class="check-filter mb"><%- include('../../partials/icon', { name: 'search' }) %><input type="search" data-check-filter="householdCandidateList" placeholder="Gõ tên hoặc email để tìm…" autocomplete="off" aria-label="Tìm người"><span class="badge" data-check-filter-count><%= players.length %></span></div>
        <div class="player-check-list mb" id="householdCandidateList" data-player-picker>
          <% players.forEach((player) => { %><label><input type="checkbox" name="playerIds" value="<%= player.id %>"><span><strong><%= player.displayName %></strong><small><%= player.email %></small></span></label><% }) %>
          <div class="muted p" data-check-filter-empty hidden>Không có ai khớp.</div>
        </div>
        <button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Cấp quyền xem cho người đã chọn</button>
      </form>
    <% } else { %>
      <p class="muted mt">Chưa có ai để thêm — tạo người ở trang <a href="/players">Thành viên</a> trước.</p>
    <% } %>
  </section>

  <section class="card-lite p mb">
    <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'lock' }) %> Phân quyền admin</h2>
    <div class="grid kv-grid mb">
      <div class="kv"><span>Người tạo</span><strong><%= household.ownerAdmin?.displayName || household.ownerAdmin?.username || 'Admin gốc' %></strong></div>
      <div class="kv"><span>Đang được phân quyền</span><strong><%= household.permissions.length %> admin</strong></div>
    </div>
    <% if (admins.length) { %>
      <form class="permission-create-form mb" method="post" action="/household/<%= household.id %>/permissions">
        <div><label>Thêm admin</label><select name="adminId" required><% admins.forEach((admin) => { %><option value="<%= admin.id %>"><%= admin.displayName %> (<%= admin.username %>)</option><% }) %></select></div>
        <div class="permission-create-action"><button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Thêm quyền</button></div>
      </form>
    <% } %>
    <div class="permission-admin-list">
      <% household.permissions.forEach((permission) => { %>
        <div class="permission-admin-card"><div class="flex between center gap"><div><strong><%= permission.admin.displayName %></strong><br><span class="muted"><%= permission.admin.username %></span></div><form method="post" action="/household/<%= household.id %>/permissions/<%= permission.id %>/delete" data-confirm="Gỡ quyền admin này?"><button class="btn btn-sm btn-danger" data-loading-text="Đang gỡ...">Gỡ quyền</button></form></div></div>
      <% }) %>
      <% if (!household.permissions.length) { %><div class="alert-lite info">Chưa cấp quyền cho admin nào.</div><% } %>
    </div>
  </section>

  <div class="flex gap settings-action-row mb">
    <form method="post" action="/household/<%= household.id %>/delete" data-confirm="Xoá hộ '<%= household.name %>' cùng toàn bộ nguồn, giao dịch, khoản định kỳ? Không khôi phục được."><button class="btn btn-danger" data-loading-text="Đang xoá..."><%- include('../../partials/icon', { name: 'trash' }) %> Xoá hộ</button></form>
  </div>
<% } %>
