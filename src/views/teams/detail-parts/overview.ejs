<% if (section === 'overview') { %>
  <%# Các ô bấm được dùng details/summary, không cần JS. %>
  <% const unpaidMembers = members.filter((member) => member.expectedAmount > member.paidAmount); %>
  <section class="grid finance-grid mb">
    <details class="metric-card green metric-drop">
      <summary><span>🏦 Tổng quỹ</span><strong><%= formatMoney(finance.totalFund) %>đ</strong><small>Cả đội phải đóng <%= formatMoney(finance.totalDue) %>đ + còn lại tháng trước <%= formatMoney(finance.previousBalance) %>đ<% if (finance.guestPaid) { %> + người chơi vãng lai đóng <%= formatMoney(finance.guestPaid) %>đ<% } %></small></summary>
      <div class="metric-drop-body">
        <% unpaidMembers.forEach((member) => { %>
          <div><span>👤 <%= member.player.displayName %></span><strong><%= formatMoney(member.expectedAmount - member.paidAmount) %>đ</strong></div>
        <% }) %>
        <% if (!unpaidMembers.length) { %><p class="metric-drop-note">Cả đội đã đóng đủ.</p><% } else { %>
          <p class="metric-drop-note"><%= unpaidMembers.length %> người chưa đóng — tổng còn thiếu <strong><%= formatMoney(finance.totalMissing) %>đ</strong></p>
        <% } %>
      </div>
    </details>
    <div class="metric-card <%= finance.balance < 0 ? 'red' : 'orange' %>"><span>💵 Quỹ còn lại</span><strong><%= formatMoney(finance.balance) %>đ</strong><small>= Tổng quỹ <%= formatMoney(finance.totalFund) %>đ − Tổng đã chi <%= formatMoney(finance.totalSpent) %>đ</small></div>
  </section>
  <section class="grid finance-grid mb">
    <details class="metric-card gold metric-drop">
      <summary><span>🧾 Tổng đã chi</span><strong><%= formatMoney(finance.totalSpent) %>đ</strong><small>Tiền sân + <%= expenses.length %> khoản chi trong tháng</small></summary>
      <div class="metric-drop-body">
        <div><span>🏟️ Tiền sân</span><strong><%= formatMoney(finance.courtCost) %>đ</strong></div>
        <% expenses.forEach((expense) => { %>
          <div><span>💸 <% if (expense.expenseDate) { %><%= new Date(expense.expenseDate).toLocaleDateString('vi-VN') %> <% } %><%= expense.content %></span><strong><%= formatMoney(expense.amount) %>đ</strong></div>
        <% }) %>
        <% if (!expenses.length) { %><p class="metric-drop-note">Chưa có khoản chi nào trong tháng.</p><% } %>
      </div>
    </details>
  </section>
<% } %>
