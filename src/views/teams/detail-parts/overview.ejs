<% if (section === 'overview') { %>
  <%# Các ô bấm được dùng details/summary, không cần JS. %>
  <% const unpaidMembers = members.filter((member) => member.expectedAmount > member.paidAmount); %>
  <% if (typeof fundPreview !== 'undefined' && fundPreview) { %>
    <section class="alert-lite warn mb"><span>Tháng <%= selectedMonth %> chưa chốt quỹ — số dưới đây là tạm tính: tiền sân lấy theo tháng trước, mức phí tự chia đều cho <%= finance.fixedCount %> người cố định.<% if (currentUser.role === 'ADMIN') { %> Vào <a href="/teams/<%= team.id %>/settings?month=<%= selectedMonth %>">Cài đặt</a> để chốt.<% } %></span></section>
  <% } %>
  <%# Ô đầu CHỈ hiện số tiền còn lại tháng trước (chủ app 4/10/2026) — trước là "Tổng quỹ" = phải đóng + dư + vãng lai
      kèm danh sách người còn thiếu; danh sách đó chuyển sang ô "Tổng đã thu". %>
  <section class="grid finance-grid mb">
    <div class="metric-card green"><span>Tổng dư đầu tháng</span><strong><%= formatMoney(finance.previousBalance) %>đ</strong></div>
    <div class="metric-card <%= finance.balance < 0 ? 'red' : 'gold' %>"><span>Quỹ còn lại</span><strong><%= formatMoney(finance.balance) %>đ</strong><small>= Dư đầu tháng <%= formatMoney(finance.previousBalance) %>đ + cả đội phải đóng <%= formatMoney(finance.totalDue) %>đ<% if (finance.guestPaid) { %> + vãng lai <%= formatMoney(finance.guestPaid) %>đ<% } %> − Tổng đã chi <%= formatMoney(finance.totalSpent) %>đ</small></div>
  </section>
  <% const paidFixed = members.filter((member) => member.memberType === 'FIXED' && member.paidAmount > 0); const overviewReceipts = typeof guestReceipts !== 'undefined' ? guestReceipts : []; const legacyGuestRows = members.filter((member) => member.memberType === 'GUEST' && member.paidAmount > 0); %>
  <section class="grid finance-grid mb">
    <details class="metric-card blue metric-drop">
      <summary><span>Tổng đã thu</span><strong><%= formatMoney(finance.totalPaid) %>đ</strong><small>Cố định <%= formatMoney(finance.fixedPaid) %>đ (<%= paidFixed.length %>/<%= finance.fixedCount %> người)<% if (finance.guestPaid) { %> + vãng lai <%= formatMoney(finance.guestPaid) %>đ<% } %></small></summary>
      <div class="metric-drop-body">
        <%# Cố định chỉ một dòng tổng + người còn thiếu (theo ý chủ app); vãng lai liệt kê từng khoản. %>
        <div><span>Cố định (<%= paidFixed.length %>/<%= finance.fixedCount %> người đã đóng)</span><strong><%= formatMoney(finance.fixedPaid) %>đ</strong></div>
        <% unpaidMembers.forEach((member) => { %>
          <div><span><%= member.player.displayName %> <small class="muted">· còn thiếu</small></span><strong><%= formatMoney(member.expectedAmount - member.paidAmount) %>đ</strong></div>
        <% }) %>
        <% if (unpaidMembers.length) { %><p class="metric-drop-note"><%= unpaidMembers.length %> người chưa đóng đủ — tổng còn thiếu <strong><%= formatMoney(finance.totalMissing) %>đ</strong></p><% } %>
        <% legacyGuestRows.forEach((member) => { %>
          <div><span><%= member.player.displayName %> <small class="muted">· vãng lai</small></span><strong><%= formatMoney(member.paidAmount) %>đ</strong></div>
        <% }) %>
        <% overviewReceipts.forEach((receipt) => { %>
          <div><span><%= new Date(receipt.receiptDate).toLocaleDateString('vi-VN') %> · <%= receipt.player ? receipt.player.displayName : receipt.guestName %></span><strong><%= formatMoney(receipt.amount) %>đ</strong></div>
        <% }) %>
        <% if (!legacyGuestRows.length && !overviewReceipts.length) { %><p class="metric-drop-note">Tháng này chưa có khoản vãng lai nào.</p><% } %>
      </div>
    </details>
    <details class="metric-card orange metric-drop">
      <summary><span>Tổng đã chi</span><strong><%= formatMoney(finance.totalSpent) %>đ</strong><small>Tiền sân + <%= expenses.length %> khoản chi trong tháng</small></summary>
      <div class="metric-drop-body">
        <div><span>Tiền sân</span><strong><%= formatMoney(finance.courtCost) %>đ</strong></div>
        <% expenses.forEach((expense) => { %>
          <div><span><% if (expense.expenseDate) { %><%= new Date(expense.expenseDate).toLocaleDateString('vi-VN') %> · <% } %><%= expense.content %></span><strong><%= formatMoney(expense.amount) %>đ</strong></div>
        <% }) %>
        <% if (!expenses.length) { %><p class="metric-drop-note">Chưa có khoản chi nào trong tháng.</p><% } %>
      </div>
    </details>
  </section>
<% } %>
