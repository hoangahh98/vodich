<% if (section === 'expenses') { %>
  <% const isExpenseAdmin = currentUser.role === 'ADMIN'; %>
  <section class="card-lite p mb">
    <div class="section-heading">
      <div><span class="feature-icon"><%- include('../../partials/icon', { name: 'receipt' }) %></span><h2 class="section-title">Khoản chi</h2><p class="muted">Tháng <%= selectedMonth %>. Ghi từng khoản chi của đội: nước, bóng, thuê sân…</p></div>
      <span class="badge badge-dark">Đã chi <%= formatMoney(finance.totalExpense) %>đ</span>
    </div>
  </section>

  <section class="card-lite">
    <div class="card-hdr red"><span><%- include('../../partials/icon', { name: 'receipt' }) %> Các khoản chi</span><span class="badge badge-dark"><%= expenses.length %> khoản · <%= formatMoney(finance.totalExpense) %>đ</span></div>
    <% if (isExpenseAdmin) { %>
      <div class="p">
        <form class="team-expense-form" method="post" action="/teams/<%= team.id %>/expenses">
          <input type="hidden" name="month" value="<%= selectedMonth %>">
          <div class="expense-date"><label>Ngày chi</label><input type="date" name="expenseDate" required></div>
          <div class="expense-content"><label>Nội dung</label><input name="content" placeholder="Uống nước, bóng..." required></div>
          <div class="expense-amount"><label>Số tiền</label><input class="money-input" name="amount" required></div>
          <div class="expense-action"><button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Thêm</button></div>
        </form>
      </div>
    <% } %>
    <div class="table-wrap member-table"><table class="member-list"><thead><tr><th>Ngày</th><th>Nội dung</th><th class="text-right">Tiền</th><% if (isExpenseAdmin) { %><th></th><% } %></tr></thead><tbody>
      <% expenses.forEach((expense) => { %>
        <tr><td class="nowrap"><%= expense.expenseDate ? new Date(expense.expenseDate).toLocaleDateString('vi-VN') : '-' %></td><td><strong><%= expense.content %></strong><% if (expense.notes && isExpenseAdmin) { %><br><span class="muted"><%= expense.notes %></span><% } %></td><td class="text-right paid-cell"><strong><%= formatMoney(expense.amount) %></strong><span class="muted">đ</span></td><% if (isExpenseAdmin) { %><td class="text-right row-action"><form method="post" action="/teams/<%= team.id %>/expenses/<%= expense.id %>/delete" data-confirm="Xóa khoản chi này?"><input type="hidden" name="month" value="<%= selectedMonth %>"><button class="btn btn-sm btn-danger btn-icon" aria-label="Xoá" data-loading-text="…"><%- include('../../partials/icon', { name: 'trash' }) %></button></form></td><% } %></tr>
      <% }) %>
      <% if (!expenses.length) { %><tr><td colspan="<%= isExpenseAdmin ? 4 : 3 %>" class="muted text-center">Chưa có khoản chi nào trong tháng.</td></tr><% } %>
    </tbody></table></div>
  </section>
<% } %>
