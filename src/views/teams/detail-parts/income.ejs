<% if (section === 'income') { %>
  <% const fixedMembers = members.filter((member) => member.memberType === 'FIXED'); const receipts = typeof guestReceipts !== 'undefined' ? guestReceipts : []; const isIncomeAdmin = currentUser.role === 'ADMIN'; %>
  <section class="card-lite p mb">
    <div class="section-heading">
      <div><span class="feature-icon"><%- include('../../partials/icon', { name: 'coin' }) %></span><h2 class="section-title">Khoản thu</h2><p class="muted">Tháng <%= selectedMonth %>. Thành viên cố định đóng theo mức phí tháng; người vãng lai ghi từng buổi.<% if (typeof fundPreview !== 'undefined' && fundPreview) { %> Tháng này chưa chốt quỹ, mức phí là tạm tính.<% } %></p></div>
      <span class="badge badge-dark">Đã thu <%= formatMoney(finance.totalPaid) %>đ</span>
    </div>
  </section>

  <section class="card-lite mb">
    <div class="card-hdr green"><span><%- include('../../partials/icon', { name: 'users' }) %> Cố định</span><span class="badge badge-dark"><%= fixedMembers.length %> người · <%= formatMoney(finance.monthlyFee) %>đ/người</span></div>
    <% if (isIncomeAdmin) { %>
      <form method="post" action="/teams/<%= team.id %>/payments">
        <input type="hidden" name="month" value="<%= selectedMonth %>">
        <div class="table-wrap member-table"><table class="member-list"><thead><tr><th>Tên</th><th class="text-right">Đã thu / mức phí</th></tr></thead><tbody>
          <% fixedMembers.forEach((member) => { %>
            <tr class="<%= member.paymentStatus === 'PAID' ? 'sufficient-row' : 'insufficient-row' %>">
              <td><strong><%= member.player.displayName %></strong><% if (!member.active) { %> <span class="badge badge-warn">Đã rời đội</span><% } %></td>
              <td class="text-right paid-cell"><div class="paid-of"><input class="money-input" name="amount_<%= member.id %>" value="<%= member.paidAmount ? formatMoney(member.paidAmount) : '' %>" placeholder="0" aria-label="Đã thu của <%= member.player.displayName %>"><span class="paid-of-fee">/ <%= formatMoney(member.expectedAmount) %>đ</span></div></td>
            </tr>
          <% }) %>
          <% if (!fixedMembers.length) { %><tr><td colspan="2" class="muted text-center">Chưa có thành viên cố định — gắn nhóm ở mục Thành viên.</td></tr><% } %>
        </tbody></table></div>
        <% if (fixedMembers.length) { %><div class="card-foot"><button class="btn btn-primary" data-loading-text="Đang lưu..."><%- include('../../partials/icon', { name: 'save' }) %> Lưu thu cố định (<%= fixedMembers.length %> người)</button></div><% } %>
      </form>
    <% } else { %>
      <div class="table-wrap member-table"><table class="member-list"><thead><tr><th>Tên</th><th class="text-right">Đã thu / mức phí</th></tr></thead><tbody>
        <% fixedMembers.forEach((member) => { %>
          <tr class="<%= member.paymentStatus === 'PAID' ? 'sufficient-row' : 'insufficient-row' %>"><td><strong><%= member.player.displayName %></strong></td><td class="text-right paid-cell"><strong><%= formatMoney(member.paidAmount) %></strong><span class="muted"> / <%= formatMoney(member.expectedAmount) %>đ</span></td></tr>
        <% }) %>
        <% if (!fixedMembers.length) { %><tr><td colspan="2" class="muted text-center">Chưa có thành viên cố định.</td></tr><% } %>
      </tbody></table></div>
    <% } %>
  </section>

  <section class="card-lite">
    <div class="card-hdr blue"><span><%- include('../../partials/icon', { name: 'user' }) %> Vãng lai</span><span class="badge badge-dark"><%= receipts.length %> buổi · <%= formatMoney(finance.guestPaid) %>đ</span></div>
    <% if (isIncomeAdmin) { %>
      <div class="p">
        <form class="guest-receipt-form" method="post" action="/teams/<%= team.id %>/guest-receipts">
          <input type="hidden" name="month" value="<%= selectedMonth %>">
          <div class="receipt-who"><label>Người chơi</label><input name="guest" list="teamGuestNames" placeholder="Gõ vài chữ để tìm, hoặc gõ tên mới" autocomplete="off" required><datalist id="teamGuestNames"><% (typeof allPlayers !== 'undefined' ? allPlayers : players).forEach((p) => { %><option value="<%= p.displayName %>"><%= p.email %></option><% }) %></datalist><span class="field-hint">Trùng tên trong danh sách thành viên thì tự gắn vào người đó.</span></div>
          <div class="receipt-date"><label>Ngày chơi</label><input type="date" name="receiptDate" value="<%= typeof defaultReceiptDate !== 'undefined' ? defaultReceiptDate : '' %>" required></div>
          <div class="receipt-amount"><label>Thu</label><input class="money-input" name="amount" placeholder="50,000" required></div>
          <div class="receipt-action"><button class="btn btn-success" data-loading-text="Đang ghi..."><%- include('../../partials/icon', { name: 'plus' }) %> Ghi thu</button></div>
        </form>
      </div>
    <% } %>
    <div class="table-wrap member-table"><table class="member-list"><thead><tr><th>Ngày</th><th>Người chơi</th><th class="text-right">Thu</th><% if (isIncomeAdmin) { %><th></th><% } %></tr></thead><tbody>
      <% receipts.forEach((receipt) => { %>
        <tr><td class="nowrap"><%= new Date(receipt.receiptDate).toLocaleDateString('vi-VN') %></td><td><strong><%= receipt.player ? receipt.player.displayName : receipt.guestName %></strong></td><td class="text-right paid-cell"><strong><%= formatMoney(receipt.amount) %></strong><span class="muted">đ</span></td><% if (isIncomeAdmin) { %><td class="text-right row-action"><form method="post" action="/teams/<%= team.id %>/guest-receipts/<%= receipt.id %>/delete" data-confirm="Xoá khoản thu này?"><input type="hidden" name="month" value="<%= selectedMonth %>"><button class="btn btn-sm btn-danger btn-icon" aria-label="Xoá" data-loading-text="…"><%- include('../../partials/icon', { name: 'trash' }) %></button></form></td><% } %></tr>
      <% }) %>
      <% if (!receipts.length) { %><tr><td colspan="<%= isIncomeAdmin ? 4 : 3 %>" class="muted text-center">Chưa ghi khoản thu vãng lai nào trong tháng.</td></tr><% } %>
    </tbody></table></div>
  </section>
<% } %>
