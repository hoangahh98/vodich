<%- include('partials/head', { title: 'Phân quyền' }) %>
<%- include('partials/topbar') %>
<% const featureLabels = { TOURNAMENTS: 'Giải đấu', TEAMS: 'Đội bóng', HOUSEHOLD: 'Chi tiêu', PERMISSIONS: 'Phân quyền' }; %>
<main class="app-shell permissions-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <div class="hero-eyebrow">Quản trị</div>
        <h1>Phân quyền quản trị</h1>
        <div class="muted strong-muted">Admin gốc mặc định có toàn quyền. Chỉ tạo và phân quyền cho các admin phụ tại đây.</div>
      </div>
      <div class="feature-hero-art"><div class="ball3d" aria-hidden="true"></div></div>
    </div>
  </section>

  <section class="card-lite p mb">
    <div class="section-heading mb">
      <div><span class="feature-icon"><%- include('partials/icon', { name: 'plus' }) %></span><h2 class="section-title">Tạo quản trị mới</h2><p class="muted">Thông tin admin đã tạo sẽ được sửa ở phần danh sách bên dưới.</p></div>
    </div>
    <form class="permission-create-form" method="post" action="/admins">
      <div><label>Tài khoản</label><input name="username" placeholder="admin_phu" autocomplete="username" required></div>
      <div><label>Tên hiển thị</label><input name="displayName" placeholder="Tên hiển thị"></div>
      <div><label>Mật khẩu</label><input name="password" placeholder="Mật khẩu" value="123456789" autocomplete="new-password"></div>
      <div class="permission-create-action"><button class="btn btn-success" data-loading-text="Đang tạo...">Tạo quản trị</button></div>
    </form>
  </section>

  <section class="card-lite p">
    <div class="section-heading mb">
      <div><span class="feature-icon"><%- include('partials/icon', { name: 'shield' }) %></span><h2 class="section-title">Sửa admin và quyền</h2><p class="muted">Sửa thông tin, chọn quyền cho tất cả admin phụ rồi lưu một lần.</p></div>
      <span class="badge"><%= admins.length %> admin phụ</span>
    </div>
    <% if (!admins.length) { %>
      <p class="muted">Chưa có admin phụ nào.</p>
    <% } else { %>
      <form method="post" action="/permissions">
        <div class="permission-admin-list">
          <% admins.forEach((admin) => { %>
            <section class="permission-admin-card">
              <div class="permission-admin-info">
                <div><label>Tài khoản</label><input name="username_<%= admin.id %>" value="<%= admin.username %>" required></div>
                <div><label>Tên hiển thị</label><input name="displayName_<%= admin.id %>" value="<%= admin.displayName %>" required></div>
                <div><label>Mật khẩu mới</label><input name="password_<%= admin.id %>" placeholder="Để trống nếu không đổi" autocomplete="new-password"></div>
              </div>
              <div class="permission-feature-grid">
                <% features.forEach((feature) => { const checked = admin.permissions.some((p) => p.feature === feature); %>
                  <label class="option-card"><input type="checkbox" name="features_<%= admin.id %>" value="<%= feature %>" <%= checked ? 'checked' : '' %>> <span><%= featureLabels[feature] || feature %></span></label>
                <% }) %>
              </div>
              <div class="permission-admin-actions"><button class="btn btn-sm btn-danger" type="submit" form="deleteAdmin_<%= admin.id %>" data-loading-text="Đang xoá..."><%- include('partials/icon', { name: 'trash' }) %> Xoá tài khoản</button></div>
            </section>
          <% }) %>
        </div>
        <div class="mt text-right"><button class="btn btn-primary" data-loading-text="Đang lưu..."><%- include('partials/icon', { name: 'save' }) %> Lưu tất cả quyền</button></div>
      </form>
      <%# Form xoá đứng ngoài form lưu quyền (không lồng form); giải/đội người này tạo vẫn còn, chỉ mất chủ. %>
      <% admins.forEach((admin) => { %><form id="deleteAdmin_<%= admin.id %>" method="post" action="/admins/<%= admin.id %>/delete" data-confirm="Xoá tài khoản <%= admin.username %>? Giải và đội người này tạo vẫn giữ nguyên, chỉ không còn chủ sở hữu."></form><% }) %>
    <% } %>
  </section>
</main>
<%- include('partials/bottom-menu') %>
