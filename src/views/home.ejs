<%- include('partials/head', { title: 'Trang chủ' }) %>
<%- include('partials/topbar') %>
<main class="app-shell">
  <section class="feature-hero home-hero mb">
    <div>
      <div class="hero-eyebrow">Pickleball · Livescore realtime</div>
      <h1>Vô địch</h1>
      <p class="hero-sub">Giải đấu, đội bóng, quỹ tháng, bảng xếp hạng và tỉ số trực tiếp — tất cả trong một chỗ, gọn trên điện thoại.</p>
      <div class="hero-chips">
        <% if (currentUser) { %><span class="chip lime"><%- include('partials/icon', { name: 'user' }) %><%= currentUser.displayName %></span><% } %>
        <span class="chip"><%- include('partials/icon', { name: 'bolt' }) %>Cập nhật tức thì</span>
      </div>
    </div>
    <div class="ball3d" aria-hidden="true"></div>
  </section>

  <div class="home-section-title">Chức năng</div>
  <div class="grid module-grid">
    <% if (featureSet.has('TOURNAMENTS')) { %><a class="card-lite module-card home-tile ht-tour" href="/tournaments"><div class="module-icon"><%- include('partials/icon', { name: 'trophy' }) %></div><h3>Giải đấu</h3><p class="muted">Thành viên, quỹ, BXH, thi đấu, đóng phí.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a><% } %>
    <% if (featureSet.has('TEAMS')) { %><a class="card-lite module-card home-tile ht-team" href="/teams"><div class="module-icon"><%- include('partials/icon', { name: 'ball' }) %></div><h3>Đội bóng</h3><p class="muted">Thành viên và quỹ tháng.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a><% } %>
    <% if (currentUser && currentUser.role === 'ADMIN' && (featureSet.has('TOURNAMENTS') || featureSet.has('TEAMS'))) { %><a class="card-lite module-card home-tile ht-member" href="/players"><div class="module-icon"><%- include('partials/icon', { name: 'users' }) %></div><h3>Thành viên</h3><p class="muted">Danh sách thành viên dùng chung.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a><% } %>
    <% if (currentUser && currentUser.role === 'ADMIN' && (featureSet.has('TOURNAMENTS') || featureSet.has('TEAMS'))) { %><a class="card-lite module-card home-tile ht-group" href="/groups"><div class="module-icon"><%- include('partials/icon', { name: 'users' }) %></div><h3>Nhóm thành viên</h3><p class="muted">Gom người hay chơi chung, tạo đội một cú tích.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a><% } %>
    <a class="card-lite module-card home-tile ht-games" href="/games"><div class="module-icon"><%- include('partials/icon', { name: 'gamepad' }) %></div><h3>Học vui</h3><p class="muted">Game Toán &amp; Tiếng Anh cho bé.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a>
    <% if (featureSet.has('PERMISSIONS')) { %><a class="card-lite module-card home-tile ht-perm" href="/permissions"><div class="module-icon"><%- include('partials/icon', { name: 'lock' }) %></div><h3>Phân quyền</h3><p class="muted">Cấp quyền module cho admin.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a><% } %>
    <% if (isRoot) { %><a class="card-lite module-card home-tile ht-log" href="/logs"><div class="module-icon"><%- include('partials/icon', { name: 'log' }) %></div><h3>Theo dõi log</h3><p class="muted">Theo dõi thao tác và lỗi.</p><span class="card-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></a><% } %>
  </div>
</main>
<%- include('partials/bottom-menu') %>
