<%- include('../partials/head', { title: 'Theo dõi log' }) %>
<%- include('../partials/topbar') %>
<%
  const levelLabels = { ERROR: 'Lỗi', WARN: 'Cảnh báo', INFO: 'Thông tin', ALL: 'Tất cả' };
  const roleLabels = { ADMIN: 'Quản trị', CLIENT: 'Khách xem' };
  const categoryLabels = { ALL: 'Tất cả', HTTP: 'Truy cập', REDIS: 'Redis' };
  // Mọi link lọc phải mang theo CẢ BA tham số, không thì bấm đổi mức là âm thầm reset
  // tài khoản đang lọc về "tất cả" — nhìn tưởng vẫn đang soi một người.
  const filterUrl = (over) => {
    const q = new URLSearchParams({ level, category, user, ...over });
    return `/logs?${q.toString()}`;
  };
  // Tài khoản đang lọc mà không có dòng log nào thì vẫn phải nằm trong ô chọn — thiếu nó thì
  // ô chọn hiện tên NGƯỜI KHÁC trong khi bảng đang lọc theo người này.
  const userChoices = users.some((item) => item.value === user) ? users : [...users, { value: user, label: `${user} (không có log)` }];
%>
<main class="app-shell">
  <section class="card-lite p mb">
    <div class="flex between center">
      <div>
        <h1>Theo dõi log hệ thống</h1>
        <p class="muted">Thời gian hiển thị theo giờ Việt Nam.</p>
      </div>
      <div class="flex gap">
        <% levels.forEach((item) => { %>
          <a class="btn btn-sm <%= level === item ? 'btn-primary' : '' %>" href="<%= filterUrl({ level: item }) %>"><%= levelLabels[item] || item %></a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="card-lite p mb">
    <div class="flex gap center">
      <strong>Nhóm log</strong>
      <% categories.forEach((item) => { %>
        <%# Redis log không gắn với mức nào nên chọn nhóm đó thì mở mức về "tất cả", giữ nguyên hành vi cũ. %>
        <a class="btn btn-sm <%= category === item ? 'btn-primary' : '' %>" href="<%= filterUrl({ category: item, level: item === 'REDIS' ? 'ALL' : level }) %>"><%= categoryLabels[item] || item %></a>
      <% }) %>
    </div>
  </section>

  <%# Lọc theo tài khoản. Dùng ô chọn chứ không phải hàng nút như hai bộ lọc trên: số tài khoản
      tăng theo thời gian, mà tên là email nên hàng nút sẽ tràn ngang trên điện thoại. %>
  <section class="card-lite p mb">
    <form class="flex gap center" method="get" action="/logs">
      <input type="hidden" name="level" value="<%= level %>">
      <input type="hidden" name="category" value="<%= category %>">
      <strong>Tài khoản</strong>
      <select name="user" data-autosubmit>
        <% userChoices.forEach((item) => { %>
          <option value="<%= item.value %>" <%= user === item.value ? 'selected' : '' %>><%= item.label %></option>
        <% }) %>
      </select>
      <noscript><button class="btn btn-sm btn-primary">Lọc</button></noscript>
      <% if (user !== 'ALL') { %>
        <a class="btn btn-sm" href="<%= filterUrl({ user: 'ALL' }) %>">Bỏ lọc</a>
      <% } %>
    </form>
  </section>

  <section class="card-lite table-wrap log-table-wrap">
    <table class="log-table">
      <thead>
        <tr>
          <th>Thời gian</th>
          <th>Mức</th>
          <th>Tài khoản</th>
          <th>Thao tác</th>
          <th>Yêu cầu</th>
          <th>Chi tiết</th>
          <th>Lỗi</th>
        </tr>
      </thead>
      <tbody>
        <% logs.forEach((log) => { const created = new Date(log.createdAt); const vn = created.toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour12: false }); %>
          <tr>
            <td><%= vn %></td>
            <td><span class="badge <%= log.level === 'ERROR' ? 'badge-danger' : (log.level === 'WARN' ? 'badge-warn' : '') %>"><%= levelLabels[log.level] || log.level %></span></td>
            <td><%= log.username || 'Chưa đăng nhập' %><br><span class="muted"><%= roleLabels[log.userRole] || '' %></span></td>
            <td><strong><%= categoryLabels[log.category] || log.category %></strong><br><%= log.action %></td>
            <td><%= log.method || '' %> <%= log.path || '' %><br><span class="muted"><%= log.statusCode || '-' %> · <%= log.durationMs || '-' %>ms</span></td>
            <td><%= log.details || '' %></td>
            <td class="muted"><%= log.errorMessage || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <%# Không có dòng nào thì phải NÓI ra. Bảng rỗng trơn trông hệt như log chưa tải xong. %>
    <% if (!logs.length) { %>
      <p class="muted text-center p">Không có dòng log nào khớp bộ lọc đang chọn.</p>
    <% } %>
  </section>
</main>
<%- include('../partials/bottom-menu') %>
