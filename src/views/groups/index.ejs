<%- include('../partials/head', { title: 'Nhóm thành viên' }) %>
<%- include('../partials/topbar') %>
<main class="app-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <div class="hero-eyebrow">Thành viên</div>
        <h1>Nhóm thành viên</h1>
        <div class="muted strong-muted">Gom sẵn người hay chơi chung. Thành viên đội bóng đi theo nhóm: thêm người vào nhóm là vào đội, đưa ra khỏi nhóm là rời đội (từ tháng hiện tại). Giải đấu thì chọn nhóm lúc thêm người.</div>
      </div>
      <div class="feature-hero-art"><div class="ball3d" aria-hidden="true"></div></div>
    </div>
  </section>

  <section class="card-lite p mb">
    <div class="section-heading mb"><div><span class="feature-icon"><%- include('../partials/icon', { name: 'plus' }) %></span><h2 class="section-title">Tạo nhóm</h2></div></div>
    <form class="team-create-form" method="post" action="/groups">
      <div><label>Tên nhóm</label><input name="name" placeholder="Ví dụ: Hội tối thứ 3" required></div>
      <div class="team-create-action"><button class="btn btn-success" data-loading-text="Đang tạo...">Tạo nhóm</button></div>
    </form>
  </section>

  <% if (!groups.length) { %>
    <section class="card-lite empty-state"><%- include('../partials/icon', { name: 'users' }) %><p>Chưa có nhóm nào.</p></section>
  <% } %>
  <div class="grid module-grid">
    <% groups.forEach((group) => { %>
      <a class="card-lite module-card group-tile" href="/groups/<%= group.id %>">
        <div class="module-icon"><%- include('../partials/icon', { name: 'users' }) %></div>
        <h3><%= group.name %></h3>
        <div class="card-meta">
          <span><%- include('../partials/icon', { name: 'user' }) %> <strong><%= group.members.length %></strong>&nbsp;người<% if (group.members.length) { %>: <%= group.members.slice(0, 3).map((m) => m.player.displayName).join(', ') %><%= group.members.length > 3 ? '…' : '' %><% } %></span>
          <span><%- include('../partials/icon', { name: 'ball' }) %> <% if (group.teams.length) { %>Đội: <%= group.teams.map((link) => link.team.name).join(', ') %><% } else { %>Chưa gắn đội nào<% } %></span>
        </div>
        <span class="card-arrow"><%- include('../partials/icon', { name: 'arrow' }) %></span>
      </a>
    <% }) %>
  </div>
</main>
<%- include('../partials/bottom-menu') %>
