<%- include('../partials/head', { title: 'Nhóm thành viên' }) %>
<%- include('../partials/topbar') %>
<main class="app-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <div class="hero-eyebrow">Thành viên</div>
        <h1>Nhóm thành viên</h1>
        <div class="muted strong-muted">Gom sẵn người hay chơi chung. Thành viên đội bóng đi theo nhóm: thêm người vào nhóm là vào đội, đưa ra khỏi nhóm là rời đội (từ tháng hiện tại). Giải đấu thì chọn nhóm lúc thêm người.</div>
      </div>
      <div class="feature-hero-art"><div class="ball3d" aria-hidden="true"></div></div>
    </div>
  </section>

  <section class="card-lite p mb">
    <div class="section-heading mb"><div><span class="feature-icon"><%- include('../partials/icon', { name: 'plus' }) %></span><h2 class="section-title">Tạo nhóm</h2></div></div>
    <form class="team-create-form" method="post" action="/groups">
      <div><label>Tên nhóm</label><input name="name" placeholder="Ví dụ: Hội tối thứ 3" required></div>
      <div class="team-create-action"><button class="btn btn-success" data-loading-text="Đang tạo...">Tạo nhóm</button></div>
    </form>
  </section>

  <% if (!groups.length) { %>
    <section class="card-lite empty-state"><%- include('../partials/icon', { name: 'users' }) %><p>Chưa có nhóm nào.</p></section>
  <% } %>
  <% groups.forEach((group) => { const memberIds = new Set(group.members.map((m) => m.playerId.toString())); const candidates = players.filter((p) => !memberIds.has(p.id.toString())); %>
    <section class="card-lite mb" id="group-<%= group.id %>">
      <div class="card-hdr blue"><span><%- include('../partials/icon', { name: 'users' }) %> <%= group.name %></span><span class="badge badge-dark"><%= group.members.length %> người</span></div>
      <div class="p">
        <% if (group.teams.length) { %>
          <div class="hero-chips mb" style="margin-top:0">
            <% group.teams.forEach((link) => { %><a class="badge badge-teal" href="/teams/<%= link.team.id %>/members"><%- include('../partials/icon', { name: 'ball' }) %> <%= link.team.name %></a><% }) %>
          </div>
        <% } else { %>
          <p class="muted">Chưa đội bóng nào dùng nhóm này.</p>
        <% } %>
        <div class="group-members mb">
          <% group.members.forEach((member) => { %>
            <form class="group-member" method="post" action="/groups/<%= group.id %>/members/<%= member.playerId %>/delete" data-confirm="Đưa <%= member.player.displayName %> ra khỏi nhóm? Người này sẽ rời các đội đang dùng nhóm từ tháng này (trừ khi còn ở nhóm khác của đội đó); tháng cũ giữ nguyên.">
              <span><strong><%= member.player.displayName %></strong><small class="muted"><%= member.player.skillLevel ? ' · ' + member.player.skillLevel : '' %></small></span>
              <button class="group-member-remove" title="Bỏ khỏi nhóm (rời luôn các đội dùng nhóm này)" aria-label="Bỏ khỏi nhóm" data-loading-text="…"><%- include('../partials/icon', { name: 'x' }) %></button>
            </form>
          <% }) %>
          <% if (!group.members.length) { %><span class="muted">Nhóm trống — thêm người bên dưới.</span><% } %>
        </div>
        <details class="manual-pair-box mb">
          <summary><%- include('../partials/icon', { name: 'plus' }) %> Thêm người vào nhóm</summary>
          <form method="post" action="/groups/<%= group.id %>/members" data-require-checked="playerIds" class="mt">
            <div class="player-check-list mb">
              <% candidates.forEach((p) => { %>
                <label><input type="checkbox" name="playerIds" value="<%= p.id %>"><span><strong><%= p.displayName %></strong><small><%= p.email %> · <%= p.skillLevel || 'Chưa chọn trình' %></small></span></label>
              <% }) %>
              <% if (!candidates.length) { %><div class="muted p">Mọi thành viên đã ở trong nhóm.</div><% } %>
            </div>
            <button class="btn btn-primary" data-loading-text="Đang thêm..."><%- include('../partials/icon', { name: 'check' }) %> Thêm đã chọn<% if (group.teams.length) { %> (tự vào <%= group.teams.length %> đội)<% } %></button>
          </form>
        </details>
        <div class="text-right">
          <form method="post" action="/groups/<%= group.id %>/delete" data-confirm="Xoá nhóm này? Người chỉ thuộc nhóm này sẽ rời các đội đang dùng nhóm từ tháng này; tháng cũ giữ nguyên."><button class="btn btn-sm btn-danger" data-loading-text="Đang xoá..."><%- include('../partials/icon', { name: 'trash' }) %> Xoá nhóm</button></form>
        </div>
      </div>
    </section>
  <% }) %>
</main>
<%- include('../partials/bottom-menu') %>
