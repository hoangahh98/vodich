<section class="form-section">
  <h2 class="section-title mb"><%- include('../../partials/icon', { name: 'puzzle' }) %> Thể thức thi đấu</h2>
  <div class="row mb">
    <div class="col-12"><label>Loại đấu</label><select name="playType"><option value="DOUBLES" <%= (tournament?.playType || 'DOUBLES') === 'DOUBLES' ? 'selected' : '' %>>Thi đôi</option><option value="SINGLES" <%= tournament?.playType === 'SINGLES' ? 'selected' : '' %>>Thi đơn</option></select><span class="field-hint">Vòng tròn và đánh bảng đều chọn được đội thủ công hoặc bốc bằng vòng quay, thi đôi lẫn thi đơn.</span></div>
  </div>
  <div class="segmented segmented-3">
    <label><input type="radio" name="format" value="ROUND_ROBIN" <%= (tournament?.format || 'ROUND_ROBIN') === 'ROUND_ROBIN' ? 'checked' : '' %>> Vòng tròn</label>
    <label><input type="radio" name="format" value="GROUP_KNOCKOUT" <%= tournament?.format === 'GROUP_KNOCKOUT' ? 'checked' : '' %>> Đánh bảng + vòng trong</label>
    <label><input type="radio" name="format" value="AMERICANO" <%= tournament?.format === 'AMERICANO' ? 'checked' : '' %>> Đôi xoay vòng</label>
  </div>
  <p class="muted mt" id="americanoNote">Đôi xoay vòng: chia hai bên, mỗi người lần lượt đánh chung đội với từng người bên kia (phân trình: bên mạnh đi với bên yếu; không phân trình: xáo ngẫu nhiên). Số cặp mỗi vòng lẻ (10, 14 người) thì mỗi vòng một cặp nghỉ, ai cũng nghỉ đúng một lần để số trận bằng nhau. Xếp hạng theo từng cá nhân. Luôn là đánh đôi, không ghép đội thủ công.</p>
  <div id="knockoutQualifierField" class="mt" data-expected-players="<%= tournament?.expectedPlayers || 10 %>">
    <input type="hidden" name="knockoutQualifierCount" id="knockoutQualifierCount" value="<%= tournament?.knockoutQualifierCount || 2 %>">
    <div class="knockout-option-grid">
      <div>
        <label class="option-card" data-ko-card="2"><input type="checkbox" id="knockoutFinal" data-value="2" data-min-teams="4" checked> Chung kết <small>Lấy 2 đội</small></label>
      </div>
      <div>
        <label class="option-card" data-ko-card="4"><input type="checkbox" id="knockoutSemi" data-value="4" data-min-teams="6" <%= (tournament?.knockoutQualifierCount || 2) >= 4 ? 'checked' : '' %>> Bán kết <small>Lấy 4 đội</small></label>
      </div>
      <div>
        <label class="option-card" data-ko-card="8"><input type="checkbox" id="knockoutQuarter" data-value="8" data-min-teams="12" <%= (tournament?.knockoutQualifierCount || 2) >= 8 ? 'checked' : '' %>> Tứ kết <small>Lấy 8 đội</small></label>
      </div>
    </div>
    <p class="muted mt">Bán kết cần từ 4 đội, tứ kết cần từ 8 đội. Nếu số đội qua vòng bảng ít hơn số suất vòng knockout đã chọn, hệ thống sẽ gợi ý và cho phép ban tổ chức chọn bổ sung đội (wildcard).</p>
    <div class="row mt">
      <div class="col-6"><label>Số bảng đấu (tùy chọn)</label><input type="number" name="groupCount" min="1" max="16" placeholder="Tự động theo số đội" value="<%= tournament?.groupCount || '' %>"><span class="field-hint">Để trống để hệ thống tự tính</span></div>
      <div class="col-6"><label>Số đội lấy mỗi bảng</label><input type="number" name="advancePerGroup" min="1" max="8" placeholder="Mặc định: 2" value="<%= tournament?.advancePerGroup || '' %>"><span class="field-hint">Số đội vào thẳng vòng trong</span></div>
    </div>
    <div class="row mt">
      <div class="col-6" id="quarterDrawMethodGroup">
        <label>Ghép cặp Tứ kết</label>
        <select name="quarterDrawMethod">
          <option value="FIXED" <%= (tournament?.quarterDrawMethod || 'FIXED') === 'FIXED' ? 'selected' : '' %>>Nhánh cố định (theo hạt giống bảng)</option>
          <option value="WHEEL" <%= tournament?.quarterDrawMethod === 'WHEEL' ? 'selected' : '' %>>Quay vòng tròn bốc thăm</option>
        </select>
        <span class="field-hint">Cách chia 4 cặp Tứ kết (8 đội)</span>
      </div>
      <div class="col-6" id="semiDrawMethodGroup">
        <label>Ghép cặp Bán kết</label>
        <select name="semiDrawMethod">
          <option value="FIXED" <%= (tournament?.semiDrawMethod || 'FIXED') === 'FIXED' ? 'selected' : '' %>>Nhánh cố định (TK 1-2, TK 3-4)</option>
          <option value="WHEEL" <%= tournament?.semiDrawMethod === 'WHEEL' ? 'selected' : '' %>>Quay vòng tròn bốc thăm</option>
        </select>
        <span class="field-hint">Cách chia 2 cặp Bán kết (4 đội)</span>
      </div>
    </div>
    <div class="row mt">
      <div class="col-12">
        <label class="option-card"><input type="checkbox" name="hasThirdPlace" <%= tournament?.hasThirdPlace !== false ? 'checked' : '' %>> Tranh hạng 3-4 <small>2 đội thua bán kết thi đấu</small></label>
      </div>
    </div>
    <div class="row mt">
      <div class="col-6"><label>Chạm điểm vòng trong</label><input type="number" name="knockoutTouchScore" value="<%= tournament?.knockoutTouchScore || 15 %>" min="1"></div>
      <div class="col-6"><label>Max điểm vòng trong</label><input type="number" name="knockoutMaxScore" value="<%= tournament?.knockoutMaxScore || 19 %>" min="1"></div>
    </div>
  </div>

  <div id="pairingRuleField" class="mt">
    <h3 class="section-title mb"><%- include('../../partials/icon', { name: 'scale' }) %> Quy tắc ghép cặp</h3>
    <div class="segmented">
      <label><input type="radio" name="pairingRule" value="BY_SKILL" <%= (tournament?.pairingRule || 'BY_SKILL') !== 'RANDOM' ? 'checked' : '' %>> Phân trình <small>Mạnh ghép yếu cho cân</small></label>
      <label><input type="radio" name="pairingRule" value="RANDOM" <%= tournament?.pairingRule === 'RANDOM' ? 'checked' : '' %>> Không phân trình <small>Bốc ngẫu nhiên</small></label>
    </div>
    <p class="muted mt">Chỉ áp dụng cho đánh đôi. <strong>Phân trình</strong>: gom theo trình rồi ghép mạnh với yếu để các đội cân sức. <strong>Không phân trình</strong>: bỏ qua trình độ, xáo ngẫu nhiên.</p>
  </div>
</section>
