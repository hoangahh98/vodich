  <% if (section === 'fees') { %>
    <% const isFeeAdmin = currentUser.role === 'ADMIN'; const paidCount = registrations.filter((r) => r.paymentStatus === 'PAID').length; const feeName = (r) => (r.player ? r.player.displayName : r.externalName); %>
    <section class="card-lite p mb">
      <div class="section-heading">
        <div><span class="feature-icon"><%- include('../../partials/icon', { name: 'card' }) %></span><h2 class="section-title">Đóng phí</h2><p class="muted">Lệ phí <%= formatMoney(minimumFee) %>đ/người. Nhập số tiền đã thu của từng người; đủ lệ phí là dòng xanh, chưa đủ là dòng vàng.</p></div>
        <span class="badge badge-dark"><%= paidCount %>/<%= registrations.length %> đã đóng</span>
      </div>
    </section>

    <% if (isFeeAdmin) { %><form class="card-lite" method="post" action="/tournaments/<%= tournament.id %>/payments"><% } else { %><section class="card-lite"><% } %>
      <div class="card-hdr green"><span><%- include('../../partials/icon', { name: 'users' }) %> Chính thức</span><span class="badge badge-dark">Đã thu <%= formatMoney(totalPaid) %>đ<% if (missingFee > 0) { %> · thiếu <%= formatMoney(missingFee) %>đ<% } %></span></div>
      <div class="table-wrap member-table"><table class="member-list"><thead><tr><th>Tên</th><th class="text-right">Đã thu / lệ phí</th></tr></thead><tbody>
        <% registrations.forEach((r) => { const paid = Number(r.paidAmount || 0); const mine = String(r.player ? r.player.email : r.externalEmail || '').toLowerCase() === currentEmail; %><tr class="<%= r.paymentStatus === 'PAID' ? 'sufficient-row' : 'insufficient-row' %> <%= mine ? 'mine-row' : '' %>"><td><strong><%= feeName(r) %></strong></td><td class="text-right paid-cell"><% if (isFeeAdmin) { %><div class="paid-of"><input class="money-input" name="amount_<%= r.id %>" value="<%= paid > 0 ? formatMoney(paid) : '' %>" placeholder="0" aria-label="Đã thu của <%= feeName(r) %>"><span class="paid-of-fee">/ <%= formatMoney(minimumFee) %>đ</span></div><% } else { %><strong><%= formatMoney(paid) %></strong><span class="muted"> / <%= formatMoney(minimumFee) %>đ</span><% } %><% if (paid > minimumFee) { %> <span class="badge bg-success">+<%= formatMoney(paid - minimumFee) %>đ</span><% } %></td></tr><% }) %>
        <% if (!registrations.length) { %><tr><td colspan="2" class="muted text-center">Chưa có thành viên chính thức.</td></tr><% } %>
      </tbody></table></div>
      <% if (isFeeAdmin) { %><% if (registrations.length) { %><div class="card-foot"><button class="btn btn-outline" name="markAllPaid" value="1" data-loading-text="Đang ghi..."><%- include('../../partials/icon', { name: 'check' }) %> Tất cả đã đóng</button><button class="btn btn-primary" data-loading-text="Đang lưu..."><%- include('../../partials/icon', { name: 'save' }) %> Lưu đóng phí (<%= registrations.length %> người)</button></div><% } %></form><% } else { %></section><% } %>
  <% } %>
