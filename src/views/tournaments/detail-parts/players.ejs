  <% if (section === 'players') { %>
    <section class="card-lite p mb">
      <div class="section-heading mb"><div><span class="feature-icon"><%- include('../../partials/icon', { name: 'users' }) %></span><h2 class="section-title">Thành viên</h2><p class="muted">Quản lý chính thức, dự bị và thao tác nhiều người một lúc.</p></div><span class="badge badge-dark"><%= registrations.length %>/<%= tournament.expectedPlayers %></span></div>
      <% if (currentUser.role === 'ADMIN' && tournament.externalRegistrationEnabled) { %><div class="registration-panel mb"><strong><%- include('../../partials/icon', { name: 'link' }) %> Link đăng ký ngoài</strong><div class="copy-field mt"><input id="externalRegistrationLink" value="<%= externalLink %>" readonly><button class="btn btn-primary" type="button" data-copy-target="externalRegistrationLink"><%- include('../../partials/icon', { name: 'copy' }) %> Copy</button></div></div><% } %>
      <% if (currentUser.role === 'ADMIN') { %>
        <form id="addTournamentPlayersForm" class="mb" method="post" action="/tournaments/<%= tournament.id %>/registrations">
          <% const usedPlayerIds = new Set([...registrations, ...(reserveRegistrations || []), ...withdrawnRegistrations].map((r) => r.playerId && r.playerId.toString()).filter(Boolean)); %>
          <div id="playerSlotHint" class="alert-lite <%= slotsLeft > 0 ? 'info' : 'warn' %> mb" data-slots-left="<%= slotsLeft %>"><span>Còn <strong data-slot-count><%= slotsLeft %></strong> suất chính thức. Đã chọn <strong data-selected-count>0</strong> thành viên.</span></div>
          <% if (typeof groups !== 'undefined' && groups.length) { %>
            <label>Chọn cả nhóm <span class="muted fw-normal">— người trùng nhau giữa các nhóm hoặc với người tích lẻ chỉ tính một lần</span></label>
            <div class="grid module-grid mb">
              <% groups.forEach((group) => { const inTournament = group.members.filter((m) => usedPlayerIds.has(m.playerId.toString())).length; %><label class="option-card"><input type="checkbox" name="groupIds" value="<%= group.id %>"> <span><%= group.name %> <small class="muted">(<%= group.members.length %> người<% if (inTournament) { %>, <%= inTournament %> đã trong giải<% } %>)</small></span></label><% }) %>
            </div>
            <label>Hoặc chọn lẻ</label>
          <% } %>
          <% const freePlayers = players.filter((p) => !usedPlayerIds.has(p.id.toString())); %>
          <% if (freePlayers.length) { %>
            <div class="check-filter mb"><%- include('../../partials/icon', { name: 'search' }) %><input type="search" data-check-filter="tournamentCandidateList" placeholder="Gõ tên hoặc email để tìm…" autocomplete="off" aria-label="Tìm người"><span class="badge" data-check-filter-count><%= freePlayers.length %></span></div>
          <% } %>
          <div class="player-check-list mb" id="tournamentCandidateList" data-player-picker>
            <% freePlayers.forEach((p) => { %>
              <label><input type="checkbox" name="playerId" value="<%= p.id %>"><span><strong><%= p.displayName %></strong><small><%= p.email %> · <%= p.skillLevel || 'Chưa chọn trình' %></small></span></label>
            <% }) %>
            <div class="muted p" data-check-filter-empty hidden>Không có ai khớp.</div>
          </div>
          <button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Thêm thành viên đã chọn</button>
        </form>
      <% } %>
    </section>

    <form class="card-lite mb" method="post" action="/tournaments/<%= tournament.id %>/registrations/bulk" <%= currentUser.role === 'ADMIN' ? 'data-require-checked="registrationIds" data-confirm="Xử lý các thành viên đã chọn?"' : '' %>>
      <div class="card-hdr green"><span><%- include('../../partials/icon', { name: 'users' }) %> Chính thức</span><span class="badge badge-dark"><%= registrations.length %> thành viên</span></div>
      <div class="table-wrap member-table"><table class="member-list"><thead><tr><% if (currentUser.role === 'ADMIN') { %><th class="check-col"><input type="checkbox" data-check-all="[data-active-registration]"></th><% } %><th>Tên</th><th class="text-right">Trình</th></tr></thead><tbody>
        <% registrations.forEach((r) => { const mine = String(r.player ? r.player.email : r.externalEmail || '').toLowerCase() === currentEmail; %><tr class="<%= mine ? 'mine-row' : '' %>"><% if (currentUser.role === 'ADMIN') { %><td class="check-col"><input data-active-registration type="checkbox" name="registrationIds" value="<%= r.id %>"></td><% } %><td><strong><%= r.player ? r.player.displayName : r.externalName %></strong><% if (currentUser.role === 'ADMIN') { %><br><span class="muted"><%= r.player ? r.player.email : r.externalEmail || '-' %></span><% } %><br><span class="muted small"><%= r.source === 'EXTERNAL' ? 'Đăng ký ngoài' : 'Danh sách chung' %></span></td><td class="text-right"><% if (currentUser.role === 'ADMIN' && r.source === 'EXTERNAL') { %><input type="hidden" name="tournamentId" value="<%= tournament.id %>" form="skill-<%= r.id %>"><select name="skillLevel" form="skill-<%= r.id %>" data-autosubmit><option value="" <%= !r.skillLevel ? 'selected' : '' %>>Chưa chọn</option><% ['A','B','C','D'].forEach((level) => { %><option value="<%= level %>" <%= r.skillLevel === level ? 'selected' : '' %>><%= level %></option><% }) %></select><% } else { %><span class="badge"><%= r.skillLevel || '-' %></span><% } %></td></tr><% }) %>
        <% if (!registrations.length) { %><tr><td colspan="<%= currentUser.role === 'ADMIN' ? 3 : 2 %>" class="muted text-center">Chưa có thành viên chính thức.</td></tr><% } %>
      </tbody></table></div>
      <% if (currentUser.role === 'ADMIN' && registrations.length) { %><div class="card-foot"><button class="btn btn-sm" name="bulkAction" value="withdraw" data-loading-text="Đang bỏ giải...">Bỏ giải đã chọn</button><button class="btn btn-sm btn-danger" name="bulkAction" value="delete" data-loading-text="Đang xóa...">Xóa đã chọn</button></div><% } %>
    </form>

    <% if (reserveRegistrations && reserveRegistrations.length) { %>
      <form class="card-lite mb" method="post" action="/tournaments/<%= tournament.id %>/registrations/bulk" <%= currentUser.role === 'ADMIN' ? 'data-require-checked="registrationIds" data-confirm="Xử lý các thành viên dự bị đã chọn?"' : '' %>>
        <div class="card-hdr blue"><span><%- include('../../partials/icon', { name: 'user' }) %> Dự bị</span><span class="badge badge-dark"><%= reserveRegistrations.length %> thành viên</span></div>
        <div class="table-wrap member-table"><table class="member-list"><thead><tr><% if (currentUser.role === 'ADMIN') { %><th class="check-col"><input type="checkbox" data-check-all="[data-reserve-registration]"></th><% } %><th>Tên</th><th class="text-right">Trình</th></tr></thead><tbody>
          <% reserveRegistrations.forEach((r) => { const mine = String(r.player ? r.player.email : r.externalEmail || '').toLowerCase() === currentEmail; %><tr class="insufficient-row <%= mine ? 'mine-row' : '' %>"><% if (currentUser.role === 'ADMIN') { %><td class="check-col"><input data-reserve-registration type="checkbox" name="registrationIds" value="<%= r.id %>"></td><% } %><td><strong><%= r.player ? r.player.displayName : r.externalName %></strong><% if (currentUser.role === 'ADMIN') { %><br><span class="muted"><%= r.player ? r.player.email : r.externalEmail || '-' %></span><% } %><br><span class="muted small"><%= r.source === 'EXTERNAL' ? 'Đăng ký ngoài' : 'Danh sách chung' %></span></td><td class="text-right"><% if (currentUser.role === 'ADMIN' && r.source === 'EXTERNAL') { %><input type="hidden" name="tournamentId" value="<%= tournament.id %>" form="skill-<%= r.id %>"><select name="skillLevel" form="skill-<%= r.id %>" data-autosubmit><option value="" <%= !r.skillLevel ? 'selected' : '' %>>Chưa chọn</option><% ['A','B','C','D'].forEach((level) => { %><option value="<%= level %>" <%= r.skillLevel === level ? 'selected' : '' %>><%= level %></option><% }) %></select><% } else { %><span class="badge"><%= r.skillLevel || '-' %></span><% } %></td></tr><% }) %>
        </tbody></table></div>
        <% if (currentUser.role === 'ADMIN') { %><div class="card-foot"><button class="btn btn-sm" name="bulkAction" value="restore" <%= slotsLeft <= 0 ? 'disabled title="Đã đủ thành viên chính thức"' : '' %> data-loading-text="Đang đưa vào giải...">Đưa vào giải</button><button class="btn btn-sm" name="bulkAction" value="withdraw" data-loading-text="Đang bỏ giải...">Bỏ giải đã chọn</button><button class="btn btn-sm btn-danger" name="bulkAction" value="delete" data-loading-text="Đang xóa...">Xóa đã chọn</button></div><% } %>
      </form>
    <% } %>

    <% if (withdrawnRegistrations.length) { %>
      <section class="card-lite mb">
        <div class="card-hdr warn"><span><%- include('../../partials/icon', { name: 'x' }) %> Bỏ giải</span><span class="badge badge-dark"><%= withdrawnRegistrations.length %> thành viên</span></div>
        <div class="table-wrap member-table"><table class="member-list"><tbody>
          <% withdrawnRegistrations.forEach((r) => { %><tr><td><strong><%= r.player ? r.player.displayName : r.externalName %></strong></td><td class="text-right row-action"><form method="post" action="/registrations/<%= r.id %>/restore"><input type="hidden" name="tournamentId" value="<%= tournament.id %>"><button class="btn btn-sm" data-loading-text="Đang khôi phục..."><%- include('../../partials/icon', { name: 'refresh' }) %> Khôi phục</button></form></td></tr><% }) %>
        </tbody></table></div>
      </section>
    <% } %>

      <% if (currentUser.role === 'ADMIN') { [...registrations, ...(reserveRegistrations || [])].filter((r) => r.source === 'EXTERNAL').forEach((r) => { %><form id="skill-<%= r.id %>" method="post" action="/registrations/<%= r.id %>/skill"></form><% }) } %>
  <% } %>
