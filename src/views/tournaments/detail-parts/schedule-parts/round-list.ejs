<% Array.from(roundMap.entries()).forEach(([round, roundMatches]) => {
  const doneCount = roundMatches.filter((item) => item.status === 'FINISHED').length;
  const courtMap = new Map();
  roundMatches.forEach((match) => {
    const list = courtMap.get(match.courtNumber) || [];
    list.push(match);
    courtMap.set(match.courtNumber, list);
  });
  const courts = Array.from(courtMap.entries());
  const knockoutRound = roundMatches.some((item) => isKnockoutStage(item.stage)) || round >= 100;
%>
  <div class="mb-4" data-round-block>
    <div class="vong-header mb-3 flex between center wrap gap">
      <div>
        <%- include('../../../partials/icon', { name: knockoutRound ? 'trophy' : 'refresh' }) %>
        <%= roundTitle(round, roundMatches) %> — <%= roundMatches.length %> trận
        <small>(<span data-done-count><%= doneCount %></span> đã xong)</small>
      </div>
      <% if (currentUser && currentUser.role === 'ADMIN' && tournament.format === 'GROUP_KNOCKOUT') { %>
        <%# 1. Bốc thăm Bán kết: Chỉ hiển thị khi cấu hình Bán kết là WHEEL (Quay vòng tròn bốc thăm) %>
        <% if ((round === 101 || roundMatches.some((m) => m.stage === 'Bán kết')) && tournament.semiDrawMethod === 'WHEEL') { %>
          <%
            const qfMatchesList = matches.filter((m) => m.stage === 'Tứ kết');
            const qfAllFinished = qfMatchesList.length > 0 && qfMatchesList.every((m) => m.status === 'FINISHED');
            const isDirectFromGroup = tournament.knockoutQualifierCount === 4 && matches.filter((m) => m.stage === 'Vòng bảng').length > 0 && matches.filter((m) => m.stage === 'Vòng bảng').every((m) => m.status === 'FINISHED');
            const sfNotPlayed = !roundMatches.some((m) => m.status === 'FINISHED' || m.scoreA > 0 || m.scoreB > 0);
          %>
          <% if ((qfAllFinished || isDirectFromGroup) && sfNotPlayed) { %>
            <%
              let sfTeamsList = [];
              if (qfAllFinished) {
                sfTeamsList = qfMatchesList.map((m) => (m.scoreA > m.scoreB ? m.teamA : m.teamB)).filter(Boolean);
              } else if (isDirectFromGroup && typeof wildcardStatus !== 'undefined' && wildcardStatus) {
                sfTeamsList = !wildcardStatus.hasShortage ? wildcardStatus.directlyQualified : (wildcardStatus.currentWildcards.length === wildcardStatus.shortage ? [...wildcardStatus.directlyQualified, ...wildcardStatus.currentWildcards] : []);
              }
            %>
            <% if (sfTeamsList.length >= 4) { %>
              <div>
                <button type="button" class="btn btn-warning btn-sm" data-open-ko-draw data-stage="Bán kết" data-action="/tournaments/<%= tournament.id %>/advance-semifinals" data-teams="<%= JSON.stringify(sfTeamsList) %>">
                  <%- include('../../../partials/icon', { name: 'wheel' }) %> Bốc thăm Bán kết (Vòng quay)
                </button>
              </div>
            <% } %>
          <% } %>
        <% } %>

        <%# 2. Bốc thăm Tứ kết: Chỉ hiển thị khi cấu hình Tứ kết là WHEEL (Quay vòng tròn bốc thăm) %>
        <% if ((round === 100 || roundMatches.some((m) => m.stage === 'Tứ kết')) && tournament.quarterDrawMethod === 'WHEEL') { %>
          <%
            const groupAllFinished = matches.filter((m) => m.stage === 'Vòng bảng').length > 0 && matches.filter((m) => m.stage === 'Vòng bảng').every((m) => m.status === 'FINISHED');
            const qfNotPlayed = !roundMatches.some((m) => m.status === 'FINISHED' || m.scoreA > 0 || m.scoreB > 0);
            const hasWsData = typeof wildcardStatus !== 'undefined' && wildcardStatus;
          %>
          <% if (groupAllFinished && qfNotPlayed && hasWsData) { %>
            <%
              let qfTeamsList = [];
              if (!wildcardStatus.hasShortage) {
                qfTeamsList = wildcardStatus.directlyQualified;
              } else if (wildcardStatus.currentWildcards.length === wildcardStatus.shortage) {
                qfTeamsList = [...wildcardStatus.directlyQualified, ...wildcardStatus.currentWildcards];
              }
            %>
            <% if (qfTeamsList.length >= 8) { %>
              <div>
                <button type="button" class="btn btn-warning btn-sm" data-open-ko-draw data-stage="Tứ kết" data-action="/tournaments/<%= tournament.id %>/stage-draw" data-teams="<%= JSON.stringify(qfTeamsList.slice(0, 8)) %>">
                  <%- include('../../../partials/icon', { name: 'wheel' }) %> Bốc thăm Tứ kết (Vòng quay)
                </button>
              </div>
            <% } %>
          <% } %>
        <% } %>
      <% } %>
    </div>
    <div class="grid courts-grid">
      <% courts.forEach(([court, courtMatches]) => { %>
        <div class="court-column">
          <div class="border rounded p-2 h-100">
            <div class="court-title"><%- include('../../../partials/icon', { name: 'court' }) %> Sân <%= court %></div>
            <% courtMatches.forEach((m) => { const knockout = isKnockoutStage(m.stage); const done = m.status === 'FINISHED'; %>
              <div class="tran-card rounded p-2 mb-2 <%= done ? 'da-xong' : '' %> <%= knockout ? 'knockout' : '' %> <%= isMine(m.teamA) || isMine(m.teamB) ? 'mine-card' : '' %>" tabindex="0" data-match-id="<%= m.id %>" data-team-a="<%= m.teamA %>" data-team-b="<%= m.teamB %>" data-score-a="<%= m.scoreA %>" data-score-b="<%= m.scoreB %>" data-score-order="<%= m.scoreOrder || 2 %>" data-serving-team="<%= m.servingTeam || 'A' %>" data-knockout="<%= knockout ? 'true' : 'false' %>">
                <div class="match-meta">
                  <% if (m.stage === 'Vòng bảng') { %>
                    <span class="badge bg-success">Lượt <%= round %></span>
                    <span class="badge bg-info text-dark">Bảng <%= m.groupName || 'A' %></span>
                  <% } else if (knockout) { %>
                    <span class="badge bg-danger"><%= m.stage %></span>
                  <% } else { %>
                    <span class="badge bg-primary">Vòng <%= round %></span>
                  <% } %>
                  <span class="badge bg-secondary">Sân <%= court %></span>
                </div>
                <div class="match-grid">
                  <div class="team-name">
                    <% String(m.teamA).split(/\s*\/\s*/).forEach((name) => { %><span><%= name %></span><% }) %>
                  </div>
                  <div class="score-section">
                    <span class="badge <%= done ? 'bg-success' : 'bg-primary' %> px-2 py-1 score-pill">
                      <span class="score-a"><%= m.scoreA %></span> – <span class="score-b"><%= m.scoreB %></span><% if (tournament.playType === 'DOUBLES') { %> - <span class="score-order"><%= m.scoreOrder || 2 %></span><% } %>
                    </span>
                    <span class="badge <%= done ? 'bg-success' : 'bg-secondary' %> match-status"><%= done ? 'Đã xong' : 'Đang đánh' %></span>
                    <% if (currentUser.role === 'ADMIN') { %><small class="muted">Bấm thẻ để ghi điểm</small><% } %>
                  </div>
                  <div class="team-name text-end">
                    <% String(m.teamB).split(/\s*\/\s*/).forEach((name) => { %><span><%= name %></span><% }) %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
<% }) %>
