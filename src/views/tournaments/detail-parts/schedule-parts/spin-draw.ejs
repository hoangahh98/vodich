<%#
  Vòng quay chia trận cho thể thức đội cố định (vòng tròn / đánh bảng), cả thi đôi lẫn thi đơn.
  Thi đôi: mỗi đội quay hai lần (hai người). Thi đơn: mỗi lượt quay bốc một người. Đánh bảng:
  bốc tới đâu xếp bảng tới đó (đội 1 vào A, đội 2 vào B, ...) và gửi kèm `group_i`.

  Dữ liệu VĐV đi qua thuộc tính data-* chứ không phải thẻ <script> nhúng: CSP đặt
  script-src 'self' nên mọi script inline đều bị chặn (xem src/main.ts).

  Kết quả quay gửi về đúng endpoint ghép cặp thủ công đã có sẵn
  (POST /tournaments/:id/manual-schedule), không cần route riêng.
%>
<% if (currentUser.role === 'ADMIN' && tournament.format !== 'AMERICANO') { %>
  <%
    const spinDoubles = tournament.playType === 'DOUBLES';
    const spinGroupCount = typeof manualGroupCount !== 'undefined' ? Number(manualGroupCount) || 1 : 1;
    const spinPlayers = registrations.map((reg) => ({
      name: reg.player ? reg.player.displayName : (reg.externalName || reg.externalEmail || 'Chưa đặt tên'),
      skill: reg.skillLevel || '',
    }));
  %>
  <div class="score-modal hidden" id="spinDrawModal" data-spin-modal
       data-players="<%= JSON.stringify(spinPlayers) %>"
       data-tournament-id="<%= tournament.id %>"
       data-play-type="<%= spinDoubles ? 'DOUBLES' : 'SINGLES' %>"
       data-group-count="<%= spinGroupCount %>"
       data-rule="<%= tournament.pairingRule || 'BY_SKILL' %>">
    <div class="score-modal-backdrop" data-spin-close></div>
    <div class="score-modal-panel">
      <div class="score-modal-head">
        <div>
          <h3><%- include('../../../partials/icon', { name: 'wheel' }) %> Vòng quay chia trận</h3>
          <small data-spin-hint></small>
        </div>
        <div class="score-modal-head-actions">
          <button type="button" class="btn btn-sm" data-spin-reset>Làm lại</button>
          <button type="button" class="btn btn-sm" data-spin-close>Đóng</button>
        </div>
      </div>
      <div class="score-modal-body">
        <div class="wheel-stage">
          <div class="wheel-pool" data-spin-pool></div>
          <div class="wheel-box">
            <div class="wheel-pointer" aria-hidden="true"></div>
            <div class="wheel-rotor" data-spin-wheel></div>
          </div>
          <div class="spin-picked" data-spin-picked></div>
        </div>
        <div class="spin-actions">
          <button type="button" class="btn btn-primary" data-spin-once><%- include('../../../partials/icon', { name: 'wheel' }) %> Quay</button>
          <button type="button" class="btn btn-success" data-spin-all><%- include('../../../partials/icon', { name: 'bolt' }) %> Bốc nhanh phần còn lại</button>
        </div>
        <div class="spin-results-box">
          <h4 class="spin-results-title"><%= spinDoubles ? 'Đội đã bốc' : 'Đã bốc' %> <span class="badge bg-primary rounded-pill" data-spin-total>0</span></h4>
          <ol class="spin-results" data-spin-results></ol>
        </div>
        <form method="post" action="/tournaments/<%= tournament.id %>/manual-schedule" class="spin-apply hidden" data-spin-form>
          <input type="hidden" name="pairCount" value="0" data-spin-count>
          <div data-spin-inputs></div>
          <button class="btn btn-success spin-apply-btn" data-loading-text="Đang chia..."><%- include('../../../partials/icon', { name: 'check' }) %> Chốt danh sách này &amp; chia trận</button>
          <p class="muted">Bấm nút này sẽ xoá lịch thi đấu cũ và chia lại theo các đội vừa bốc.</p>
        </form>
      </div>
    </div>
  </div>
<% } %>
