<div class="section-heading mb">
  <div><span class="feature-icon"><%- include('../../../partials/icon', { name: 'calendar' }) %></span><h2 class="section-title">Thi đấu</h2><p class="muted"><% if (tournament.format === 'GROUP_KNOCKOUT') { %>Vào vòng trong: <%= tournament.knockoutQualifierCount %> đội<% } else { %>Bấm vào thẻ trận để mở màn ghi điểm.<% } %></p></div>
  <% if (currentUser.role === 'ADMIN') { %>
    <div class="schedule-actions">
      <form method="post" action="/tournaments/<%= tournament.id %>/generate-schedule"><button class="btn btn-primary" data-loading-text="Đang chia..."><%- include('../../../partials/icon', { name: 'bolt' }) %> Chia trận</button></form>
      <%# Vòng quay chỉ có nghĩa với thể thức dựng đội cố định. Americano tự đổi cặp mỗi vòng nên không có gì để quay. %>
      <% if (tournament.playType === 'DOUBLES' && tournament.format !== 'AMERICANO') { %>
        <button type="button" class="btn btn-warning" data-spin-open><%- include('../../../partials/icon', { name: 'wheel' }) %> Vòng quay</button>
      <% } %>
    </div>
  <% } %>
</div>
