<%#
  Chọn đội thủ công cho thể thức đội cố định (vòng tròn / đánh bảng), cả thi đôi lẫn thi đơn.
  Thi đôi: mỗi ô hai người. Thi đơn: mỗi ô một người. Đánh bảng: thêm ô chọn bảng cho từng đội.
  Đôi xoay vòng tự đổi cặp mỗi vòng nên không có đội cố định để ghép tay — không hiện ở đó.
%>
<% if (currentUser.role === 'ADMIN' && tournament.format !== 'AMERICANO' && registrations.length >= 2) { %>
  <%
    const manualDoubles = tournament.playType === 'DOUBLES';
    const manualSlotCount = manualDoubles ? Math.floor(registrations.length / 2) : registrations.length;
    const manualGroups = typeof manualGroupCount !== 'undefined' ? Number(manualGroupCount) || 1 : 1;
    const manualGroupLetters = Array.from({ length: manualGroups }, (_, index) => String.fromCharCode(65 + index));
    const manualNames = registrations.map((r) => (r.player ? r.player.displayName : r.externalName));
  %>
  <details class="manual-pair-box mb">
    <summary><%- include('../../../partials/icon', { name: 'users' }) %> <%= manualDoubles ? 'Ghép đội thủ công' : 'Chọn đội thủ công' %></summary>
    <form method="post" action="/tournaments/<%= tournament.id %>/manual-schedule" data-confirm="Chọn đội thủ công sẽ xóa các trận và tỷ số hiện tại. Tiếp tục?">
      <input type="hidden" name="pairCount" value="<%= manualSlotCount %>">
      <div class="grid manual-pair-grid">
        <% for (let i = 1; i <= manualSlotCount; i++) { %>
          <div class="manual-pair-card">
            <div class="manual-pair-head">
              <strong>Đội <%= i %></strong>
              <% if (manualGroups > 1) { %>
                <label class="manual-pair-group">Bảng
                  <select name="group_<%= i %>" data-manual-group-select>
                    <option value="">Tự xếp</option>
                    <% manualGroupLetters.forEach((letter) => { %><option value="<%= letter %>"><%= letter %></option><% }) %>
                  </select>
                </label>
              <% } %>
            </div>
            <div class="row <%= manualDoubles ? '' : 'manual-pair-single' %>">
              <div class="col-6"><select class="manual-pair-select" name="teamA_<%= i %>" data-manual-pair-select><option value=""><%= manualDoubles ? 'Thành viên 1' : 'Vận động viên' %></option><% manualNames.forEach((name) => { %><option value="<%= name %>"><%= name %></option><% }) %></select></div>
              <% if (manualDoubles) { %>
                <div class="col-6"><select class="manual-pair-select" name="teamB_<%= i %>" data-manual-pair-select><option value="">Thành viên 2</option><% manualNames.forEach((name) => { %><option value="<%= name %>"><%= name %></option><% }) %></select></div>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
      <div class="mt">
        <button class="btn btn-primary" data-loading-text="Đang tạo..."><%- include('../../../partials/icon', { name: 'check' }) %> Tạo trận từ đội đã chọn</button>
        <% if (manualDoubles) { %>
          <p class="muted mt">Chỉ cần chốt những đội muốn cố định — ai chưa được xếp sẽ được ghép nốt theo quy tắc của giải
            (<strong><%= tournament.pairingRule === 'RANDOM' ? 'không phân trình' : 'phân trình' %></strong>).
            Đội mới chọn một người coi như chưa ghép, người đó vào chung rổ ghép tự động.</p>
        <% } else { %>
          <p class="muted mt">Thi đơn: mỗi đội là một người. Chỉ cần chọn những ai muốn cố định<%= manualGroups > 1 ? ' vào bảng' : '' %> — ai chưa được chọn sẽ được xếp nốt.</p>
        <% } %>
        <% if (manualGroups > 1) { %>
          <p class="muted">Đánh bảng <%= manualGroups %> bảng (<%= manualGroupLetters.join(', ') %>): chọn <strong>Bảng</strong> để chốt đội vào bảng đó; để "Tự xếp" thì máy rải vào bảng đang ít đội nhất.</p>
        <% } %>
      </div>
    </form>
  </details>
<% } %>
