  <% const heroFormatLabel = tournament.format === 'GROUP_KNOCKOUT' ? 'Vòng bảng + loại trực tiếp' : tournament.format === 'AMERICANO' ? 'Đôi xoay vòng' : 'Vòng tròn'; %>
  <section class="feature-hero p mb">
    <div class="flex between center">
      <div>
        <div class="hero-eyebrow">Giải đấu</div>
        <h1><%= tournament.name %></h1>
        <div class="hero-meta">
          <span><%- include('../../partials/icon', { name: 'pin' }) %><%= tournament.venue || 'Chưa có địa điểm' %></span>
          <span><%- include('../../partials/icon', { name: 'coin' }) %>Lệ phí <%= formatMoney(minimumFee) %>đ/người</span>
          <span><%- include('../../partials/icon', { name: 'court' }) %><%= heroFormatLabel %></span>
        </div>
      </div>
      <div class="hero-actions">
        <% if (currentUser.role === 'ADMIN') { %>
          <div class="hero-action-buttons">
            <button class="btn btn-sm" type="button" data-open-modal="emailModal"><%- include('../../partials/icon', { name: 'mail' }) %> Get Email</button>
            <button class="btn btn-sm btn-success" type="button" data-open-modal="contentModal"><%- include('../../partials/icon', { name: 'copy' }) %> Content mẫu</button>
          </div>
        <% } %>
        <div class="feature-hero-art"><div class="ball3d" aria-hidden="true"></div></div>
      </div>
    </div>
    <% if (currentUser.role === 'ADMIN') { %>
      <textarea id="emailListText" class="hidden"><%= [...registrations, ...(reserveRegistrations || [])].map((r) => r.player ? r.player.email : r.externalEmail).filter(Boolean).join('; ') %></textarea>
    <% } %>
  </section>
  <% if (currentUser.role === 'ADMIN') { %>
    <div id="emailModal" class="score-modal hidden" aria-hidden="true">
      <div class="score-modal-backdrop" data-close-modal="emailModal"></div>
      <div class="score-modal-panel" role="dialog" aria-modal="true">
        <div class="score-modal-head"><div><h3><%- include('../../partials/icon', { name: 'mail' }) %> Danh sách email</h3><small>Copy email thành viên trong giải</small></div><button class="btn btn-sm" type="button" data-close-modal="emailModal">Đóng</button></div>
        <div class="score-modal-body">
          <textarea id="emailModalText" rows="8"><%= [...registrations, ...(reserveRegistrations || [])].map((r) => r.player ? r.player.email : r.externalEmail).filter(Boolean).join('; ') %></textarea>
          <div class="mt text-right"><button class="btn btn-primary" type="button" data-copy-target="emailModalText"><%- include('../../partials/icon', { name: 'copy' }) %> Copy email</button></div>
        </div>
      </div>
    </div>
    <div id="contentModal" class="score-modal hidden" aria-hidden="true">
      <div class="score-modal-backdrop" data-close-modal="contentModal"></div>
      <div class="score-modal-panel" role="dialog" aria-modal="true">
        <div class="score-modal-head"><div><h3><%- include('../../partials/icon', { name: 'note' }) %> Content mẫu</h3><small>Copy gửi cho thành viên</small></div><button class="btn btn-sm" type="button" data-close-modal="contentModal">Đóng</button></div>
        <div class="score-modal-body">
          <textarea id="contentSampleText" rows="10">Xin chào Anh/Chị,

Chào mừng Anh/Chị đến với giải đấu "<%= tournament.name %>" tại <%= tournament.venue || 'địa điểm sẽ được cập nhật' %>.

Link xem thông tin giải:
<%= tournamentLink %>
<% if (tournament.externalRegistrationEnabled) { %>

Các vận động viên tham gia giải đăng ký tại link <%= externalLink %>
<% } %>

BTC rất mong Anh/Chị có mặt đúng giờ để giải đấu diễn ra thuận lợi.</textarea>
          <div class="mt text-right"><button class="btn btn-primary" type="button" data-copy-target="contentSampleText"><%- include('../../partials/icon', { name: 'copy' }) %> Copy nội dung</button></div>
        </div>
      </div>
    </div>
  <% } %>
