  <% if (section === 'settings') { %>
    <% const settingsFormatLabel = tournament.format === 'GROUP_KNOCKOUT' ? 'Vòng bảng + loại trực tiếp' : tournament.format === 'AMERICANO' ? 'Đôi xoay vòng' : 'Vòng tròn'; %>
    <section class="card-lite p">
      <div class="section-heading mb"><div><span class="feature-icon"><%- include('../../partials/icon', { name: 'settings' }) %></span><h2 class="section-title">Cài đặt giải đấu</h2><p class="muted">Thông tin cấu hình, thao tác sửa và xóa giải.</p></div></div>
      <div class="grid kv-grid">
        <div class="kv"><span>Tên giải</span><strong><%= tournament.name %></strong></div>
        <div class="kv"><span>Địa điểm</span><strong><%= tournament.venue || 'Chưa có' %></strong></div>
        <div class="kv"><span>Bắt đầu</span><strong><%= tournament.startTime ? new Date(tournament.startTime).toLocaleString('vi-VN') : 'Chưa có' %></strong></div>
        <div class="kv"><span>Kết thúc</span><strong><%= tournament.endTime ? new Date(tournament.endTime).toLocaleString('vi-VN') : 'Chưa có' %></strong></div>
        <div class="kv"><span>Số sân</span><strong><%= tournament.courtCount %></strong></div>
        <div class="kv"><span>Số thành viên dự kiến</span><strong><%= tournament.expectedPlayers %></strong></div>
        <div class="kv"><span>Loại đấu</span><strong><%= tournament.playType === 'DOUBLES' ? 'Thi đôi' : 'Thi đơn' %></strong></div>
        <div class="kv"><span>Thể thức</span><strong><%= settingsFormatLabel %></strong></div>
        <div class="kv"><span>Điểm</span><strong>Vòng bảng: chạm <%= tournament.touchScore %>, max <%= tournament.maxScore %><% if (tournament.format === 'GROUP_KNOCKOUT') { %><br>Vòng trong: chạm <%= tournament.knockoutTouchScore || 15 %>, max <%= tournament.knockoutMaxScore || 19 %><% } %></strong></div>
        <div class="kv"><span>Đăng ký ngoài</span><strong><%= tournament.externalRegistrationEnabled ? 'Đang mở' : 'Đang tắt' %></strong></div>
      </div>
      <% if (currentUser.role === 'ADMIN') { %>
        <section class="form-section mt settings-permission-section">
          <div class="section-heading mb"><div><span class="feature-icon"><%- include('../../partials/icon', { name: 'lock' }) %></span><h2 class="section-title">Phân quyền admin</h2><p class="muted">Admin được cấp quyền sẽ xem và quản lý giải này.</p></div></div>
          <div class="grid kv-grid mb">
            <div class="kv"><span>Người tạo</span><strong><%= tournament.ownerAdmin?.displayName || tournament.ownerAdmin?.username || 'Admin gốc / dữ liệu cũ' %></strong></div>
            <div class="kv"><span>Đang được phân quyền</span><strong><%= tournament.permissions?.length || 0 %> admin</strong></div>
          </div>
          <% if (admins && admins.length) { %>
            <form class="permission-create-form mb" method="post" action="/tournaments/<%= tournament.id %>/permissions">
              <div><label>Thêm admin</label><select name="adminId" required><% admins.forEach((admin) => { %><option value="<%= admin.id %>"><%= admin.displayName %> (<%= admin.username %>)</option><% }) %></select></div>
              <div class="permission-create-action"><button class="btn btn-success" data-loading-text="Đang thêm..."><%- include('../../partials/icon', { name: 'plus' }) %> Thêm quyền</button></div>
            </form>
          <% } %>
          <div class="permission-admin-list">
            <% (tournament.permissions || []).forEach((permission) => { %>
              <div class="permission-admin-card">
                <div class="flex between center gap">
                  <div><strong><%= permission.admin.displayName %></strong><br><span class="muted"><%= permission.admin.username %></span></div>
                  <form method="post" action="/tournaments/<%= tournament.id %>/permissions/<%= permission.id %>/delete" data-confirm="Gỡ quyền admin này?"><button class="btn btn-sm btn-danger" data-loading-text="Đang gỡ...">Gỡ quyền</button></form>
                </div>
              </div>
            <% }) %>
            <% if (!(tournament.permissions || []).length) { %><div class="alert-lite info">Chưa cấp quyền cho admin nào.</div><% } %>
          </div>
        </section>
      <% } %>
      <div class="mt flex gap settings-action-row">
        <a class="btn btn-primary" href="/tournaments/<%= tournament.id %>/edit?returnSection=<%= section %>"><%- include('../../partials/icon', { name: 'edit' }) %> Sửa cấu hình giải</a>
        <% if (currentUser.role === 'ADMIN') { %><form method="post" action="/tournaments/<%= tournament.id %>/delete" data-confirm="Xóa giải này và toàn bộ dữ liệu liên quan?"><button class="btn btn-danger" data-loading-text="Đang xóa..."><%- include('../../partials/icon', { name: 'trash' }) %> Xóa giải</button></form><% } %>
      </div>
    </section>
  <% } %>
