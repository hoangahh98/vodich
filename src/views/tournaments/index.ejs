<%- include('../partials/head', { title: 'Giải đấu' }) %>
<%- include('../partials/topbar') %>
<% const formatLabel = (format) => format === 'GROUP_KNOCKOUT' ? 'Vòng bảng + loại trực tiếp' : format === 'AMERICANO' ? 'Đôi xoay vòng' : 'Vòng tròn'; %>
<main class="app-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <div class="hero-eyebrow">Giải đấu</div>
        <h1>Quản lý giải đấu</h1>
        <div class="muted strong-muted"><%= tournaments.length %> giải đang có. Bấm vào giải để xem thành viên, lịch thi đấu và bảng xếp hạng.</div>
      </div>
      <div class="hero-actions">
        <% if (currentUser.role === 'ADMIN') { %><div class="hero-action-buttons"><a class="btn btn-sm btn-success" href="/tournaments/new"><%- include('../partials/icon', { name: 'plus' }) %> Thêm giải</a></div><% } %>
        <div class="feature-hero-art"><div class="ball3d" aria-hidden="true"></div></div>
      </div>
    </div>
  </section>
  <% if (!tournaments.length) { %>
    <section class="card-lite empty-state"><%- include('../partials/icon', { name: 'trophy' }) %><p>Chưa có giải nào.<% if (currentUser.role === 'ADMIN') { %> Bấm "Thêm giải" để tạo giải đầu tiên.<% } %></p></section>
  <% } %>
  <div class="grid module-grid">
    <% tournaments.forEach((item) => { %>
      <a class="card-lite module-card tournament-card" href="/tournaments/<%= item.tournament.id %>/players">
        <div class="module-icon"><%- include('../partials/icon', { name: 'trophy' }) %></div>
        <h3><%= item.tournament.name %></h3>
        <div class="card-meta">
          <span><%- include('../partials/icon', { name: 'users' }) %> Thành viên <strong><%= item.activeCount %>/<%= item.tournament.expectedPlayers %></strong></span>
          <span><%- include('../partials/icon', { name: 'coin' }) %> Lệ phí <strong><%= formatMoney(item.minimumFee) %>đ</strong></span>
        </div>
        <span class="badge tournament-format-badge"><%= formatLabel(item.tournament.format) %></span>
        <span class="card-arrow"><%- include('../partials/icon', { name: 'arrow' }) %></span>
      </a>
    <% }) %>
  </div>
</main>
<%- include('../partials/bottom-menu') %>
