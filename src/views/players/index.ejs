<%- include('../partials/head', { title: 'Thành viên' }) %>
<%- include('../partials/topbar') %>
<main class="app-shell players-shell">
  <section class="feature-hero p mb">
    <div class="flex between center gap">
      <div>
        <div class="hero-eyebrow">Thành viên</div>
        <h1>Quản lý thành viên</h1>
        <div class="muted strong-muted">Danh sách dùng chung cho mọi giải và đội bóng. Gom người vào <a href="/groups">nhóm</a> để đưa cả nhóm vào đội hay giải một lần.</div>
      </div>
      <div class="feature-hero-art"><div class="ball3d" aria-hidden="true"></div></div>
    </div>
  </section>

  <section class="card-lite p mb">
    <div class="section-heading mb">
      <div><span class="feature-icon"><%- include('../partials/icon', { name: 'plus' }) %></span><h2 class="section-title">Thêm thành viên</h2></div>
    </div>
    <form class="player-create-form" method="post" action="/players">
      <div><label>Họ tên</label><input name="displayName" placeholder="Nguyễn Văn A" required></div>
      <div><label>Email</label><input name="email" type="email" placeholder="email@example.com" required></div>
      <div><label>Trình</label><select name="skillLevel"><option value="">Chưa chọn trình</option><option>A</option><option>B</option><option>C</option><option>D</option></select></div>
      <div class="player-create-action"><button class="btn btn-success" data-loading-text="Đang thêm...">Thêm</button></div>
    </form>
  </section>

  <form class="card-lite" method="post" action="/players/bulk">
    <div class="card-hdr green"><span><%- include('../partials/icon', { name: 'users' }) %> Danh sách thành viên</span><span class="badge badge-dark"><%= players.length %> người</span></div>
    <%# Ô tìm nhanh lọc theo tên/email (không dấu), người đang sửa dở vẫn gửi lên vì chỉ ẩn dòng chứ không bỏ input. %>
    <% if (players.length > 8) { %><div class="p pb0"><div class="check-filter"><%- include('../partials/icon', { name: 'search' }) %><input type="search" data-check-filter="playerRows" placeholder="Gõ tên hoặc email để tìm…" autocomplete="off" aria-label="Tìm thành viên"><span class="badge" data-check-filter-count><%= players.length %></span></div></div><% } %>
    <div class="table-wrap member-table"><table class="member-list player-list"><thead><tr><th>Họ tên / Email</th><th class="text-right">Trình</th><th></th></tr></thead><tbody id="playerRows">
      <% players.forEach((p) => { %>
        <tr>
          <td><label class="player-name-cell"><input name="displayName_<%= p.id %>" value="<%= p.displayName %>" placeholder="Họ tên" required><input name="email_<%= p.id %>" type="email" value="<%= p.email %>" placeholder="Email" required></label></td>
          <td class="text-right"><select name="skillLevel_<%= p.id %>" aria-label="Trình của <%= p.displayName %>"><option value="" <%= !p.skillLevel ? 'selected' : '' %>>Chưa chọn</option><% ['A','B','C','D'].forEach((level) => { %><option value="<%= level %>" <%= p.skillLevel === level ? 'selected' : '' %>><%= level %></option><% }) %></select></td>
          <td class="text-right row-action"><button class="btn btn-sm btn-danger btn-icon" type="submit" form="deletePlayer_<%= p.id %>" aria-label="Xoá <%= p.displayName %>" title="Xoá thành viên" data-loading-text="…"><%- include('../partials/icon', { name: 'trash' }) %></button></td>
        </tr>
      <% }) %>
      <% if (!players.length) { %><tr><td colspan="3" class="muted text-center">Chưa có thành viên nào.</td></tr><% } %>
      <div class="muted p" data-check-filter-empty hidden>Không có ai khớp.</div>
    </tbody></table></div>
    <% if (players.length) { %><div class="card-foot"><button class="btn btn-primary" data-loading-text="Đang lưu..."><%- include('../partials/icon', { name: 'save' }) %> Lưu thay đổi</button></div><% } %>
  </form>
  <%# Form xoá đứng ngoài form sửa (không lồng form được); nút trong bảng trỏ tới bằng thuộc tính form="". %>
  <% players.forEach((p) => { %><form id="deletePlayer_<%= p.id %>" method="post" action="/players/<%= p.id %>/delete" data-confirm="Xoá <%= p.displayName %> khỏi danh sách? Người này sẽ bị gỡ khỏi mọi nhóm, đội (kể cả lịch sử phí) và giải đang tham gia."></form><% }) %>
</main>
<%- include('../partials/bottom-menu') %>
