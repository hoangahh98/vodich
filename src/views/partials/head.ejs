<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <title><%= title || 'Vô địch' %></title>
  <meta name="theme-color" content="#14161c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <!-- Font tự host (public/fonts): CSP font-src 'self', và app mở từ màn hình chính iPhone lúc mạng chập vẫn phải có chữ đẹp. -->
  <link rel="preload" href="/fonts/bevietnampro-500-vietnamese.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/oswald-vietnamese.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/games.css">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <!-- Ở head (không phải bottom-menu) để cả trang login cũng đăng ký được service worker. -->
  <script src="/js/sw-register.js" defer></script>
  <!-- Cũng ở head: iOS BỎ QUA user-scalable/maximum-scale ở thẻ viewport trên, phải chặn
       cử chỉ chụm ngón bằng JS thì mới thật sự khoá được zoom. Xem public/js/no-zoom.js. -->
  <script src="/js/no-zoom.js" defer></script>
</head>
